---@module Utility.Signal
local Signal = __DARKLUA_BUNDLE_MODULES.m()

---@module Utility.Maid
local Maid = __DARKLUA_BUNDLE_MODULES.n()

---@module Utility.Logger
local Logger = __DARKLUA_BUNDLE_MODULES.g()

-- Services.
local players = game:GetService("Players")
local runService = game:GetService("RunService")
local userInputService = game:GetService("UserInputService")

-- Maids.
local movementMaid = Maid.new()
local characterMaid = Maid.new()

-- Original stores. These outlive the maid so a re-init still restores cleanly.
local collisionMap = OriginalStoreManager.new()
local walkSpeedStore = OriginalStore.new()
local jumpPowerStore = OriginalStore.new()

-- Constants.
local FLY_VELOCITY_NAME = "NiphFlyVelocity"
local FLY_GYRO_NAME = "NiphFlyGyro"
local SPIN_STEP = math.rad(1)

-- Fall tracking. Peak downward speed is sampled per frame so we can cancel the
-- landing impulse before the game's landing logic ever sees it.
local lastFallSpeed = 0
local spinAngle = 0

-- Cached character parts so noclip never walks the descendant tree per frame.
local characterParts = {}

---Resolve the local character parts we need for every update.
---@return Model?, BasePart?, Humanoid?
local function getLocalRig()
	local localPlayer = players.LocalPlayer
	local character = localPlayer and localPlayer.Character
	if not character then
		return nil
	end

	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end

	return character, rootPart, humanoid
end

---Remove the fly movers from a root part.
---@param rootPart BasePart
local function clearFlyMovers(rootPart)
	movementMaid["flyVelocity"] = nil
	movementMaid["flyGyro"] = nil

	if not rootPart then
		return
	end

	local velocity = rootPart:FindFirstChild(FLY_VELOCITY_NAME)
	if velocity then
		velocity:Destroy()
	end

	local gyro = rootPart:FindFirstChild(FLY_GYRO_NAME)
	if gyro then
		gyro:Destroy()
	end
end

---Get (or build) the body mover that holds us in the air.
---@param rootPart BasePart
---@return BodyVelocity
local function getFlyVelocity(rootPart)
	local existing = movementMaid["flyVelocity"]
	if existing and existing.Parent == rootPart then
		return existing
	end

	local velocity = Instance.new("BodyVelocity")
	velocity.Name = FLY_VELOCITY_NAME
	velocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
	velocity.P = 12000
	velocity.Velocity = Vector3.zero
	velocity.Parent = rootPart

	movementMaid["flyVelocity"] = velocity

	return velocity
end

---Get (or build) the gyro that keeps us upright while flying.
---@param rootPart BasePart
---@return BodyGyro
local function getFlyGyro(rootPart)
	local existing = movementMaid["flyGyro"]
	if existing and existing.Parent == rootPart then
		return existing
	end

	local gyro = Instance.new("BodyGyro")
	gyro.Name = FLY_GYRO_NAME
	gyro.MaxTorque = Vector3.new(4e5, 4e5, 4e5)
	gyro.P = 12000
	gyro.Parent = rootPart

	movementMaid["flyGyro"] = gyro

	return gyro
end

---Camera relative WASD direction.
---@param cameraCFrame CFrame
---@return Vector3
local function getInputDirection(cameraCFrame)
	local direction = Vector3.zero

	if userInputService:IsKeyDown(Enum.KeyCode.W) then
		direction = direction + cameraCFrame.LookVector
	end

	if userInputService:IsKeyDown(Enum.KeyCode.S) then
		direction = direction - cameraCFrame.LookVector
	end

	if userInputService:IsKeyDown(Enum.KeyCode.A) then
		direction = direction - cameraCFrame.RightVector
	end

	if userInputService:IsKeyDown(Enum.KeyCode.D) then
		direction = direction + cameraCFrame.RightVector
	end

	return direction
end

---Update fly.
---@param rootPart BasePart
---@param humanoid Humanoid
local function updateFly(rootPart, humanoid)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	humanoid.PlatformStand = true
	humanoid.AutoRotate = false

	local speed = Configuration.expectOptionValue("FlySpeed") or 60
	local cameraCFrame = camera.CFrame
	local direction = getInputDirection(cameraCFrame)
	local horizontal = Vector3.new(direction.X, 0, direction.Z)

	if not Configuration.expectToggleValue("FlyHorizontalOnly") then
		horizontal = direction
	end

	local velocity = horizontal.Magnitude > 0.05 and horizontal.Unit * speed or Vector3.zero
	local vertical = 0

	if userInputService:IsKeyDown(Enum.KeyCode.Space) then
		vertical = vertical + 1
	end

	if userInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
		vertical = vertical - 1
	end

	velocity = velocity + Vector3.new(0, vertical * speed * 0.6, 0)

	getFlyVelocity(rootPart).Velocity = velocity

	if not Configuration.expectToggleValue("SpinBot") then
		local look = Vector3.new(cameraCFrame.LookVector.X, 0, cameraCFrame.LookVector.Z)
		if look.Magnitude > 0.05 then
			getFlyGyro(rootPart).CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + look.Unit)
