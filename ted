---@param instance Instance
local function trackCharacterPart(instance)
	if not instance:IsA("BasePart") then
		return
	end

	characterParts[#characterParts + 1] = instance
end

---Update noclip against the cached part list.
local function updateNoClip()
	for index = #characterParts, 1, -1 do
		local part = characterParts[index]

		if not part.Parent then
			collisionMap:forget(part)
			table.remove(characterParts, index)
			continue
		end

		if not part.CanCollide then
			continue
		end

		collisionMap:add(part, "CanCollide", false)
	end
end

---Update walk speed override.
---@param humanoid Humanoid
local function updateWalkSpeed(humanoid)
	if not Configuration.expectToggleValue("WalkSpeedEnabled") then
		return walkSpeedStore:restore()
	end

	walkSpeedStore:set(humanoid, "WalkSpeed", Configuration.expectOptionValue("WalkSpeedValue") or 16)
end

---Update jump power override.
---@param humanoid Humanoid
local function updateJumpPower(humanoid)
	if not Configuration.expectToggleValue("JumpPowerEnabled") then
		return jumpPowerStore:restore()
	end

	if humanoid.UseJumpPower then
		jumpPowerStore:set(humanoid, "JumpPower", Configuration.expectOptionValue("JumpPowerValue") or 50)
	else
		jumpPowerStore:set(humanoid, "JumpHeight", (Configuration.expectOptionValue("JumpPowerValue") or 50) / 10)
	end
end

---Update infinite jump.
---@param rootPart BasePart
local function updateInfiniteJump(rootPart)
	if not userInputService:IsKeyDown(Enum.KeyCode.Space) then
		return
	end

	local boost = Configuration.expectOptionValue("InfiniteJumpBoost") or 50
	local velocity = rootPart.AssemblyLinearVelocity

	rootPart.AssemblyLinearVelocity = Vector3.new(velocity.X, boost, velocity.Z)
end

---Update fall protection.
---Terminal velocity is clamped every frame so the game never observes an impact
---speed high enough to roll fall damage. No remote or metamethod filtering.
---@param rootPart BasePart
---@param humanoid Humanoid
local function updateNoFall(rootPart, humanoid)
	local clamp = Configuration.expectOptionValue("NoFallMaxSpeed") or 60
	local velocity = rootPart.AssemblyLinearVelocity

	if velocity.Y < -clamp then
		rootPart.AssemblyLinearVelocity = Vector3.new(velocity.X, -clamp, velocity.Z)
	end

	local state = humanoid:GetState()
	if state ~= Enum.HumanoidStateType.Freefall and state ~= Enum.HumanoidStateType.FallingDown then
		lastFallSpeed = 0
		return
	end

	lastFallSpeed = math.max(lastFallSpeed, -velocity.Y)
end

---Cancel the landing impulse the moment we touch down.
---@param state Enum.HumanoidStateType
local function onHumanoidStateChanged(_, state)
	if not Configuration.expectToggleValue("NoFallDamage") then
		return
	end

	if state ~= Enum.HumanoidStateType.Landed and state ~= Enum.HumanoidStateType.Running then
		return
	end

	local _, rootPart = getLocalRig()
	if not rootPart then
		return
	end

	if lastFallSpeed <= 0 then
		return
	end

	local velocity = rootPart.AssemblyLinearVelocity
	rootPart.AssemblyLinearVelocity = Vector3.new(velocity.X, 0, velocity.Z)
	lastFallSpeed = 0
end

---Update spinbot. Purely visual desync of the root part's yaw.
---@param rootPart BasePart
---@param deltaTime number
local function updateSpinBot(rootPart, deltaTime)
	spinAngle = spinAngle + SPIN_STEP * (Configuration.expectOptionValue("SpinBotSpeed") or 30) * deltaTime * 60

	if spinAngle > math.pi * 2 then
		spinAngle = spinAngle - math.pi * 2
	end

	local position = rootPart.CFrame.Position
	rootPart.CFrame = CFrame.new(position) * CFrame.Angles(0, spinAngle, 0)
end

---Update movement.
---@param deltaTime number
local function updateMovement(deltaTime)
	local character, rootPart, humanoid = getLocalRig()
	if not character then
		return
	end

	if Configuration.expectToggleValue("NoClip") then
		updateNoClip()
	else
		collisionMap:restore()
	end

	updateWalkSpeed(humanoid)
	updateJumpPower(humanoid)

	if Configuration.expectToggleValue("Fly") then
		updateFly(rootPart, humanoid)
	else
		restoreFly(rootPart, humanoid)
	end

	if Configuration.expectToggleValue("InfiniteJump") and not Configuration.expectToggleValue("Fly") then
		updateInfiniteJump(rootPart)
	end

	if Configuration.expectToggleValue("NoFallDamage") then
		updateNoFall(rootPart, humanoid)
	end

	if Configuration.expectToggleValue("SpinBot") then
		updateSpinBot(rootPart, deltaTime)
	end
end

---Rebind per-character state when we respawn.
---@param character Model
local function onCharacterAdded(character)
	characterMaid:clean()

	collisionMap:detach()
	walkSpeedStore:detach()
	jumpPowerStore:detach()

	lastFallSpeed = 0

	table.clear(characterParts)

	for _, descendant in next, character:GetDescendants() do
		trackCharacterPart(descendant)
	end

	local descendantAdded = Signal.new(character.DescendantAdded)
	characterMaid:add(descendantAdded:connect("Movement_CharacterDescendantAdded", trackCharacterPart))

	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end

	local stateChanged = Signal.new(humanoid.StateChanged)
	characterMaid:add(stateChanged:connect("Movement_HumanoidStateChanged", onHumanoidStateChanged))
end

---Initialize movement.
function Movement.init()
	local localPlayer = players.LocalPlayer

	local preSimulation = Signal.new(runService.PreSimulation)
	movementMaid:add(preSimulation:connect("Movement_PreSimulation", updateMovement))

	local characterAdded = Signal.new(localPlayer.CharacterAdded)
	movementMaid:add(characterAdded:connect("Movement_CharacterAdded", onCharacterAdded))

	if localPlayer.Character then
		onCharacterAdded(localPlayer.Character)
	end

	Logger.warn("Movement initialized.")
end

---Detach movement.
function Movement.detach()
	local _, rootPart, humanoid = getLocalRig()

	if rootPart and humanoid then
		restoreFly(rootPart, humanoid)
	end

	characterMaid:clean()
	movementMaid:clean()

	collisionMap:detach()
	walkSpeedStore:detach()
	jumpPowerStore:detach()

	table.clear(characterParts)

	Logger.warn("Movement detached.")
end

-- Return Movement module.
return Movement
