	if flag("VvvApShowHb", false) then
		for _, info in next, activeAnimations do
			spawnHitboxPart(info)
		end

		startHitboxRender()

		return
	end

	stopHitboxRender()

	for trackId in next, hitboxParts do
		killHitboxPart(trackId)
	end

	if partFolder then
		for _, child in ipairs(partFolder:GetChildren()) do
			pcall(function()
				child:Destroy()
			end)
		end
	end
end

-- m1 sink -----------------------------------------------------------
-- The action stays bound for as long as the AP is on, so our handler always
-- sits ahead of the click in the input chain rather than racing to bind the
-- instant a parry fires — which let an already-held click slip through. It only
-- sinks while some swing is actually in its block window.

---@param _name string
---@param state EnumItem
---@return EnumItem
local function onM1(_name, state)
	if state == Enum.UserInputState.Begin then
		m1Held = true
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		m1Held = false
	end

	if m1Sinking and flag("VvvApBlockInput", true) then
		return Enum.ContextActionResult.Sink
	end

	return Enum.ContextActionResult.Pass
end

local function bindM1()
	if m1Bound then
		return
	end

	m1Bound = true

	pcall(function()
		contextActionService:BindActionAtPriority(M1_ACTION_NAME, onM1, false, 3000, Enum.UserInputType.MouseButton1)
	end)
end

local function unbindM1()
	m1Held = false
	m1Sinking = false

	if not m1Bound then
		return
	end

	m1Bound = false

	pcall(function()
		contextActionService:UnbindAction(M1_ACTION_NAME)
	end)
end

---Recompute the sink flag from whatever swings currently want the hold.
---@note `WantBlock` is sticky per swing so a held click stays suppressed for the
--- whole window instead of flickering open between frames.
local refreshM1Sink = LPH_NO_VIRTUALIZE(function()
	if not flag("VvvApBlockInput", true) then
		m1Sinking = false
		return
	end

	for _, info in next, activeAnimations do
		if info.WantBlock then
			m1Sinking = true
			return
		end
	end

	m1Sinking = false
end)

-- timing math -------------------------------------------------------

---When to send Block so the hit lands inside the parry window.
---@note The open delay was measured at `REFERENCE_RTT`, so only the deviation
--- from that ping is compensated. Aiming for the middle of the 293ms window
--- leaves ~150ms of slack on either side of a mistimed `when`.
---@param whenMs number
---@return number seconds
local fireOffset = LPH_NO_VIRTUALIZE(function(whenMs)
	return whenMs / 1000 - (Latency.smooth() - REFERENCE_RTT) - PARRY_OPEN_DELAY - PARRY_WINDOW * 0.5
end)

-- track bookkeeping -------------------------------------------------

---@param connection RBXScriptConnection?
local function disconnect(connection)
	if connection then
		pcall(function()
			connection:Disconnect()
		end)
	end
end

---Cancel everything still outstanding on one attack and forget it.
---@param trackId string
local dropTrack = LPH_NO_VIRTUALIZE(function(trackId)
	local info = activeAnimations[trackId]
	if not info then
		return
	end

	activeAnimations[trackId] = nil

	for _, connection in ipairs(info.Conns) do
		disconnect(connection)
	end

	for _, thread in ipairs(info.Threads) do
		pcall(task.cancel, thread)
	end

	table.clear(info.Pending)
	killHitboxPart(trackId)
	refreshM1Sink()

	if StateListener.trackingName == info.AnimData.Name then
		StateListener.trackingName = nil
	end
end)

---Did this track stop before it finished playing?
---@param track AnimationTrack?
---@param timing table?
---@return boolean
local isEarlyCut = LPH_NO_VIRTUALIZE(function(track, timing)
	if not track or track.IsPlaying then
		return false
	end

	if timing and (timing.ieae == true or timing.IgnoreEarlyEnd == true) then
		return false
	end

	local length = track.Length
	if not length or length <= 0 then
		return true
	end

	return track.TimePosition < length - 0.01
end)

---@param trackId string
local function onFeint(trackId)
	local info = activeAnimations[trackId]
	if not info then
		return
	end

	notify("Feint: %s | %s", info.AnimData.Name or "?", displayName(info.Model))

	if option("VvvApFeintReact", "Nothing") == "Roll" then
		InputClient.dodge()
	end

	dropTrack(trackId)
end

---@param trackId string
local handleTrackStop = LPH_NO_VIRTUALIZE(function(trackId)
	local info = activeAnimations[trackId]
	if not info then
		return
	end

	if isEarlyCut(info.Track, info.AnimData) then
		return onFeint(trackId)
	end

	dropTrack(trackId)
end)

-- firing ------------------------------------------------------------

---Tap Block.
---@note Nothing rate limits this. Every scheduled action that survives its own
--- checks sends the remote, however close together they land. There used to be a
--- local two second gate modelled on Hunter's `ParryCooldown`, and it was the
--- wrong place to enforce it: the server already refuses a parry it considers on
--- cooldown, whereas a client-side guess about that cooldown silently swallowed
--- sends that would have been fine.
---@param actionId string
---@return boolean fired
local fireParry = LPH_NO_VIRTUALIZE(function(actionId)
	if not InputClient.parry() then
		Logger.warn("AutoParry: '%s' could not send Block - no ControllerRemote on the character.", tostring(actionId))
		return false
	end

	if debugEnabled() then
		Logger.warn("AutoParry: sent Block for '%s'.", tostring(actionId))
	end

	return true
end)

---Send a dodge, optionally cancelling it with a queued block.
---@param actionId string
---@return boolean fired
local fireDodge = LPH_NO_VIRTUALIZE(function(actionId)
	if not StateListener.canDodge() then
		Logger.debug("AutoParry.fireDodge(...) - '%s' skipped, dodge unavailable.", actionId)
		return false
	end

	if not InputClient.dodge() then
		return false
	end

	if not flag("VvvApRollCancel", false) then
		return true
	end

	local cancelDelay = option("RollCancelDelay", 0.05)

	task.delay(cancelDelay, function()
		fireParry(actionId .. "|rc")
	end)

	return true
end)

---Run the repeat tail of an action, if it has one.
---@param info table
---@param action table
---@param actionId string
---@return number seconds The tail length, so the track knows when it is done.
local scheduleRepeats = LPH_NO_VIRTUALIZE(function(info, action, actionId)
	local timing = info.AnimData
	local times = action.repeatTimes or timing.RepeatParryAmount or 0

	if times <= 0 then
		return 0
	end

	local gap = (action.repeatDelay or timing.RepeatParryDelay or 100) / 1000

	for index = 1, times do
		info.Threads[#info.Threads + 1] = task.delay(gap * index, function()
			if not enabled or not StateListener.alive() then
				return
			end

			fireParry(string.format("%s|r%d", actionId, index))
		end)
	end

	return gap * times
end)

---Fire one action, if everything it depends on still holds.
---@note A failed check retires only this action. The others belong to hits that
--- have not happened yet, so they keep their own claims and their own chance.
---@param info table
---@param action table
---@param actionId string
local runAction = LPH_NO_VIRTUALIZE(function(info, action, actionId)
	info.Pending[actionId] = nil
	info.Remaining -= 1

	local trackId = info.TrackId
	local timing = info.AnimData
	local model = info.Model

	---Retire this action, and the whole attack once nothing is left outstanding.
	---@param tail number Seconds of repeat parries still to come.
	local function finish(tail)
		if info.Remaining > 0 then
			return
		end

		if tail > 0 then
			task.delay(tail + 0.05, function()
				dropTrack(trackId)
			end)

			return
		end

		dropTrack(trackId)
	end

	if not activeAnimations[trackId] then
		return
	end

	if not enabled or not StateListener.alive() then
		return dropTrack(trackId)
	end

	local alive = aliveFolder()

	if not model or not model.Parent or not alive or not model:IsDescendantOf(alive) then
		return dropTrack(trackId)
	end

	---@note The animation running to completion means the hit already happened
	--- or never will; an early stop is handled by the Stopped connection.
	if info.Track and not info.Track.IsPlaying and not isEarlyCut(info.Track, timing) then
		return dropTrack(trackId)
	end

	if flag("VvvApAvoidCounters", false) and not timing.IgnoreCounter and isCountering(model) then
		if debugEnabled() then
			Logger.warn("AutoParry: '%s' skipped, %s is holding parry frames.", actionId, displayName(model))
		end

		return finish(0)
	end

	if not action.ihbc and not flag("VvvApIgnoreHb", false) then
		local hitbox = TimingCodec.authoredHitbox(timing, action)
		local facing = facingMe(model)
		local covered = inHitbox(model, timing, hitbox)

		if not facing or not covered then
			if debugEnabled() then
				Logger.warn(
					"AutoParry: '%s' (%s) skipped - facing=%s inHitbox=%s. Widen the hitbox in the builder or tick IHB on the action.",
					actionId,
					timing.Name or "?",
					tostring(facing),
					tostring(covered)
				)
			end

			return finish(0)
		end
	end

	local wantsRoll = action.type ~= "Parry" or flag("VvvApRollAll", false)

	---@note Engaged even when the chance roll loses, so a click you are holding
	--- is sunk for the whole window rather than only on the frames we commit.
	if not wantsRoll and flag("VvvApBlockInput", true) then
		info.WantBlock = true
		refreshM1Sink()
	end

	if flag("VvvApAutoFace", true) then
		local localRoot = myRoot()
		local root = rootOf(model)

		if localRoot and root then
			pcall(function()
				local at = Vector3.new(root.Position.X, localRoot.Position.Y, root.Position.Z)
				localRoot.CFrame = CFrame.lookAt(localRoot.Position, at)
			end)
		end
	end

	if math.random(1, 100) > option("VvvApChance", 100) then
		return finish(0)
	end

	notify(
		"%s %s | %dms | ping %.0fms | %s",
		wantsRoll and "ROLL" or "PARRY",
		timing.Name or "?",
		action.when,
		Latency.smooth() * 1000,
		displayName(model)
	)

	if wantsRoll then
		if not fireDodge(actionId) and debugEnabled() then
			Logger.warn("AutoParry: '%s' wanted a roll but Hunter has no dodge action wired.", actionId)
		end

		return finish(0)
	end

	fireParry(actionId)

	return finish(scheduleRepeats(info, action, actionId))
end)

---Put one action of an attack on the clock.
---@param info table
---@param index number
---@param action table
local scheduleAction = LPH_NO_VIRTUALIZE(function(info, index, action)
	local timing = info.AnimData
	local delay = math.max(fireOffset(action.when) - info.StartOffset, 0)
	local actionId = string.format("%s#%d", info.TrackId, index)

	if debugEnabled() then
		Logger.warn(
			"AutoParry: scheduled '%s' action %d (%s @ %dms) to fire in %.0fms.",
			timing.Name or "?",
			index,
			action.type,
			action.when,
			delay * 1000
		)
	end

	info.Pending[actionId] = true

	info.Threads[#info.Threads + 1] = TaskSpawner.delay("AutoParry_Action", function()
		return delay
	end, runAction, info, action, actionId)
end)

-- animation handling ------------------------------------------------

---Reject tracks that cannot be an attack.
---@param track AnimationTrack
---@return boolean
---@note Only a stopped track is rejected. Priority and speed were filtered here
--- before and both threw away real attacks: Hunter plays several swings at Core
--- priority, and a combo finisher can run well above 1x speed.
local validTrack = LPH_NO_VIRTUALIZE(function(track)
	return track.Speed > 0
end)

---Are the global switches letting the AP act at all?
---@return boolean
local apActive = LPH_NO_VIRTUALIZE(function()
	if not enabled then
		return false
	end

	local filters = option("VvvApFilters", nil)

	if type(filters) == "table" then
		if filters["Disable When Textbox Focused"] and userInputService:GetFocusedTextBox() then
			return false
		end

		if filters["Disable When Window Not Active"] and not userInputService.WindowFocused then
			return false
		end
	end

	return true
end)

---@param timing table
---@return boolean
local tagFiltered = LPH_NO_VIRTUALIZE(function(timing)
	local filters = option("VvvApFilters", nil)
	if type(filters) ~= "table" then
		return false
	end

	local switch = TAG_FILTER[timing.Tag or "Undefined"]

	return switch ~= nil and filters[switch] == true
end)

---@param model Model
---@param track AnimationTrack
local onAnimationPlayed = LPH_NO_VIRTUALIZE(function(model, track)
	if not apActive() or not StateListener.alive() then
		return
	end

	local animation = track.Animation
	if not animation then
		return
	end

	local fullId = TimingCodec.fullIdOf(animation.AnimationId)
	if not fullId then
		return
	end

	if not validTrack(track) or not attackerAllowed(model) then
		if debugEnabled() then
			Logger.warn("AutoParry: ignored %s from %s.", fullId, displayName(model))
		end

		return
	end

	local timing = TimingBridge.ParryLibrary[fullId]

	---@note Once per animation id, not once per play. Idles and walk cycles come
	--- through here dozens of times a second, and unthrottled they buried the
	--- lines that actually explain a missed parry.
	if not timing then
		if debugEnabled() and not unknownAnims[fullId] then
			unknownAnims[fullId] = true

			Logger.warn("AutoParry: no timing saved for %s (first seen on %s).", fullId, displayName(model))
		end

		return
	end

	if tagFiltered(timing) then
		if debugEnabled() then
			Logger.warn("AutoParry: skipped %s from %s, its tag is filtered out.", timing.Name or fullId, displayName(model))
		end

		return
	end

	local close, distance, limit = nearby(model, timing, 25)

	if not close then
		if debugEnabled() then
			Logger.warn(
				"AutoParry: skipped %s from %s, %.0f studs away and the limit is %.0f. Raise Max range.",
				timing.Name or fullId,
				displayName(model),
				distance,
				limit
			)
		end

		return
	end

	for _, existing in next, activeAnimations do
		if existing.Track == track then
			return
		end
	end

	local actions = timing.Actions
	if type(actions) ~= "table" or #actions == 0 then
		return
	end

	local info = {
		TrackId = httpService:GenerateGUID(false),
		Model = model,
		Track = track,
		AnimData = timing,
		---@note Animations are occasionally reported a frame or two in, so every
		--- action is scheduled off the real start rather than off "now".
		StartOffset = track.TimePosition,
		Remaining = #actions,
		IsActive = true,
		WantBlock = false,
		Pending = {},
		Threads = {},
		Conns = {},
	}

	activeAnimations[info.TrackId] = info
	StateListener.trackingName = timing.Name

	local function onStop()
		handleTrackStop(info.TrackId)
	end

	info.Conns[#info.Conns + 1] = track.Stopped:Connect(onStop)
	info.Conns[#info.Conns + 1] = track.Ended:Connect(onStop)

	if flag("VvvApShowHb", false) then
		spawnHitboxPart(info)
		startHitboxRender()
	end

	for index, action in ipairs(actions) do
		scheduleAction(info, index, action)
	end

	if info.Remaining <= 0 then
		dropTrack(info.TrackId)
	end
end)

-- model hookup ------------------------------------------------------

---@param model Instance
local hookModel = LPH_NO_VIRTUALIZE(function(model)
	if not model:IsA("Model") or model == StateListener.character() then
		return
	end

	if trackedModels[model] then
		return
	end

	---@note Claimed before the first yield below. Several paths (initial scan,
	--- ChildAdded, respawn) can reach the same model in one frame, and without
	--- the placeholder each of them builds its own connection bucket.
	trackedModels[model] = true

	local humanoid = model:FindFirstChildOfClass("Humanoid") or model:WaitForChild("Humanoid", 5)
	if not humanoid then
		trackedModels[model] = nil
		return
	end

	local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 5)
	if not animator or not model:IsDescendantOf(workspace) then
		trackedModels[model] = nil
		return
	end

	if trackedModels[model] ~= true then
		return
	end

	local bucket = {}

	bucket[#bucket + 1] = animator.AnimationPlayed:Connect(function(track)
		onAnimationPlayed(model, track)
	end)

	bucket[#bucket + 1] = model.AncestryChanged:Connect(function(_, parent)
		if parent and parent:IsDescendantOf(workspace) then
			return
		end

		trackedModels[model] = nil

		for _, connection in ipairs(bucket) do
			disconnect(connection)
		end

		table.clear(bucket)
	end)

	trackedModels[model] = bucket
end)

local function scanAlive()
	local alive = aliveFolder()
	if not alive then
		return
	end

	for _, model in ipairs(alive:GetChildren()) do
		task.spawn(hookModel, model)
	end
end

---Per-frame housekeeping: drop attacks whose attacker is gone, notice feints
---the Stopped signal did not report, and keep the click sink honest.
local onHeartbeat = LPH_NO_VIRTUALIZE(function()
	local sinkWanted = flag("VvvApBlockInput", true)
		and not flag("VvvApRollAll", false)
	local drawing = flag("VvvApShowHb", false)

	for trackId, info in next, activeAnimations do
		if not info.Model or not info.Model.Parent then
			dropTrack(trackId)
			continue
		end

		if info.Track and not info.Track.IsPlaying then
			handleTrackStop(trackId)
			continue
		end

		---@note If a click is already down, engage the sink before the parry
		--- commits rather than on the frame it fires. Otherwise the press that
		--- was held through the wind-up reaches the game first.
		if sinkWanted and not info.WantBlock and m1Held then
			if facingMe(info.Model) and nearby(info.Model, info.AnimData, 10) then
				info.WantBlock = true
			end
		end

		if drawing and not hitboxParts[trackId] then
			spawnHitboxPart(info)
		end
	end

	refreshM1Sink()
end)

-- enable / disable --------------------------------------------------

local function teardown()
	unbindM1()
	stopHitboxRender()

	for trackId in next, activeAnimations do
		dropTrack(trackId)
	end

	table.clear(activeAnimations)

	for trackId in next, hitboxParts do
		killHitboxPart(trackId)
	end

	for _, bucket in next, trackedModels do
		if type(bucket) == "table" then
			for _, connection in ipairs(bucket) do
				disconnect(connection)
			end
		end
	end

	table.clear(trackedModels)

	runMaid:clean()
end

---Watch `workspace.Alive` for new attackers.
---@note Enabling before the folder streams in used to leave the AP running with
--- nothing hooked and no way to notice, so a missing folder installs a one-shot
--- watch on workspace instead of giving up.
local function watchAlive()
	local alive = aliveFolder()

	if not alive then
		local childAdded = Signal.new(workspace.ChildAdded)

		runMaid:add(childAdded:connect("AutoParry_WaitAlive", function(child)
			if child.Name == "Alive" and enabled then
				watchAlive()
			end
		end))

		Logger.warn("AutoParry: workspace.Alive is not there yet - waiting for it.")

		return
	end

	scanAlive()

	local childAdded = Signal.new(alive.ChildAdded)
	local childRemoved = Signal.new(alive.ChildRemoved)

	runMaid:add(childAdded:connect("AutoParry_AliveAdded", function(model)
		task.spawn(hookModel, model)
	end))

	runMaid:add(childRemoved:connect("AutoParry_AliveRemoved", function(model)
		trackedModels[model] = nil
	end))
end

---Turn the auto parry on or off.
---@param state boolean
function AutoParry.setEnabled(state)
	state = state == true

	if state == enabled then
		return
	end

	enabled = state

	if not enabled then
		teardown()

		Logger.warn("AutoParry disabled.")

		return
	end

	bindM1()
	watchAlive()

	local heartbeat = Signal.new(runService.Heartbeat)
	runMaid:add(heartbeat:connect("AutoParry_Heartbeat", onHeartbeat))

	if flag("VvvApShowHb", false) then
		startHitboxRender()
	end

	Logger.warn("AutoParry enabled with %i timing(s) loaded.", TimingBridge.count())
end

---Re-read every config from disk.
---@return number count
function AutoParry.reloadLibrary()
	local count = TimingBridge.ReloadLibrary()

	table.clear(unknownAnims)

	Logger.notify("Reloaded %i timing(s).", count)

	return count
end

