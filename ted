local APBreaker = {}

-- Services.
local players = game:GetService("Players")

local ANIMATION_IDS = {
	"rbxassetid://9149348937",
	"rbxassetid://10880473795",
	"rbxassetid://5778357994",
	"rbxassetid://16873988732",
	"rbxassetid://7620630583",
	"rbxassetid://8378263543",
}

local RATE = 999
local PLAY_SPEED = 50
local WEIGHT = 0.05
local FADE = 0
local PRIORITY = Enum.AnimationPriority.Idle

APBreaker.enabled = false
APBreaker.currentStop = nil
APBreaker.charConn = nil

---Create an animation instance.
---@param animationId string
---@return Animation
local function createAnimation(animationId)
	local animation = Instance.new("Animation")
	animation.AnimationId = animationId
	return animation
end

---Start animation playback on a character.
---@param character Model
---@return function stop
local function startPlayback(character)
	if not character then
		return function() end
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return function() end
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	local tracks = {}
	for _, animationId in ipairs(ANIMATION_IDS) do
		local track = animator:LoadAnimation(createAnimation(animationId))
		track.Priority = PRIORITY
		track:AdjustWeight(WEIGHT, 0.001)
		table.insert(tracks, track)
	end

	local running = true
	local interval = 1 / RATE

	task.spawn(function()
		local nextPlay = os.clock()

		while running do
			if not character.Parent then
				break
			end

			local now = os.clock()
			if now >= nextPlay then
				nextPlay = nextPlay + interval

				local track = tracks[math.random(#tracks)]
				pcall(function()
					track:Play(FADE, 1, PLAY_SPEED)
					track:AdjustWeight(WEIGHT, 0)
				end)
			else
				task.wait()
			end
		end
	end)

	return function()
		running = false
		for _, track in ipairs(tracks) do
			pcall(function()
				track:Stop(0)
				track:Destroy()
			end)
		end
	end
end

---Handle character changes.
---@param character Model
local function onCharacter(character)
	if APBreaker.currentStop then
		APBreaker.currentStop()
		APBreaker.currentStop = nil
	end

	if not APBreaker.enabled or not character then
		return
	end

	APBreaker.currentStop = startPlayback(character)
end

---Start AP breaker.
function APBreaker.start()
	if APBreaker.enabled then
		return
	end

	APBreaker.enabled = true

	if not APBreaker.charConn then
		APBreaker.charConn = players.LocalPlayer.CharacterAdded:Connect(onCharacter)
	end

	local character = players.LocalPlayer.Character
	if not character then
		character = players.LocalPlayer.CharacterAdded:Wait()
	end

	onCharacter(character)
end

---Stop AP breaker.
function APBreaker.stop()
	if not APBreaker.enabled then
		return
	end

	APBreaker.enabled = false

	if APBreaker.currentStop then
		APBreaker.currentStop()
		APBreaker.currentStop = nil
	end

	if APBreaker.charConn then
		APBreaker.charConn:Disconnect()
		APBreaker.charConn = nil
	end
end

return APBreaker
