	background.BackgroundColor3 = Color3.fromRGB(22, 26, 34)
	background.BackgroundTransparency = 0.05

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 2)
	corner.Parent = background

	if vertical then
		-- Negative Y scale matches original vertical fill direction (bottom → top).
		background.Size = UDim2.new(1, -1, -1, 0)
		background.Position = UDim2.new(1, -1, 1, 0)
		background.AnchorPoint = Vector2.new(1.0, 0.0)
	else
		background.Size = UDim2.new(1, 0, 1, -1)
		background.Position = UDim2.new(0, 0, 0, 0)
		background.AnchorPoint = Vector2.new(0, 0)
