                })

                function Toggle:Set(Bool, SkipCallback)
                    Toggle.Value = Bool
                    Library.Flags[Toggle.Flag] = Bool

                    if Bool then
                        Tween(Indicator, { BackgroundColor3 = Theme["Accent"] })
                        Tween(Inline, { BackgroundColor3 = Theme["Accent"] })
                        Tween(Check, { ImageTransparency = 0 })
                        Tween(ToggleText, { TextTransparency = 0 })
                    else
                        Tween(Indicator, { BackgroundColor3 = Theme["Element"] })
                        Tween(Inline, { BackgroundColor3 = Theme["Element"] })
                        Tween(Check, { ImageTransparency = 1 })
                        Tween(ToggleText, { TextTransparency = 0.5 })
                    end

                    if Toggle.AttachedKeybind then
                        Toggle.AttachedKeybind:SyncState(Bool)
                    end

                    if not SkipCallback then
                        Library:SafeCall(Toggle.Callback, Bool)
                    end
                end

                function Toggle:SetFromKeybind(Bool)
                    Toggle:Set(Bool)
                end

                function Toggle:Get()
                    return Toggle.Value
                end

                function Toggle:SetVisibility(Bool)
                    ToggleButton.Visible = Bool
                end

                Toggle.Indicator = Indicator
                Toggle.Inline = Inline

                function Toggle:RefreshTheme()
                    if Toggle.Value then
                        Indicator.BackgroundColor3 = Theme["Accent"]
                        Inline.BackgroundColor3 = Theme["Accent"]
                    elseif Library:IsMouseOver(ToggleButton) then
                        local Lighter = Library:GetLighterColor(Theme["Element"], 1.45)
                        Indicator.BackgroundColor3 = Lighter
                        Inline.BackgroundColor3 = Lighter
                    else
                        Indicator.BackgroundColor3 = Theme["Element"]
                        Inline.BackgroundColor3 = Theme["Element"]
                    end
                end

                function Toggle:RefreshVisual()
                    Toggle:Set(Toggle.Value, true)
                end

                ToggleButton.MouseEnter:Connect(function()
                    if Toggle.Value then return end
                    local Lighter = Library:GetLighterColor(Theme["Element"], 1.45)
                    Tween(Indicator, { BackgroundColor3 = Lighter })
                    Tween(Inline, { BackgroundColor3 = Lighter })
                end)

                ToggleButton.MouseLeave:Connect(function()
                    if Toggle.Value then return end
                    Tween(Indicator, { BackgroundColor3 = Theme["Element"] })
                    Tween(Inline, { BackgroundColor3 = Theme["Element"] })
                end)

                ToggleButton.MouseButton1Down:Connect(function()
                    Toggle:Set(not Toggle.Value)
                end)

                function Toggle:Keybind(KeybindData)
                    Toggle.AttachedKeybind = AttachKeybind(SubElements, KeybindData, Toggle)
                    return Toggle.AttachedKeybind
                end

                function Toggle:Colorpicker(PickerData)
                    return AttachColorpicker(SubElements, PickerData)
                end

                if ToggleData.Default or ToggleData.default then
                    Toggle:Set(true)
                else
                    Library.Flags[Toggle.Flag] = false
                end

                Library.SetFlags[Toggle.Flag] = function(Value)
                    Toggle:Set(Value)
                end

                Library.Options[Toggle.Flag] = Toggle
                return Toggle
            end

            -- ===== button =====
