function Finish.wakeTarget(model, localPlayer, onBoostSim)
	if not model or not model.Parent then
		return false
	end

	if type(onBoostSim) == "function" then
		onBoostSim()
	end

	local hrp = model:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return false
	end

	for i = 1, #WAKE_PARTS do
		local part = model:FindFirstChild(WAKE_PARTS[i])
		if part and part:IsA("BasePart") then
