rebuildList = function()
if not listScroll or not listScroll.Parent then return end
table.clear(rowBadges)
for _, ch in listScroll:GetChildren() do
	if ch:IsA("TextButton") or ch:IsA("Frame") then ch:Destroy() end
end
for i = 1, #logOrder do
	local fid = logOrder[i]
	local e = LoggedAnims[fid]
	if type(e) == "table" and matchesQuery(e, fid, searchQuery) then
		local ok, err = pcall(buildRow, fid, e, i)
		if not ok then warn("[AnimLogger] list row failed: "..tostring(err)) end
	end
end
if titleLbl then titleLbl.Text = string.format("Animation Logger  ·  %d logged", #logOrder) end
syncListCanvas()
task.defer(syncListCanvas)
end

-- Append a single new row at the bottom without rebuilding the list, so the
-- rows already on screen are never destroyed or reflowed. Falls back to a full
-- rebuild only if the list isn't built yet or the row would be filtered out.
appendRow = function(fid)
if not listScroll or not listScroll.Parent then return false end
local e = LoggedAnims[fid]
if not e then return false end
if not matchesQuery(e, fid, searchQuery) then return false end
if rowBadges[fid] then return true end  -- already has a row
local order
for i = 1, #logOrder do
	if logOrder[i] == fid then order = i break end
end
if not order then return false end
local ok, err = pcall(buildRow, fid, e, order)
if not ok then warn("[AnimLogger] append row failed: "..tostring(err)); return false end
if titleLbl then titleLbl.Text = string.format("Animation Logger  ·  %d logged", #logOrder) end
syncListCanvas()
task.defer(syncListCanvas)
return true
end

-- Bump just one already-logged row's ×count badge in place. Returns true if the
-- row's badge was found and updated; false means the row isn't currently shown
-- (e.g. filtered out by search) and the caller should fall back to a rebuild.
updateRowCount = function(fid)
local lbl = rowBadges[fid]
if not lbl or not lbl.Parent then return false end
local e = LoggedAnims[fid]
if not e then return false end
lbl.Text = "×"..(e.count or 1)
return true
end

-- Blacklist an animation: persist it, drop it from the current log, and rebuild.
-- It won't be logged again (logAnim skips blacklisted fids).
blacklistFid = function(fid)
if not fid then return end
blacklist[fid] = true
saveBlacklist()
-- remove from the live log
LoggedAnims[fid] = nil
for i = #logOrder, 1, -1 do
	if logOrder[i] == fid then table.remove(logOrder, i) end
end
rowBadges[fid] = nil
multiSelect[fid] = nil
if selectedFid == fid then
	selectedFid = nil
	selActionIdx = nil
	clearPreviewRig()
	refreshDetail()
	rebuildActions()
end
rebuildList()
notify("Blacklisted — won't log again")
end

local function ensureScreenGui()
	if screenGui and screenGui.Parent then
		return screenGui
	end

	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "NiphAnimLogger"
	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.DisplayOrder = 100
	screenGui.IgnoreGuiInset = true
	screenGui.Enabled = true

	local parented = false
	if gethui then
		local ok, hui = pcall(gethui)
		if ok and hui then
			screenGui.Parent = hui
			parented = true
		end
	end
	if not parented then
		screenGui.Parent = game:GetService("CoreGui")
	end

	return screenGui
end

