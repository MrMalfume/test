function Library:EnsureConfigFolder()
    pcall(function()
        if type(isfolder) == "function" and not isfolder(Library.Folders.Directory) then
            makefolder(Library.Folders.Directory)
        end

        if type(isfolder) == "function" and not isfolder(Library:GetConfigPath()) then
            makefolder(Library:GetConfigPath())
        end
    end)
end

function Library:GetConfigs()
    Library:EnsureConfigFolder()

    local List = { }

    if type(listfiles) ~= "function" then
        return List
    end

    local Ok, Files = pcall(listfiles, Library:GetConfigPath())
    if not Ok or not Files then
        return List
    end

    for _, File in Files do
        local Name = File:match("([^/\\]+)%.json$")
        if Name then
            table.insert(List, Name)
        end
    end

    table.sort(List)
    return List
end

function Library:SaveConfig(Name)
    if not Name or Name == "" then
        return false
    end

    Library:EnsureConfigFolder()

    local Config = { }

    for Flag, Value in pairs(Library.Flags) do
        if Flag == "ConfigList" or Flag == "ConfigName" then
            continue
        end

        if type(Value) == "table" and Value.Key ~= nil then
            Config[Flag] = {
                Key = GetKeyName(Value.Key),
                Mode = Value.Mode,
                Toggled = Value.Toggled
            }
        elseif type(Value) == "table" and Value.Color then
            Config[Flag] = {
                Color = Value.Color:ToHex(),
                Alpha = Value.Alpha or Value.Transparency or 0,
                Rainbow = Value.Rainbow or false
            }
        else
            Config[Flag] = Value
        end
    end

    if type(writefile) ~= "function" then
        return false
    end

    local Ok = pcall(function()
        writefile(Library:GetConfigPath() .. "/" .. Name .. ".json", HttpService:JSONEncode(Config))
    end)

    return Ok
end

function Library:LoadConfig(Name)
    if not Name or Name == "" or type(readfile) ~= "function" or type(isfile) ~= "function" then
        return false
    end

    local Path = Library:GetConfigPath() .. "/" .. Name .. ".json"
    if not isfile(Path) then
        return false
    end

    local Ok, Data = pcall(function()
        return HttpService:JSONDecode(readfile(Path))
    end)

    if not Ok or type(Data) ~= "table" then
        return false
    end

    for Flag, Value in pairs(Data) do
        local Setter = Library.SetFlags[Flag]
        if not Setter then
            continue
        end

        if type(Value) == "table" and Value.Color and type(Value.Color) == "string" then
            Setter({
                Color = Color3.fromHex(Value.Color),
                Alpha = Value.Alpha or Value.Transparency or 0,
                Rainbow = Value.Rainbow
            })
        elseif type(Value) == "table" and Value.Key ~= nil then
            Setter({
                Key = ParseKey(Value.Key),
                Mode = Value.Mode
            })
        else
            Setter(Value)
        end
    end

    return true
end

function Library:DeleteConfig(Name)
    if not Name or Name == "" or type(delfile) ~= "function" or type(isfile) ~= "function" then
        return false
    end

    local Path = Library:GetConfigPath() .. "/" .. Name .. ".json"
    if not isfile(Path) then
        return false
    end

    local Ok = pcall(delfile, Path)
    if Ok and Library:GetAutoLoadConfig() == Name then
        Library:ClearAutoLoadConfig()
    end

    return Ok
end

function Library:GetAutoLoadConfig()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then
        return ""
    end

    local Path = Library:GetConfigPath() .. "/autoload.txt"
    if not isfile(Path) then
        return ""
    end

    local Ok, Content = pcall(readfile, Path)
    if Ok and Content then
        return Content:gsub("%s+", "")
    end

    return ""
end

function Library:SetAutoLoadConfig(Name)
    if not Name or Name == "" or type(writefile) ~= "function" then
        return false
    end

    Library:EnsureConfigFolder()

    return pcall(function()
        writefile(Library:GetConfigPath() .. "/autoload.txt", Name)
    end)
end

function Library:ClearAutoLoadConfig()
    if type(delfile) ~= "function" or type(isfile) ~= "function" then
        return false
    end

    local Path = Library:GetConfigPath() .. "/autoload.txt"
    if isfile(Path) then
        return pcall(delfile, Path)
    end

    return true
end

function Library:TryAutoLoadConfig()
    local Name = Library:GetAutoLoadConfig()
    if Name == "" then
        return false
    end

    if Library:LoadConfig(Name) then
        Library:Notification({
            Name = "Auto Load",
            Description = "Loaded config:\n" .. Name,
            Duration = 5
        })
        return true
    end

    Library:Notification({
        Name = "Auto Load",
        Description = "Failed to load:\n" .. Name,
        Duration = 5
    })

    return false
end

