local players = game:GetService("Players")

-- Maids.
local worldMaid = Maid.new()

-- Original stores.
local particleMap = OriginalStoreManager.new()
local postEffectMap = OriginalStoreManager.new()

-- Constants.
local APPLY_INTERVAL = 0.4
local PARTICLE_SCAN_INTERVAL = 2.0
local PARTICLE_CLASSES = {
	ParticleEmitter = true,
	Trail = true,
	Smoke = true,
	Fire = true,
	Sparkles = true,
	Beam = true,
}
local POST_EFFECT_CLASSES = {
	BlurEffect = true,
	ColorCorrectionEffect = true,
	SunRaysEffect = true,
	DepthOfFieldEffect = true,
	BloomEffect = true,
}

-- Snapshot of the untouched lighting state.
local snapshot = nil

-- Accumulators.
local applyAccumulator = 0
local particleAccumulator = 0

---Snapshot lighting once so every toggle has something to restore to.
local function takeSnapshot()
	if snapshot then
		return
	end

	local atmosphere = lighting:FindFirstChildOfClass("Atmosphere")
	local camera = workspace.CurrentCamera
	local localPlayer = players.LocalPlayer

	snapshot = {
		FieldOfView = camera and camera.FieldOfView,
		CameraMaxZoomDistance = localPlayer and localPlayer.CameraMaxZoomDistance,
		Ambient = lighting.Ambient,
		Brightness = lighting.Brightness,
		ClockTime = lighting.ClockTime,
		ExposureCompensation = lighting.ExposureCompensation,
		FogEnd = lighting.FogEnd,
		FogStart = lighting.FogStart,
		GlobalShadows = lighting.GlobalShadows,
		OutdoorAmbient = lighting.OutdoorAmbient,
		Density = atmosphere and atmosphere.Density,
		Haze = atmosphere and atmosphere.Haze,
	}
end

---Apply full bright.
local function applyFullBright()
	local level = math.clamp(Configuration.expectOptionValue("FullBrightLevel") or 150, 0, 255)
	local color = Color3.fromRGB(level, level, level)

	lighting.Ambient = color
	lighting.OutdoorAmbient = color
	lighting.Brightness = 2
	lighting.ExposureCompensation = 0
end

---Apply fog removal.
local function applyNoFog()
	lighting.FogEnd = 1e6
	lighting.FogStart = 1e6

	local atmosphere = lighting:FindFirstChildOfClass("Atmosphere")
	if not atmosphere then
		return
	end

	atmosphere.Density = 0
	atmosphere.Haze = 0
end

---Apply the lighting overrides that are currently enabled.
local function applyLighting()
	if Configuration.expectToggleValue("FullBright") then
		applyFullBright()
	end

	if Configuration.expectToggleValue("NoFog") then
		applyNoFog()
	end

	if Configuration.expectToggleValue("NoShadows") then
		lighting.GlobalShadows = false
	end

	if Configuration.expectToggleValue("TimeControl") then
		lighting.ClockTime = Configuration.expectOptionValue("TimeOfDay") or 14
	end

	if Configuration.expectToggleValue("AmbientOverride") then
		local color = Configuration.expectOptionValue("AmbientColor") or Color3.fromRGB(150, 150, 150)

		lighting.Ambient = color
		lighting.OutdoorAmbient = color
	end
end

---Restore the properties whose toggles are now off.
local function restoreLighting()
	if not snapshot then
		return
	end

	local fullBright = Configuration.expectToggleValue("FullBright")
	local ambientOverride = Configuration.expectToggleValue("AmbientOverride")

	if not fullBright and not ambientOverride then
		lighting.Ambient = snapshot.Ambient
		lighting.OutdoorAmbient = snapshot.OutdoorAmbient
	end

	if not fullBright then
		lighting.Brightness = snapshot.Brightness
		lighting.ExposureCompensation = snapshot.ExposureCompensation
	end

	if not Configuration.expectToggleValue("TimeControl") and not fullBright then
		lighting.ClockTime = snapshot.ClockTime
	end

	if not Configuration.expectToggleValue("NoFog") then
		lighting.FogEnd = snapshot.FogEnd
		lighting.FogStart = snapshot.FogStart

		local atmosphere = lighting:FindFirstChildOfClass("Atmosphere")
		if atmosphere and snapshot.Density then
			atmosphere.Density = snapshot.Density
			atmosphere.Haze = snapshot.Haze
		end
	end

	if not Configuration.expectToggleValue("NoShadows") then
		lighting.GlobalShadows = snapshot.GlobalShadows
	end
end

---Toggle world particles and trails.
local function updateParticles()
	if not Configuration.expectToggleValue("RemoveParticles") then
		return particleMap:restore()
	end

	for _, descendant in next, workspace:GetDescendants() do
		if not PARTICLE_CLASSES[descendant.ClassName] then
			continue
		end

		if not descendant.Enabled then
			continue
		end

		particleMap:add(descendant, "Enabled", false)
	end
end

---Toggle Lighting post-processing effects.
local function updatePostEffects()
	if not Configuration.expectToggleValue("RemovePostEffects") then
		return postEffectMap:restore()
	end

	for _, child in next, lighting:GetChildren() do
		if not POST_EFFECT_CLASSES[child.ClassName] then
			continue
		end

		if not child.Enabled then
			continue
		end

		postEffectMap:add(child, "Enabled", false)
	end
end

---Apply the camera overrides.
local function updateCamera()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	if Configuration.expectToggleValue("FieldOfViewOverride") then
		local fieldOfView = Configuration.expectOptionValue("FieldOfViewValue") or 70

		if math.abs(camera.FieldOfView - fieldOfView) > 0.01 then
			camera.FieldOfView = fieldOfView
		end
	end

	local localPlayer = players.LocalPlayer
	if not localPlayer then
		return
	end

	if Configuration.expectToggleValue("CameraZoomOverride") then
		local maxZoom = Configuration.expectOptionValue("CameraMaxZoom") or 128

		if localPlayer.CameraMaxZoomDistance ~= maxZoom then
			localPlayer.CameraMaxZoomDistance = maxZoom
		end
	end
end

---Update world.
---@param deltaTime number
local function updateWorld(deltaTime)
	applyAccumulator = applyAccumulator + deltaTime
	particleAccumulator = particleAccumulator + deltaTime

	updateCamera()

	if applyAccumulator >= APPLY_INTERVAL then
		applyAccumulator = 0

		takeSnapshot()
		applyLighting()
		restoreLighting()
		updatePostEffects()
	end

	if particleAccumulator >= PARTICLE_SCAN_INTERVAL then
		particleAccumulator = 0

		updateParticles()
	end
end

---Restore everything the module touched.
function World.restore()
	particleMap:restore()
	postEffectMap:restore()

	if not snapshot then
		return
	end

	local atmosphere = lighting:FindFirstChildOfClass("Atmosphere")
	local camera = workspace.CurrentCamera
	local localPlayer = players.LocalPlayer

	if camera and snapshot.FieldOfView then
		camera.FieldOfView = snapshot.FieldOfView
	end

	if localPlayer and snapshot.CameraMaxZoomDistance then
		localPlayer.CameraMaxZoomDistance = snapshot.CameraMaxZoomDistance
	end

	lighting.Ambient = snapshot.Ambient
	lighting.Brightness = snapshot.Brightness
	lighting.ClockTime = snapshot.ClockTime
	lighting.ExposureCompensation = snapshot.ExposureCompensation
	lighting.FogEnd = snapshot.FogEnd
	lighting.FogStart = snapshot.FogStart
	lighting.GlobalShadows = snapshot.GlobalShadows
	lighting.OutdoorAmbient = snapshot.OutdoorAmbient

	if atmosphere and snapshot.Density then
		atmosphere.Density = snapshot.Density
		atmosphere.Haze = snapshot.Haze
	end
end

---Initialize world.
function World.init()
	takeSnapshot()

	local heartbeat = Signal.new(runService.Heartbeat)
	worldMaid:add(heartbeat:connect("World_Heartbeat", updateWorld))

	Logger.warn("World initialized.")
end

---Detach world.
function World.detach()
	worldMaid:clean()

	World.restore()

	particleMap:detach()
	postEffectMap:detach()

	Logger.warn("World detached.")
end

-- Return World module.
return World
