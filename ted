-- // Built-in settings tab (theme, configs, interface)
function Library:EnsureInterface(Data)
    Data = Data or { }

    if not Library.WatermarkInstance then
        Library.WatermarkInstance = Library:Watermark({
            Name = Data.Watermark or Data.watermark or "Niph",
            Logo = Data.Logo or Data.logo or Icons.Logo
        })
    end

    if not Library.KeybindListInstance then
        Library.KeybindListInstance = Library:KeybindsList()
    end
end

function Library:RunStartup(Window)
    if Library.StartupRan then
        return
    end

    Library.StartupRan = true

    Library:Connect(Players.PlayerRemoving, function(Player)
        if Player ~= LocalPlayer then
            return
        end

        if Library.Flags["SaveConfigOnLeave"] then
            local Name = Library.Flags["ConfigList"] or Library.Flags["ConfigName"] or "default"
            if Name and Name ~= "" and Name ~= "No Configs" then
                Library:SaveConfig(Name)
            end
        end
    end)

    Library:TryAutoLoadConfig()

    if Library.Flags["SilentLaunch"] then
        Window:SetOpen(false)
    end
end

function Library:PopulateSettingsPage(Page, Window)
    Library:EnsureInterface()

    Window.ToggleKey = GetKeyName(ParseKey(Window.ToggleKey or "RightShift"))
    Library.ToggleKey = Window.ToggleKey

    local Section = Page:Section({ Name = "theme", Icon = Icons.paintpalette, Side = 1 })

    Section:Dropdown({
        Name = "preset",
        Flag = "ThemePreset",
        Items = { "Reptillion", "Kiwi", "Halloween", "Aqua", "One Tap" },
        Default = "Reptillion",
        Callback = function(Value)
            Library:SetTheme(Value)
        end
    })

    Section:Colorpicker({
        Name = "menu accent",
        Flag = "ThemeAccent",
        Default = Theme["Accent"],
        Callback = function(Color)
            Library:ChangeTheme("Accent", Color)
        end
    })

    Section:Colorpicker({
        Name = "background",
        Flag = "ThemeBackground",
        Default = Theme["Background"],
        Callback = function(Color)
            Library:ChangeTheme("Background", Color)
        end
    })

    Section:Colorpicker({
        Name = "header",
        Flag = "ThemeHeader",
        Default = Theme["Header"],
        Callback = function(Color)
            Library:ChangeTheme("Header", Color)
        end
    })

    Section = Page:Section({ Name = "configs", Icon = Icons.clipboard, Side = 1 })

    Library.ConfigList = Section:Dropdown({
        Name = "config list",
        Flag = "ConfigList",
        Items = Library:GetConfigNameList(),
        Default = Library:GetConfigNameList()[1]
    })

    Section:Textbox({
        Name = "config name",
        Flag = "ConfigName",
        Placeholder = "default"
    })

    Section:Button({
        Name = "save",
        Callback = function()
            local Name = Library:GetSelectedConfigName()

            if Library:SaveConfig(Name) then
                Library:RefreshConfigList()
                Library:Notification({ Name = "Configs", Description = "Saved config:\n" .. Name, Duration = 5 })
            else
                Library:Notification({ Name = "Configs", Description = "Failed to save config", Duration = 5 })
            end
        end
    })

    Section:Button({
        Name = "load",
        Callback = function()
            local Name = Library.Flags["ConfigList"]
            if Name and Name ~= "" and Name ~= "No Configs" then
                if Library:LoadConfig(Name) then
                    Library:Notification({ Name = "Configs", Description = "Loaded config:\n" .. Name, Duration = 5 })
                else
                    Library:Notification({ Name = "Configs", Description = "Failed to load config", Duration = 5 })
                end
            else
                Library:Notification({ Name = "Configs", Description = "No config selected", Duration = 5 })
            end
        end
    })

    Section:Button({
        Name = "delete",
        Callback = function()
            local Name = Library.Flags["ConfigList"]
            if Name and Name ~= "" and Name ~= "No Configs" then
                if Library:DeleteConfig(Name) then
                    Library:RefreshConfigList()
                    Library:Notification({ Name = "Configs", Description = "Deleted config:\n" .. Name, Duration = 5 })
                else
                    Library:Notification({ Name = "Configs", Description = "Failed to delete config", Duration = 5 })
                end
            end
        end
    })

    Library.AutoLoadLabel = Section:Label("auto load: none")
    Library:UpdateAutoLoadLabel()

    Section:Button({
        Name = "set auto load",
        Callback = function()
            local Name = Library.Flags["ConfigList"]
            if Name and Name ~= "" and Name ~= "No Configs" then
                Library:SaveConfig(Name)
                Library:SetAutoLoadConfig(Name)
                Library:UpdateAutoLoadLabel()
                Library:Notification({ Name = "Auto Load", Description = "Set auto-load:\n" .. Name, Duration = 5 })
            end
        end
    })

    Section:Button({
        Name = "clear auto load",
        Callback = function()
            Library:ClearAutoLoadConfig()
            Library:UpdateAutoLoadLabel()
            Library:Notification({ Name = "Auto Load", Description = "Cleared auto-load", Duration = 5 })
        end
    })

    Section = Page:Section({ Name = "interface", Icon = Icons.sliderHorizontal3, Side = 2 })

    Section:Toggle({
        Name = "watermark",
        Flag = "ShowWatermark",
        Default = true,
        Callback = function(Value)
            Library.WatermarkInstance:SetVisibility(Value)
        end
    })

    Section:Toggle({
        Name = "keybind list",
        Flag = "ShowKeybindList",
        Default = true,
        Callback = function(Value)
            Library.KeybindListInstance:SetVisibility(Value)
        end
    })

    Section:Toggle({
        Name = "custom cursor",
        Flag = "CustomCursor",
        Default = false,
        Callback = function(Value)
            Library:SetCustomCursor(Value)
        end
    })

    Section:Keybind({
        Name = "menu key",
        Flag = "MenuKey",
        Default = "LeftAlt",
        Passive = true,
        OnChanged = function(Key)
            Window.ToggleKey = GetKeyName(Key)
            Library.ToggleKey = Window.ToggleKey
        end
    })

    Section:Toggle({
        Name = "silent mode",
        Flag = "SilentMode",
        Default = false,
        Callback = function(Value)
            Library.SilentNotifications = Value

            local niph = shared and shared.Niph
            if niph then
                niph.silent = Value
            end

            if type(isfile) == "function" and type(writefile) == "function" and type(delfile) == "function" then
                if Value and not isfile("smarker.txt") then
                    writefile(
                        "smarker.txt",
                        "Niph silent mode is on. Delete this file to turn it off."
                    )
                elseif not Value and isfile("smarker.txt") then
                    delfile("smarker.txt")
                end
            end
        end
    })

    Section:Toggle({
        Name = "silent launch",
        Flag = "SilentLaunch",
        Default = false,
        Callback = function(Value)
            Window:SetOpen(not Value)
        end
    })

    Section:Toggle({
        Name = "save config before leaving",
        Flag = "SaveConfigOnLeave",
        Default = false
    })

    Section:Toggle({
        Name = "save config on unload",
        Flag = "SaveConfigOnUnload",
        Default = false
    })

    Section:Button({
        Name = "unload",
        Callback = function()
            local niph = shared and shared.Niph
            if niph and niph.detach then
                niph.detach()
            else
                Library:Unload()
            end
        end
    })

    Library:RunStartup(Window)
end

-- // Unload
function Library:Unload()
    if Library.Flags["SaveConfigOnUnload"] then
        local Name = Library.Flags["ConfigList"] or Library.Flags["ConfigName"] or "default"
        if Name and Name ~= "" and Name ~= "No Configs" then
            Library:SaveConfig(Name)
        end
    end

    UserInputService.MouseIconEnabled = true

    for _, Connection in ipairs(Library.Connections) do
        pcall(function()
            Connection:Disconnect()
        end)
    end

    for _, Thread in ipairs(Library.Threads) do
        pcall(task.cancel, Thread)
    end

    if ScreenGui then
        ScreenGui:Destroy()
    end

    Library.WindowInstance = nil

    GetGenv().ReptillionLibrary = nil
end

GetGenv().ReptillionLibrary = Library

return Library
