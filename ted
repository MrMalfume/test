        return ""
    end
    return (txt:gsub("^Defeat%s+", ""):gsub("%(s%)", ""):gsub("%s+$", ""))
end

local function killMissionTarget(opts)
    opts = opts or {}
    local folder = Workspace:FindFirstChild("npc")
    if not folder then
        return false
    end
    local txt = missionText()
    if txt == "" then
        return false
    end
    local clean = missionNameClean(txt)
    local flagName = opts.flagName or "autoBoss"
    local myRoot = root()
    local origin = myRoot and myRoot.Position

    local function isFightable(v)
        if not v or v.Name == "logtraining" or v:FindFirstChild("rpaw") then
            return false
        end
        if npcGone(v) then
            return false
        end
        local th = v:FindFirstChildWhichIsA("Humanoid")
        if not th or th.Health <= 0 then
            return false
        end
        local name = getNpcDisplayName(v)
        if not name then
            return false
        end
        if opts.skipSpirit and string.find(name, "Spirit", 1, true) then
            return false
        end
        if string.find(txt, name, 1, true) then
            return true
        end
        if clean ~= "" and (name == clean or string.find(name, clean, 1, true) or string.find(clean, name, 1, true)) then
            return true
        end
        if opts.anyNpc and v:FindFirstChild("npctype") then
            return true
        end
        return false
    end

    local function pickClosest()
        local best, bestD
        origin = root() and root().Position
        for _, v in ipairs(folder:GetChildren()) do
            if isFightable(v) then
                local thrp = v:FindFirstChild("HumanoidRootPart")
                local d = origin and thrp and (thrp.Position - origin).Magnitude or 0
                if not bestD or d < bestD then
                    best, bestD = v, d
                end
            end
        end
        return best
    end

    local target = pickClosest()
    if not target then
        state.lockTarget = nil
        return false
    end

    state.lockTarget = target
    local skillTick = 0
    local skillIdx = 0
    local lastHp = math.huge
    local lastProgress = tick()
    local startedAt = tick()
    local stuckAfter = state.cfg.stuckSeconds or 12

    while alive() and state.flags[flagName] and missionVisible() do
        if not charReady() then
            state.lockTarget = nil
            releaseFacing()
            task.wait(1.5)
            return false
        end

        local th = target:FindFirstChildWhichIsA("Humanoid")
        local thrp = target:FindFirstChild("HumanoidRootPart")
        local hp = (th and th.Health) or 0

        if npcGone(target) or hp <= 0 then
            local nextT = pickClosest()
            if nextT then
                target = nextT
                state.lockTarget = target
                lastHp = math.huge
                lastProgress = tick()
                startedAt = tick()
                task.wait(0.05)
            else
                break
            end
        end

        th = target:FindFirstChildWhichIsA("Humanoid")
        thrp = target:FindFirstChild("HumanoidRootPart")
        hp = (th and th.Health) or 0

        if hp > 0 and hp < lastHp - 0.5 then
            lastHp = hp
            lastProgress = tick()
        end
        if tick() - lastProgress > stuckAfter then
            state.lockTarget = nil
            releaseFacing()
            coolFor(flagName, 4)
            notify("Failsafe", "Target took no damage â€” moving to the next one.", "Warning")
            return false
        end
        if tick() - startedAt > 420 then
            state.lockTarget = nil
            releaseFacing()
            coolFor(flagName, 4)
            notify("Failsafe", "Target held too long â€” released.", "Warning")
            return false
        end

        local ch = LP.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        local humObj = ch and ch:FindFirstChildWhichIsA("Humanoid")
        local combat = ch and ch:FindFirstChild("combat") and ch.combat:FindFirstChild("update")
        if not thrp or not hrp or not combat then
            task.wait(0.1)
        else
            forceCharNoCollide(farmModeIsBelow(state.lockFarmGroup or "boss"))
            pcall(function()
                if farmModeIsBelow(state.lockFarmGroup or "boss") then
                    applyBelowFarmPose(humObj, thrp, state.lockFarmGroup, target)
                else
                    faceLockFarm(humObj, state.lockFarmGroup)
                    hrp.CFrame = calcFarmCF(thrp, state.lockFarmGroup, target)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end)
            if not farmModeIsBelow(state.lockFarmGroup or "boss") then
                holdFarmHumanoidState(humObj)
            end

            prepTarget(target)
            local charging = manageChi(combat)
            if not charging then
                punchOnce(combat)
                skillTick = skillTick + 1
                if skillsOk() and not inputBlocked(combat) and skillTick % 3 == 0 then
                    skillIdx = (skillIdx % #SKILL_KEYS) + 1
                    pressSkill(combat, SKILL_KEYS[skillIdx])
                end
            else
                task.wait(0.08)
            end

            if state.flags.semiKill then
                tryFinishNpc(target)
            end
            task.wait(state.cfg.farmWait)
        end
    end
    state.lockTarget = nil
    releaseFacing()
    okStep(flagName)
    return true
end

