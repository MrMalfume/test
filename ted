	if opts.lockTarget and opts.lockTarget ~= model and not opts.allowSweep then
		return false
	end

	local now = tick()
	local lastAt = lastFinishAt[model]
	if lastAt and (now - lastAt) < FINISH_COOLDOWN then
		return false
	end

	if not Finish.wakeTarget(model, opts.localPlayer, opts.onBoostSim) then
		return false
	end

	local humanoid = model:FindFirstChildWhichIsA("Humanoid")
	if not Finish.isFinishable(humanoid, opts.hpRatio) then
		return false
	end

	humanoid.Health = 0
	lastFinishAt[model] = now
	return true
end

