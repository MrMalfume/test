local body = raw:match("^VR1\n(.*)$") or raw
local ok, dec = pcall(function() return vrXor(vrB64Decode(body)) end)
if not ok or not dec then return nil end
local ok2, data = pcall(function() return Http:JSONDecode(dec) end)
if ok2 and type(data) == "table" then return data end
