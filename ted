end

local function option(key, default)
	local value = Configuration.expectOptionValue(key)
	if typeof(value) == "table" and value.Color then
		return value.Color
	end
	return typeof(value) == "number" and value or default
end

local function getDrawing(key, className)
	if drawings[key] then
		return drawings[key]
	end
	if not Drawing then
		return nil
	end
	local inst = Drawing.new(className)
	drawings[key] = inst
	return inst
end

local function hideAll()
	for _, inst in drawings do
		inst.Visible = false
	end
end

local function worldToScreen(pos, camera)
	return camera:WorldToViewportPoint(pos)
end

local function drawEntity(model, color, camera, origin, maxRange, settings)
	local root = Entities.root(model)
	if not root then
		return
	end

	local distance = (root.Position - origin).Magnitude
	if distance > maxRange then
		return
	end

	local screen, onScreen = worldToScreen(root.Position + Vector3.new(0, 3, 0), camera)
	if not onScreen then
		return
	end

	local key = tostring(model)
	local text = getDrawing(key .. "_text", "Text")
	if text then
		local label = Entities.displayName(model)
		if settings.showDistance then
			label ..= string.format(" [%dm]", math.floor(distance))
		end
		if settings.showHp then
			local hp, maxHp = Entities.health(model)
			label ..= string.format(" %d/%d", math.floor(hp), math.floor(maxHp))
		end
		if settings.showWeapon then
			local weapon = Entities.weaponName(model)
			if weapon then
				label ..= " | " .. weapon
			end
		end
		text.Text = label
		text.Position = Vector2.new(screen.X, screen.Y)
		text.Color = color
		text.Size = 14
		text.Center = true
		text.Outline = true
		text.Visible = true
	end

	if settings.boxes then
		local box = getDrawing(key .. "_box", "Square")
		if box then
			local foot = worldToScreen(root.Position - Vector3.new(0, 3, 0), camera)
			local height = math.abs(screen.Y - foot.Y)
			box.Size = Vector2.new(height * 0.45, height)
			box.Position = Vector2.new(screen.X - box.Size.X * 0.5, screen.Y - box.Size.Y * 0.5)
			box.Color = color
			box.Filled = false
			box.Thickness = 1
			box.Visible = true
		end
	end
end

local function onRender()
	if not flag("GbPlayerEsp") and not flag("GbMobEsp") then
		hideAll()
		return
	end

	local camera = workspace.CurrentCamera
	local character = players.LocalPlayer and players.LocalPlayer.Character
	local origin = character and Entities.root(character)
	if not camera or not origin then
		return
	end

	hideAll()

	local maxRange = option("GbEspRange", 600)
	local settings = {
		showName = flag("GbEspShowName"),
		showDistance = flag("GbEspShowDistance"),
		showHp = flag("GbEspShowHp"),
		showWeapon = flag("GbEspShowWeapon"),
		boxes = flag("GbEspBoxes"),
	}

	for _, model in Entities.allLiving() do
		local isPlayer = Entities.isPlayer(model)
		if isPlayer and not flag("GbPlayerEsp") then
			continue
		end
		if not isPlayer and not flag("GbMobEsp") then
			continue
		end
		if isPlayer and model == character and not flag("GbShowLocalEsp") then
			continue
		end

		local color = isPlayer and option("GbPlayerEspColor", Color3.fromRGB(120, 190, 255))
			or option("GbMobEspColor", Color3.fromRGB(255, 145, 120))

		drawEntity(model, color, camera, origin.Position, maxRange, settings)
	end
end

