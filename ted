local function addMissEntryNow(defenderType, key, name, distance, source)
	local data = Library.InfoLoggerData
	if not data then
		return
	end

	if data.KeyBlacklistList[key] then
		return
	end

	local entries = data.MissingDataEntries
	local sameType = {}

	for index, entry in ipairs(entries) do
		if entry.Type == defenderType then
			sameType[#sameType + 1] = { entry = entry, index = index }
		end
	end

	if #sameType > maxPerType then
		local oldest = sameType[#sameType]
		if oldest and oldest.entry.Label then
			oldest.entry.Label:Destroy()
		end
		table.remove(entries, oldest.index)
	end

	local text
	if source and source ~= "" then
		text = string.format("(%.2fm away) Key '%s' from '%s' is missing.", distance or 0, key, source)
	else
		text = string.format("(%.2fm away) Key '%s' is missing.", distance or 0, key)
	end

	if name and name ~= "" then
		text = string.format("(%s) %s", name, text)
	end

	local label = createLabel({
		Text = text,
		Size = UDim2.new(1, 0, 0, 14),
		LayoutOrder = 1,
		Visible = true,
		ZIndex = 306,
		Parent = nil,
	})

	label.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if setclipboard then
				setclipboard(key)
				notify(string.format("Copied key '%s' to clipboard.", key))
			end
			tryOpenVisualizer(key)
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			data.KeyBlacklistList[key] = true
			data.KeyBlacklistHistory[#data.KeyBlacklistHistory + 1] = key
			InfoLogger.refresh()
			refreshBlacklistDropdown()
			notify(string.format("Blacklisted key '%s' from list.", key))
		end
	end)

	table.insert(entries, 1, {
		Label = label,
		Key = key,
		Type = defenderType,
		Name = name,
	})

	InfoLogger.refresh()
end

function Library:AddMissEntry(defenderType, key, name, distance, source)
	if not key or not Library.InfoLoggerData then
		return
	end

	table.insert(pendingQueue, 1, function()
		addMissEntryNow(defenderType, key, name, distance, source)
	end)
end

