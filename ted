-- .VR config codec --------------------------------------------------
-- Kept byte-for-byte in sync with the AP (Games/VVV/Ap.luau) so a .VR written
-- here is readable there and vice-versa: JSON XOR'd against a keystream then
-- base64'd. Legacy .json files are still read on the merge path.
local VR_KEY = "Serotonin.VVV.anim.v1"
local VR_B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function vrB64Encode(data)
return ((data:gsub(".", function(x)
	local r, b = "", x:byte()
	for i = 8, 1, -1 do r = r .. (b % 2 ^ i - b % 2 ^ (i - 1) > 0 and "1" or "0") end
	return r
end) .. "0000"):gsub("%d%d%d?%d?%d?%d?", function(x)
	if #x < 6 then return "" end
	local c = 0
	for i = 1, 6 do c = c + (x:sub(i, i) == "1" and 2 ^ (6 - i) or 0) end
	return VR_B64:sub(c + 1, c + 1)
end) .. ({ "", "==", "=" })[#data % 3 + 1])
end

local function vrB64Decode(data)
data = data:gsub("[^" .. VR_B64 .. "=]", "")
return (data:gsub(".", function(x)
	if x == "=" then return "" end
	local r, f = "", (VR_B64:find(x) - 1)
	for i = 6, 1, -1 do r = r .. (f % 2 ^ i - f % 2 ^ (i - 1) > 0 and "1" or "0") end
	return r
end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(x)
	if #x ~= 8 then return "" end
	local c = 0
	for i = 1, 8 do c = c + (x:sub(i, i) == "1" and 2 ^ (8 - i) or 0) end
	return string.char(c)
end))
end

local function vrXor(s)
local out, klen = {}, #VR_KEY
for i = 1, #s do
	out[i] = string.char(bit32.bxor(s:byte(i), VR_KEY:byte((i - 1) % klen + 1)))
end
return table.concat(out)
end

local function encodeVR(tbl)
local ok, json = pcall(function() return Http:JSONEncode(tbl) end)
if not ok or not json then return nil end
return "VR1\n" .. vrB64Encode(vrXor(json))
end

local function decodeVR(raw)
