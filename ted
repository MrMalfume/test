    })

    local VersionBadge = New("Frame", {
        Parent = Title,
        Name = "Version",
        BackgroundColor3 = Theme["Background"],
        Position = UDim2New(1, 5, 0, 1),
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2New(0, 0, 0, 15),
        BorderSizePixel = 0,
        ZIndex = 2
    })

    Library:ApplyTheme(VersionBadge, { BackgroundColor3 = "Background" })

    New("UIPadding", {
        Parent = VersionBadge,
        PaddingLeft = UDimNew(0, 6),
        PaddingRight = UDimNew(0, 5)
    })

    local VersionText = New("TextLabel", {
        Parent = VersionBadge,
        Name = "VersionText",
        FontFace = LibraryFont,
        Text = Window.Version,
        TextSize = 12,
        TextColor3 = Theme["Text"],
        TextTransparency = 0.5,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Position = UDim2New(0, -2, 0, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2New(0, 0, 0, 15),
        ZIndex = 2
    })

    Library:ApplyTheme(VersionText, { TextColor3 = "Text" })

    New("UICorner", {
        Parent = VersionBadge,
        CornerRadius = UDimNew(0, 5)
    })

    BorderStroke(VersionBadge)

    function Window:SetText(Text)
        Title.Text = Text
    end

    function Window:SetVersion(Text)
        Window.Version = Text
        VersionText.Text = Text
    end

    -- tabs live in the header (right side)
    local TabsHolder = New("Frame", {
        Parent = Topbar,
        Name = "Tabs",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2New(1, 0.5),
        Position = UDim2New(1, -16, 0.5, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2New(0, 0, 0, 33),
        ZIndex = 2
    })

    New("UIListLayout", {
        Parent = TabsHolder,
        FillDirection = Enum.FillDirection.Horizontal,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDimNew(0, 4)
    })

    -- content area
    local Content = New("Frame", {
        Parent = MainFrame,
        Name = "Content",
        BackgroundTransparency = 1,
        Position = UDim2New(0, 0, 0, HeaderHeight),
        Size = UDim2New(1, 0, 1, -HeaderHeight),
        ClipsDescendants = true,
        ZIndex = 2
    })

    Window.Content = Content

    -- open / close
    local FadeDebounce = false

    function Window:SetOpen(Bool)
        if FadeDebounce then
            return
        end

        Window.IsOpen = Bool
        FadeDebounce = true

        if Bool then
            MainFrame.Visible = true
            Overlay.Visible = true

            local LastTween = FadeInstance(MainFrame, true, Window.FadeSpeed)
            if LastTween then
                LastTween.Completed:Once(function()
                    FadeDebounce = false
                    Window:UpdateCursor()
                end)
            else
                FadeDebounce = false
                Window:UpdateCursor()
            end
        else
            Library:ClosePopups()
            Overlay.Visible = false

            local LastTween = FadeInstance(MainFrame, false, Window.FadeSpeed)
            if LastTween then
                LastTween.Completed:Once(function()
                    if not Window.IsOpen then
                        MainFrame.Visible = false
                    end
                    FadeDebounce = false
                    Window:UpdateCursor()
                end)
            else
                MainFrame.Visible = false
                FadeDebounce = false
                Window:UpdateCursor()
            end
        end
    end

    Library:Connect(UserInputService.InputBegan, function(Input, GameProcessed)
        if KeybindMatchesInput(Window.ToggleKey, Input) then
            Window:SetOpen(not Window.IsOpen)
            return
        end

        if GameProcessed then
            return
        end
    end)

    -- ===== pages =====
    function Window:Page(PageData)
        PageData = PageData or { }

        local Page = {
            Window = Window,
            Name = PageData.Name or PageData.name or "page",
            Icon = PageData.Icon or PageData.icon or Icons.PageDefault,
            Columns = PageData.Columns or PageData.columns or 2,

            ColumnsData = { },
            Active = false
        }

        -- page content + columns
        local PageContent = New("Frame", {
            Parent = Content,
            Name = "PageContent",
            BackgroundTransparency = 1,
            Size = UDim2New(1, 0, 1, 0),
            Visible = false
        })

        local ColumnsFrame = New("Frame", {
            Parent = PageContent,
            Name = "Columns",
            BackgroundTransparency = 1,
            Position = UDim2New(0, 12, 0, 12),
            Size = UDim2New(1, -24, 1, -24),
            ZIndex = 2
        })

        New("UIListLayout", {
            Parent = ColumnsFrame,
            FillDirection = Enum.FillDirection.Horizontal,
            HorizontalFlex = Enum.UIFlexAlignment.Fill,
            VerticalFlex = Enum.UIFlexAlignment.Fill,
            Padding = UDimNew(0, 12),
            SortOrder = Enum.SortOrder.LayoutOrder
        })

        for Index = 1, Page.Columns do
            local NewColumn = New("ScrollingFrame", {
                Parent = ColumnsFrame,
                Name = "Column",
                Active = true,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Size = UDim2New(0, 100, 0, 100),
                CanvasSize = UDim2New(0, 0, 0, 0),
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                ScrollBarThickness = 0,
                ZIndex = 2
            })

            New("UIPadding", {
                Parent = NewColumn,
                PaddingBottom = UDimNew(0, 8)
            })

            New("UIListLayout", {
                Parent = NewColumn,
                Padding = UDimNew(0, 12),
                SortOrder = Enum.SortOrder.LayoutOrder
            })

            Page.ColumnsData[Index] = NewColumn
        end

        -- header tab: icon-only when inactive, expands with label when active
        local TabButton = New("TextButton", {
            Parent = TabsHolder,
            Name = "Tab",
            Text = "",
            AutoButtonColor = false,
            BackgroundColor3 = Theme["Tab Active"],
            BackgroundTransparency = 1,
            AutomaticSize = Enum.AutomaticSize.X,
            Size = UDim2New(0, 0, 0, 33),
            BorderSizePixel = 0,
            ZIndex = 2,
            LayoutOrder = #Window.Pages + 1
        })

        New("UICorner", {
            Parent = TabButton,
            CornerRadius = UDimNew(0, 8)
        })

        New("UIPadding", {
            Parent = TabButton,
            PaddingTop = UDimNew(0, 8),
            PaddingBottom = UDimNew(0, 8),
            PaddingLeft = UDimNew(0, 10),
            PaddingRight = UDimNew(0, 10)
        })

        New("UIListLayout", {
            Parent = TabButton,
            FillDirection = Enum.FillDirection.Horizontal,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDimNew(0, 7)
        })

        local TabIcon = New("ImageLabel", {
            Parent = TabButton,
            Name = "Icon",
            Image = FormatImage(Page.Icon),
            ImageColor3 = Theme["Mute"],
            BackgroundTransparency = 1,
            Size = UDim2New(0, 16, 0, 16),
            LayoutOrder = 1,
            ZIndex = 2
        })

        local TabText = New("TextLabel", {
            Parent = TabButton,
            Name = "Label",
            FontFace = FontSemiBold,
            Text = Page.Name,
            TextSize = 13,
            TextColor3 = Theme["Text"],
            Visible = false,
            BackgroundTransparency = 1,
            AutomaticSize = Enum.AutomaticSize.X,
            Size = UDim2New(0, 0, 0, 15),
            LayoutOrder = 2,
            ZIndex = 2
        })

        Page.TabIcon = TabIcon
        Page.TabButton = TabButton
        Page.Frame = PageContent

        function Page:Switch(Bool)
            Page.Active = Bool
            PageContent.Visible = Bool

            if Bool then
                TabText.Visible = true
                Tween(TabButton, { BackgroundTransparency = 0, BackgroundColor3 = Theme["Tab Active"] })
                Tween(TabIcon, { ImageColor3 = Theme["Accent"] })
                Window.CurrentPage = Page

                -- No RefreshAllVisuals here — rescanning every option on tab switch hitchs FPS.
                FadeInstance(PageContent, true, Window.FadeSpeed)
            else
                TabText.Visible = false
                Tween(TabButton, { BackgroundTransparency = 1 })
                Tween(TabIcon, { ImageColor3 = Theme["Mute"] })
            end
        end

        function Page:Select()
            if Window.CurrentPage == Page then
                return
            end

            Library:ClosePopups()

            for _, Other in ipairs(Window.Pages) do
                Other:Switch(Other == Page)
            end
        end

        TabButton.MouseButton1Down:Connect(function()
            Page:Select()
        end)

        TabButton.MouseEnter:Connect(function()
            if not Page.Active then
                Tween(TabIcon, { ImageColor3 = Theme["Dim"] })
            end
        end)

        TabButton.MouseLeave:Connect(function()
            if not Page.Active then
                Tween(TabIcon, { ImageColor3 = Theme["Mute"] })
            end
        end)

        -- ===== sections (Inline card, gradient topbar, title left + accent icon right) =====
        function Page:Section(SectionData)
            SectionData = SectionData or { }

            local Section = {
                Window = Window,
                Page = Page,

