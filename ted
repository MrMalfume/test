	local str, num, reNum = Scramble.str, Scramble.num, Scramble.reNum

	local function set(env)
		if type(env) ~= "table" then
			return
		end

		env.PP_SCRAMBLE_STR = str
		env.PP_SCRAMBLE_NUM = num
		env.PP_SCRAMBLE_RE_NUM = reNum
	end

	set(shared)
