--
-- A timing is a plain Lua table keyed by full animation URI. There is no class
-- hierarchy and no per-attack module; what the builder edits is what the AP
-- reads is what lands in the file:
--
--   ["rbxassetid://123"] = {
--       Name   = "Bandit Combo",
--       Tag    = "Heavy",
--       Hitbox = { X = 8, Y = 8, Z = 12, ZSet = 2, YSet = 0 },
--       Actions = {
--           { when = 420,  type = "Parry" },
--           { when = 780,  type = "Parry", hitbox = { X = 10, Z = 16 } },
--           { when = 1100, type = "Roll",  ihbc = true },
--       },
--   }
--
-- `when` is milliseconds from animation start to the moment that hit lands.
-- Everything else is optional. Configs written by older single-`Wait` AP scripts
-- still load: `fixAnim` synthesises a one-action list for them.

local TimingCodec = {}

-- Services.
local httpService = game:GetService("HttpService")

-- One place, always: Niph/Hunter/Config. Everything the AP reads and everything
-- the builder writes lives in that folder and nowhere else.
TimingCodec.ROOT = "Niph"
TimingCodec.GAME_DIR = "Niph/Hunter"
TimingCodec.CONFIG_DIR = "Niph/Hunter/Config"

-- Action types the scheduler understands. Roll and Dodge both route to the
-- dodge stub; they are kept distinct so the intent survives a save/load round.
TimingCodec.ACTION_TYPES = { "Parry", "Roll", "Dodge" }

-- Defaults for a hitbox the builder did not fully specify.
--
-- Deliberately generous. This box is a sanity check on "is the swing pointed at
-- me", not a measurement, and it is what every freshly logged attack inherits
-- until somebody tunes it. The old 6x8x8 was narrower than an ordinary melee
-- swing reaches, so a brand new timing would schedule its parry and then throw
-- it away at fire time for being three studs off centre.
--
-- Y is the loosest axis on purpose. Hunter fights happen on stairs, ledges and
-- slopes, and the old +/-4 stud vertical window rejected an attacker standing
-- one step below you even though the swing lands fine.
local DEFAULT_HITBOX = { X = 14, Y = 24, Z = 18, ZSet = 4, YSet = 0 }

-- Set once the old scattered config folders have been swept into CONFIG_DIR.
local migrated = false

-- .VR container format: JSON, XOR'd against a fixed keystream, then base64'd.
-- Byte-for-byte the VVV codec so a file written by either side stays readable.
local VR_KEY = "Serotonin.VVV.anim.v1"
local VR_B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

---@param data string
---@return string
local function vrB64Encode(data)
	return ((data:gsub(".", function(x)
		local r, b = "", x:byte()

		for i = 8, 1, -1 do
			r = r .. (b % 2 ^ i - b % 2 ^ (i - 1) > 0 and "1" or "0")
		end

		return r
	end) .. "0000"):gsub("%d%d%d?%d?%d?%d?", function(x)
		if #x < 6 then
			return ""
		end

		local c = 0

		for i = 1, 6 do
			c = c + (x:sub(i, i) == "1" and 2 ^ (6 - i) or 0)
		end

		return VR_B64:sub(c + 1, c + 1)
	end) .. ({ "", "==", "=" })[#data % 3 + 1])
end

---@param data string
---@return string
local function vrB64Decode(data)
	data = data:gsub("[^" .. VR_B64 .. "=]", "")

	return (data:gsub(".", function(x)
		if x == "=" then
			return ""
		end

		local r, f = "", (VR_B64:find(x) - 1)

		for i = 6, 1, -1 do
			r = r .. (f % 2 ^ i - f % 2 ^ (i - 1) > 0 and "1" or "0")
		end

		return r
	end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(x)
		if #x ~= 8 then
			return ""
		end

		local c = 0

		for i = 1, 8 do
			c = c + (x:sub(i, i) == "1" and 2 ^ (8 - i) or 0)
		end

		return string.char(c)
	end))
end

---@param s string
---@return string
local function vrXor(s)
	local out, klen = {}, #VR_KEY

	for i = 1, #s do
		out[i] = string.char(bit32.bxor(s:byte(i), VR_KEY:byte((i - 1) % klen + 1)))
	end

	return table.concat(out)
end

---Encode a table into a .VR payload.
---@param tbl table
---@return string?
function TimingCodec.encodeVR(tbl)
	local ok, json = pcall(function()
		return httpService:JSONEncode(tbl)
	end)

	if not ok or not json then
		return nil
	end

	return "VR1\n" .. vrB64Encode(vrXor(json))
end

---Decode a .VR payload.
---@param raw string
---@return table?
function TimingCodec.decodeVR(raw)
	if type(raw) ~= "string" then
		return nil
	end

	local body = raw:match("^VR1\n(.*)$") or raw

	local ok, decoded = pcall(function()
		return vrXor(vrB64Decode(body))
	end)

	if not ok or not decoded then
		return nil
	end

	local decodedOk, data = pcall(function()
		return httpService:JSONDecode(decoded)
	end)

	if decodedOk and type(data) == "table" then
		return data
	end

	return nil
end

---Read a config file. `.VR` decrypts, anything else is treated as plain JSON.
---@param path string
---@return table?
function TimingCodec.readConfig(path)
	if not (isfile and isfile(path) and readfile) then
		return nil
	end

	local ok, content = pcall(readfile, path)
	if not ok or not content then
		return nil
	end

	if path:sub(-3):lower() == ".vr" then
		return TimingCodec.decodeVR(content)
	end

	local decodedOk, data = pcall(function()
		return httpService:JSONDecode(content)
	end)

	if decodedOk and type(data) == "table" then
		return data
	end

	return nil
end

---Write a config file in whatever format its extension asks for.
---@param path string
---@param data table
---@return boolean
function TimingCodec.writeConfig(path, data)
	if not writefile then
		return false
	end

	local out

	if path:sub(-3):lower() == ".vr" then
		out = TimingCodec.encodeVR(data)
	else
		local ok, json = pcall(function()
			return httpService:JSONEncode(data)
		end)

		out = ok and json or nil
	end

	if not out then
		return false
	end

	return pcall(writefile, path, out) and true or false
end

---Do two paths point at the same file?
---@note `listfiles` hands back Windows separators (`Niph\Hunter\Config\x.VR`)
--- while every path this module builds uses forward slashes. Comparing them raw
--- makes a file look like a different file from itself, which is how the save
--- path ended up deleting what it had just written.
---@param first string?
---@param second string?
---@return boolean
function TimingCodec.samePath(first, second)
	if not first or not second then
		return false
	end

	return (first:gsub("\\", "/"):lower()) == (second:gsub("\\", "/"):lower())
end

---Extract the numeric part of an animation ID.
---@param id string?
---@return string?
function TimingCodec.numId(id)
	if not id then
		return nil
	end

	return id:match("rbxassetid://(%d+)") or id:match("^(%d+)$") or id:match("(%d+)")
end

---Normalize any animation ID spelling to the full asset URI.
---@param id string?
---@return string?
function TimingCodec.fullIdOf(id)
	local n = TimingCodec.numId(id)

	return n and ("rbxassetid://" .. n) or nil
end

---@param id string?
---@return boolean
function TimingCodec.validId(id)
	return id ~= nil and (id:match("rbxassetid://") or id:match("%d+")) ~= nil and id ~= "unknown"
end

---Fill in the missing components of a hitbox table.
---@param hb table?
---@return table
function TimingCodec.fullHitbox(hb)
	if type(hb) ~= "table" then
		return {
			X = DEFAULT_HITBOX.X,
			Y = DEFAULT_HITBOX.Y,
			Z = DEFAULT_HITBOX.Z,
			ZSet = DEFAULT_HITBOX.ZSet,
			YSet = DEFAULT_HITBOX.YSet,
		}
	end

	return {
		X = tonumber(hb.X) or DEFAULT_HITBOX.X,
		Y = tonumber(hb.Y) or DEFAULT_HITBOX.Y,
		Z = tonumber(hb.Z) or DEFAULT_HITBOX.Z,
		ZSet = tonumber(hb.ZSet) or DEFAULT_HITBOX.ZSet,
		YSet = tonumber(hb.YSet) or DEFAULT_HITBOX.YSet,
	}
end

---Resolve the box one action actually swings with.
---@note A per-action hitbox is a partial override: the keys it names win, the
--- rest fall back to the timing's own box. That keeps `{ Z = 16 }` meaning
--- "same swing, reaches further" rather than "a default-sized box".
---@param timing table
---@param action table?
---@return table
function TimingCodec.resolveHitbox(timing, action)
	local base = TimingCodec.fullHitbox(timing and timing.Hitbox)
	local over = action and action.hitbox

	if type(over) ~= "table" then
		return base
	end

	return {
		X = tonumber(over.X) or base.X,
		Y = tonumber(over.Y) or base.Y,
		Z = tonumber(over.Z) or base.Z,
		ZSet = tonumber(over.ZSet) or base.ZSet,
		YSet = tonumber(over.YSet) or base.YSet,
	}
end

---The box an action actually swings with, or nil when nobody ever authored one.
---@note `resolveHitbox` always hands back a box because the drawing code needs
--- something to build a part out of. The AP needs the opposite: "no box was set"
--- has to stay distinguishable from "a small box was set", or every timing saved
--- without touching the hitbox fields gets tested against a 6x8x8 default it was
--- never measured for and quietly never fires.
---@param timing table
---@param action table?
---@return table?
function TimingCodec.authoredHitbox(timing, action)
	local own = action and action.hitbox
	local base = timing and timing.Hitbox

	if type(own) ~= "table" and type(base) ~= "table" then
		return nil
	end

	return TimingCodec.resolveHitbox(timing, action)
end

---@param value any
---@return string
local function normalizeType(value)
	if type(value) ~= "string" then
		return "Parry"
	end

	local lowered = value:lower()

	if lowered == "roll" then
		return "Roll"
	end

	if lowered == "dodge" or lowered == "dash" then
		return "Dodge"
	end

	return "Parry"
end

---@param raw table
---@return table
local function normalizeAction(raw)
	local hitbox = raw.hitbox or raw.Hitbox

	return {
		when = tonumber(raw.when or raw.When or raw.Wait) or 0,
		type = normalizeType(raw.type or raw.Type),
		hitbox = type(hitbox) == "table" and {
			X = tonumber(hitbox.X),
			Y = tonumber(hitbox.Y),
			Z = tonumber(hitbox.Z),
			ZSet = tonumber(hitbox.ZSet),
			YSet = tonumber(hitbox.YSet),
		} or nil,
		ihbc = raw.ihbc == true or raw.IgnoreHitboxCheck == true,
		priority = tonumber(raw.priority or raw.Priority),
		repeatTimes = tonumber(raw.repeatTimes or raw.RepeatTimes),
		repeatDelay = tonumber(raw.repeatDelay or raw.RepeatDelay),
	}
end

---Normalize a timing table in place.
---@note Deliberately tolerant. Entries arrive from several generations of the
--- single-`Wait` VVV format as well as the current multi-action builder, and
--- they all have to come out the far side on the same shape.
---@param d table?
---@return table?
function TimingCodec.fixAnim(d)
	if type(d) ~= "table" then
		return d
	end

	if d.RollCancel == nil then
		d.RollCancel = d.Roll == true or d.Rolling == true
	end

	if d.HitboxWidth or d.HitboxHeight or d.HitboxRange or d.HitboxBehindRange then
		d.Hitbox = {
			X = d.HitboxWidth or 6,
			Y = d.HitboxHeight or 8,
			Z = d.HitboxRange or 8,
			ZSet = d.HitboxBehindRange or 2,
			YSet = d.HitboxYOffset or 0,
		}

		d.HitboxWidth, d.HitboxHeight = nil, nil
		d.HitboxRange, d.HitboxBehindRange, d.HitboxYOffset = nil, nil, nil
	end

	if type(d.Hitbox) == "table" then
		d.Hitbox = TimingCodec.fullHitbox(d.Hitbox)
	end

	if type(d.Delay) == "table" and #d.Delay == 2 then
		d.Wait = math.floor((d.Delay[1] + d.Delay[2]) / 2 * 1000)
	end

	if d.Distance and not d.Range then
		d.Range = d.Distance
	end

	if type(d.RepeatParry) == "table" then
		d.RepeatParryAmount = d.RepeatParry.Times or 0
		d.RepeatParryDelay = math.floor((d.RepeatParry.Delay or 0.2) * 1000)
	end

	local source = d.Actions

	if type(source) ~= "table" or #source == 0 then
		source = {
			{
				when = tonumber(d.Wait) or tonumber(d.Delay) or 0,
				type = d.RollCancel and "Roll" or "Parry",
			},
		}
	end

	local actions = {}

	for _, raw in ipairs(source) do
		if type(raw) == "table" then
			actions[#actions + 1] = normalizeAction(raw)
		end
	end

	d.Actions = actions

	---@note Kept in sync so anything still reading the legacy single-`Wait`
	--- field (older configs re-exported, external tooling) sees the first hit.
	d.Wait = actions[1] and actions[1].when or d.Wait

	return d
end

---Create Niph/Hunter/Config if it is not there yet.
function TimingCodec.mkdirs()
	if not (isfolder and makefolder) then
		return
	end

	for _, folder in ipairs({
		TimingCodec.ROOT,
		TimingCodec.GAME_DIR,
		TimingCodec.CONFIG_DIR,
	}) do
		if not isfolder(folder) then
			makefolder(folder)
		end
	end
end

---Pull timings written by an earlier layout into Niph/Hunter/Config.
---@note Saves used to be scattered across `<root>/<GameId>/Config` for four
--- different roots. Everything now lives in one folder, so the old locations are
--- swept once on startup rather than being read forever.
local function migrateLegacy()
	if not (isfolder and listfiles and readfile and writefile) then
		return
	end

	local gameId = tostring(game.GameId)

	for _, root in ipairs({ "Niph", "Suit", "VVV", "Veyra" }) do
		local stale = root .. "/" .. gameId
		local dir = stale .. "/Config"

		if isfolder(dir) then
			local ok, listed = pcall(listfiles, dir)

			if ok and listed then
				for _, path in ipairs(listed) do
					local name = path:match("([^/\\]+)$")
					local target = name and (TimingCodec.CONFIG_DIR .. "/" .. name)

					if target and not (isfile and isfile(target)) then
						local read, content = pcall(readfile, path)

						if read and content then
							pcall(writefile, target, content)
						end
					end
				end
			end
		end

		---@note Removed rather than left in place. Leaving them means four extra
		--- folders on disk that look like they still matter and a save that could
		--- land back in one of them.
		if isfolder(stale) and typeof(delfolder) == "function" then
			pcall(delfolder, stale)
		end
	end
end

---Every readable config path in Niph/Hunter/Config.
---@return string[]
function TimingCodec.collectPaths()
	local paths = {}

	TimingCodec.mkdirs()

	if not migrated then
		migrated = true
		pcall(migrateLegacy)
	end

	if not (isfolder and isfolder(TimingCodec.CONFIG_DIR) and listfiles) then
		return paths
	end

	local ok, listed = pcall(listfiles, TimingCodec.CONFIG_DIR)
	if not ok or not listed then
		return paths
	end

	for _, path in ipairs(listed) do
		local ext = path:match("%.([%w]+)$")
		ext = ext and ext:lower()

		if ext == "json" or ext == "js" or ext == "vr" then
			paths[#paths + 1] = path
		end
	end

	---@note Sorted so load order and save target are the same on every run.
	--- `listfiles` order is executor-defined, and with it the "which file holds
	--- this id" answer could change between sessions.
	table.sort(paths)

	return paths
end

---The one file an animation belongs in.
---@note Name plus the numeric id. One animation per file is what the folder is
--- supposed to look like, and the id is what makes the filename unique — naming
--- by animation name alone put every clip the game calls "Imported Animation
--- Clip" into a single shared file.
---@param fid string
---@param name string?
---@return string
function TimingCodec.pathFor(fid, name)
	local label = (type(name) == "string" and name ~= "") and name or "logged"
	local sanitized = label:gsub("[^%w%s%-]", ""):gsub("%s+", "_")

	if sanitized == "" then
		sanitized = "logged"
	end

	return TimingCodec.CONFIG_DIR .. "/" .. sanitized .. "_" .. (TimingCodec.numId(fid) or "0") .. ".VR"
end

---Give every animation its own file, once, on startup.
---@note Files written before the one-per-file rule can hold several animations,
--- and splitting them is what makes the folder readable: a filename tells you
--- what is in it, and deleting a timing is deleting a file.
function TimingCodec.splitBundles()
	local bundles = {}

	for _, path in ipairs(TimingCodec.collectPaths()) do
		local data = TimingCodec.readConfig(path)

		if data then
			local onlyId, entries = nil, 0

			for animId in pairs(data) do
				onlyId = animId
				entries += 1
			end

			---@note A single-entry file already sitting at its canonical path is
			--- left alone, so this settles after one pass and costs nothing but
			--- the listing on later runs.
			local single = entries == 1 and type(data[onlyId]) == "table" and data[onlyId] or nil
			local canonical = single ~= nil
				and TimingCodec.samePath(path, TimingCodec.pathFor(TimingCodec.fullIdOf(onlyId) or onlyId, single.Name))

			if entries > 0 and not canonical then
				bundles[#bundles + 1] = { path = path, data = data }
			end
		end
	end

	for _, bundle in ipairs(bundles) do
		local moved = true
		local wroteOver = false

		for animId, entry in pairs(bundle.data) do
			local fid = TimingCodec.validId(animId) and TimingCodec.fullIdOf(animId) or nil

			if fid and type(entry) == "table" then
				local target = TimingCodec.pathFor(fid, entry.Name)

				if TimingCodec.samePath(target, bundle.path) then
					wroteOver = true
				end

				if not TimingCodec.writeConfig(target, { [fid] = entry }) then
					moved = false
				end
			end
		end

		---@note Never delete a path one of the writes just landed on. The
		--- canonical check above should already have excluded it, but a delete
		--- that races its own write destroys user data, so it is worth refusing
		--- twice rather than trusting one comparison.
		if moved and not wroteOver and type(delfile) == "function" then
			pcall(delfile, bundle.path)
		end
	end
end

---Which file already holds this ID, so an edit updates it in place.
---@param fid string
---@return string?
function TimingCodec.findExistingFileForId(fid)
	for _, path in ipairs(TimingCodec.collectPaths()) do
		local data = TimingCodec.readConfig(path)

		if data then
			for storedId in pairs(data) do
