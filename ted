local function hopServer( PreferRange)
    pcall(function()
        local url = "https://games.roblox.com/v1/games/"
            .. tostring(game.GameId)
            .. "/servers/Public?sortOrder=Asc&limit=100"
        local data = HttpService:JSONDecode(game:HttpGet(url))
        local best, bestScore
        for _, s in ipairs(data.data or {}) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                local playing = s.playing or 0
                local score = playing
                if PreferRange then
                    if playing < state.cfg.hopMinPlayers then
                        score = score - 100
                    elseif playing > state.cfg.hopMaxPlayers then
                        score = score - 50
                    else
                        score = score + 20
                    end
                end
                if not bestScore or score > bestScore then
                    best, bestScore = s, score
                end
            end
        end
        if best then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, best.id, LP)
        end
    end)
end

