local BELOW_FLING_HEIGHT = 8

local function belowFarmCFrame(pos, lookAt)
	if (lookAt - pos).Magnitude < 0.01 then
		return CFrame.new(pos) * CFrame.Angles(math.pi * 0.5, 0, 0)
	end
	return CFrame.new(pos, lookAt)
end

local function applyBelowFarmPose(h, thrp, farmPrefix, targetModel)
	local hrp = root()
	if not hrp or not thrp then
		return
	end
	local cf = calcBelowFarmCF(thrp, farmPrefix, targetModel)
	pcall(function()
		faceLock(h, true)
		hrp.CFrame = cf
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end)
end

local function calcBelowFarmCF(targetHRP, prefix, targetModel)
	local model = targetModel or state.lockTarget
	local mp = targetHRP.Position
	local ox = state.cfg[prefix .. "OffX"] or 0
	local oy = state.cfg[prefix .. "OffY"] or 0
	local oz = state.cfg[prefix .. "OffZ"] or 6.5

	local ignore = { LP.Character }
	if model then
		table.insert(ignore, model)
	end

	local debugId = model and model:GetDebugId() or nil
	if state.belowAnchor and state.belowAnchor.debugId ~= debugId then
		state.belowAnchor = nil
	end

	local ground = getGroundPosition(mp, ignore)
	local playerHalf = standingHeight()
	local buryY = ground.Y - oz - playerHalf + oy
	local flung = (mp.Y - ground.Y) > BELOW_FLING_HEIGHT

	if not state.belowAnchor then
		state.belowAnchor = {
			debugId = debugId,
			x = mp.X,
			y = buryY,
			z = mp.Z,
		}
	elseif not flung then
		state.belowAnchor.x = mp.X
		state.belowAnchor.y = buryY
		state.belowAnchor.z = mp.Z
	end

	local anchor = state.belowAnchor
	local pos = Vector3.new(anchor.x + ox, anchor.y, anchor.z)
	local lookAt = Vector3.new(mp.X, mp.Y + 1.5, mp.Z)
	return belowFarmCFrame(pos, lookAt)
end

local function calcGroundFarmCF(targetHRP, prefix, targetModel)
	local model = targetModel or state.lockTarget
	local mp = targetHRP.Position
	local ox = state.cfg[prefix .. "OffX"] or 0
	local oy = state.cfg[prefix .. "OffY"] or 0
	local oz = state.cfg[prefix .. "OffZ"] or 6.5
	local mode = getFarmMode(prefix)

	local ignore = { LP.Character }
	if model then
		table.insert(ignore, model)
	end

	local ground = getGroundPosition(mp, ignore)
	local standY = ground.Y + standingHeight() + oy

	local flatLook = Vector3.new(targetHRP.CFrame.LookVector.X, 0, targetHRP.CFrame.LookVector.Z)
	if flatLook.Magnitude < 0.01 then
		flatLook = Vector3.new(0, 0, -1)
	else
		flatLook = flatLook.Unit
	end
	local flatRight = flatLook:Cross(Vector3.yAxis)
	if flatRight.Magnitude < 0.01 then
		flatRight = Vector3.new(1, 0, 0)
	else
		flatRight = flatRight.Unit
	end

	local horizontal
	if mode == "Front" or mode == "In Front" or mode == "Above" then
		horizontal = flatLook * oz
	else
		horizontal = -flatLook * oz
	end

	local pos = Vector3.new(mp.X, standY, mp.Z) + horizontal + (flatRight * ox)
	local lookAt = Vector3.new(mp.X, mp.Y + 1.5, mp.Z)
	return CFrame.lookAt(pos, lookAt)
end

local function calcFarmCF(targetHRP, prefix, targetModel)
	if not targetHRP then
		return nil
	end

	prefix = prefix or (state.lockFarmGroup or "boss")
	local model = targetModel or state.lockTarget
	local mode = getFarmMode(prefix)

	if mode == "Below" then
		return calcBelowFarmCF(targetHRP, prefix, model)
	end

	if prefix == "quest" or isHumanoidNpc(model) then
		return calcGroundFarmCF(targetHRP, prefix, model)
	end

	local mp = targetHRP.Position
	local ox = state.cfg[prefix .. "OffX"] or 0
	local oy = state.cfg[prefix .. "OffY"] or 0
	local oz = state.cfg[prefix .. "OffZ"] or 6.5
	local base
	if mode == "Above" then
		base = Vector3.new(mp.X, mp.Y + oz, mp.Z)
	elseif mode == "Front" or mode == "In Front" then
		base = mp + targetHRP.CFrame.LookVector * oz
	else
		base = mp - targetHRP.CFrame.LookVector * oz
	end
	local pos = base + Vector3.new(ox, oy, 0)
	return CFrame.lookAt(pos, targetHRP.Position)
end



