                    end
                end)

                RealSlider.MouseEnter:Connect(function()
                    Tween(RealSlider, { BackgroundColor3 = Library:GetLighterColor(Theme["Element"], 1.45) })
                end)

                RealSlider.MouseLeave:Connect(function()
                    Tween(RealSlider, { BackgroundColor3 = Theme["Element"] })
                end)

                function Slider:Set(Value, SkipCallback)
                    Slider.Value = Library:Round(math.clamp(Value, Slider.Min, Slider.Max), Slider.Decimals)
                    Library.Flags[Slider.Flag] = Slider.Value

                    Tween(Accent, {
                        Size = UDim2New((Slider.Value - Slider.Min) / (Slider.Max - Slider.Min), 0, 1, 0)
                    }, 0.21, Enum.EasingStyle.Quart)

                    ValueLabel.Text = string.format("%s%s", tostring(Slider.Value), Slider.Suffix)

                    if not SkipCallback then
                        Library:SafeCall(Slider.Callback, Slider.Value)
                    end
                end

                function Slider:Get()
                    return Slider.Value
                end

                function Slider:SetVisibility(Bool)
