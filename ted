local function matchesQuery(entry, fid, q)
q = (q or ""):gsub("^%s+", ""):gsub("%s+$", ""):lower()
if q == "" then return true end
if (entry.Name or ""):lower():find(q, 1, true) then return true end
if (entry.modelName or ""):lower():find(q, 1, true) then return true end
if (fid or ""):lower():find(q, 1, true) then return true end
local n = numId(fid)
return n and n:find(q, 1, true)
end
local function ensureEntryHb(entry)
