                    Dropdown.Options = { }
                    Dropdown.Items = NewItems

                    for _, Option in ipairs(NewItems) do
                        Dropdown:AddOption(Option)
                    end

                    if Dropdown.Multi then
                        if type(previousValue) == "table" and #previousValue > 0 then
                            Dropdown:Set(previousValue, true)
                        else
                            Dropdown.Value = { }
                            UpdateValueText()
                        end
                    elseif previousValue and Dropdown.Options[previousValue] then
