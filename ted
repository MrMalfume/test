			InfoLogger.refresh()
		end
	end)

	maid:mark(runService.Heartbeat:Connect(function()
		if not Configuration.expectToggleValue("ShowLoggerWindow") then
			table.clear(pendingQueue)
			return
		end

		local nextJob = pendingQueue[#pendingQueue]
		if nextJob then
			pendingQueue[#pendingQueue] = nil
			nextJob()
		end
	end))

	InfoLogger.refresh()
