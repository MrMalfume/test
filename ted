local ADVANCE_TIMEOUT = 12.0

-- Cached dialogue frame.
local cachedFrame = nil

-- Whether an advance loop is already running.
local advancing = false

-- Click throttle.
local lastClick = 0

---Resolve the DialogueChoice remote.
---@return RemoteEvent?
local function getChoiceRemote()
	local dialogueSystem = replicatedStorage:FindFirstChild("DialogueSystem")
	local choice = dialogueSystem and dialogueSystem:FindFirstChild("DialogueChoice")

	if choice and choice:IsA("RemoteEvent") then
		return choice
	end

	return nil
end

---Find the live dialogue frame in the player GUI.
---@return GuiObject?
local function findDialogueFrame()
	if cachedFrame and cachedFrame.Parent then
		return cachedFrame
	end

	cachedFrame = nil

	local localPlayer = players.LocalPlayer
	local playerGui = localPlayer and localPlayer:FindFirstChild("PlayerGui")
	if not playerGui then
		return nil
	end

	for _, descendant in next, playerGui:GetDescendants() do
		if not descendant:IsA("GuiObject") then
			continue
		end

		if not table.find(DIALOGUE_NAMES, descendant.Name) then
			continue
		end

		cachedFrame = descendant

		return descendant
	end

	return nil
