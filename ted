        Parent = Toast,
        Name = "ProgressTrack",
        LayoutOrder = 2,
        BackgroundColor3 = Theme["Element"],
        Size = UDim2New(1, 0, 0, 3),
        BorderSizePixel = 0,
        ZIndex = 90
    })

    Library:ApplyTheme(ProgressTrack, { BackgroundColor3 = "Element" })

    local ProgressFill = New("Frame", {
        Parent = ProgressTrack,
        Name = "ProgressFill",
        BackgroundColor3 = Theme["Accent"],
        Size = UDim2New(1, 0, 1, 0),
        BorderSizePixel = 0,
        ZIndex = 91
    })

    Library:ApplyTheme(ProgressFill, { BackgroundColor3 = "Accent" })

    New("UICorner", {
        Parent = ProgressTrack,
        CornerRadius = UDimNew(0, 5)
    })

    New("UICorner", {
        Parent = ProgressFill,
        CornerRadius = UDimNew(0, 5)
    })

    Library:Thread(function()
        FadeInstance(Toast, true, 0.2)

        local Start = os.clock()
        local Duration = Notification.Duration

        while Toast.Parent and (os.clock() - Start) < Duration do
            local Remaining = Duration - (os.clock() - Start)
            ProgressFill.Size = UDim2New(math.clamp(Remaining / Duration, 0, 1), 0, 1, 0)
            task.wait(0.05)
        end

        local FadeOut = FadeInstance(Toast, false, 0.25)
        if FadeOut then
            FadeOut.Completed:Wait()
        end

        Toast:Destroy()
    end)

    return Notification
end

