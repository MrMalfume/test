function InfoLogger.record(defenderType, key, name, distance, source)
	if not InfoLogger.shouldLog(defenderType, key) then
		return false
	end

	local minDistance = Configuration.expectOptionValue("MinimumLoggerDistance") or 0
	local maxDistance = Configuration.expectOptionValue("MaximumLoggerDistance") or 500
	distance = distance or 0

	if distance < minDistance or distance > maxDistance then
		return false
	end

	Library:AddMissEntry(defenderType, key, name, distance, source)
	return true
end

