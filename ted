---@module Utility.Filesystem
local Filesystem = __DARKLUA_BUNDLE_MODULES.E()

---@module Utility.Signal
local Signal = __DARKLUA_BUNDLE_MODULES.m()

---@module Utility.Logger
local Logger = __DARKLUA_BUNDLE_MODULES.g()

---@module Utility.JSON
local JSON = __DARKLUA_BUNDLE_MODULES.ax()

---@module Utility.Maid
local Maid = __DARKLUA_BUNDLE_MODULES.n()

-- Services.
local replicatedStorage = game:GetService("ReplicatedStorage")
local runService = game:GetService("RunService")
local players = game:GetService("Players")

-- Maids.
local teleportMaid = Maid.new()

-- Storage. Only usable when the executor exposes a filesystem.
local storage = Filesystem.new("Niph-Hunter")
local hasFilesystem = typeof(isfolder) == "function"
	and typeof(isfile) == "function"
	and typeof(readfile) == "function"
	and typeof(writefile) == "function"

-- Constants.
local WAYPOINT_FILE = "waypoints.json"
local ARRIVAL_DISTANCE = 4.0

-- Saved waypoints keyed by name.
local waypoints = {}

-- Active travel state.
local travel = nil

---Read the local root part.
---@return BasePart?
local function getRootPart()
	local localPlayer = players.LocalPlayer
	local character = localPlayer and localPlayer.Character

	return character and character:FindFirstChild("HumanoidRootPart")
end

---Persist the waypoint table.
local function saveWaypoints()
	if not hasFilesystem then
		return
	end

	local success, result = pcall(function()
		storage:write(WAYPOINT_FILE, JSON.encode(waypoints))
	end)

	if not success then
		Logger.warn("(%s) Failed to save Hunter waypoints.", tostring(result))
	end
end

---Load the waypoint table from disk.
local function loadWaypoints()
	if not hasFilesystem then
		return
	end

	local success, result = pcall(function()
		if not storage:file(WAYPOINT_FILE) then
			return {}
		end

		return JSON.decode(storage:read(WAYPOINT_FILE))
	end)

	if not success or type(result) ~= "table" then
		return
	end

	waypoints = result
end

---Convert a stored waypoint entry into a CFrame.
---@param entry table
---@return CFrame?
local function entryToCFrame(entry)
	if type(entry) ~= "table" or #entry < 3 then
		return nil
	end

	return CFrame.new(entry[1], entry[2], entry[3])
end

---List every saved waypoint name.
---@return string[]
function Teleport.names()
	local names = {}

	for name in next, waypoints do
		names[#names + 1] = name
	end

	table.sort(names)

	return names
end

---Save the current position as a waypoint.
---@param name string
---@return boolean
function Teleport.save(name)
	if type(name) ~= "string" or #name == 0 then
		return false
	end

	local rootPart = getRootPart()
	if not rootPart then
		return false
	end

	local position = rootPart.Position
	waypoints[name] = { position.X, position.Y, position.Z, Teleport.currentArea }

	saveWaypoints()

	return true
end

---Delete a saved waypoint.
---@param name string
---@return boolean
function Teleport.delete(name)
	if not waypoints[name] then
		return false
	end

	waypoints[name] = nil
	saveWaypoints()

	return true
end

---Get a saved waypoint as a CFrame.
---@param name string
---@return CFrame?
function Teleport.get(name)
	return entryToCFrame(waypoints[name])
end

---Stop any in-progress travel.
function Teleport.stop()
	travel = nil
end

---Travel to a CFrame. Uses stepped movement unless instant mode is enabled.
---@param goal CFrame
---@return boolean
function Teleport.to(goal)
	if typeof(goal) ~= "CFrame" then
		return false
	end

	local rootPart = getRootPart()
	if not rootPart then
		return false
	end

	if Configuration.expectToggleValue("TeleportInstant") then
		rootPart.CFrame = goal
		travel = nil

		return true
	end

	travel = { goal = goal }

	return true
end

---Travel to a player.
---@param player Player
---@return boolean
function Teleport.toPlayer(player)
	local character = player and player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return false
	end

	local offset = Configuration.expectOptionValue("TeleportPlayerOffset") or 6

	return Teleport.to(rootPart.CFrame * CFrame.new(0, 0, offset))
end

---Travel to a saved waypoint.
---@param name string
---@return boolean
function Teleport.toWaypoint(name)
	local goal = Teleport.get(name)
	if not goal then
		return false
	end

	return Teleport.to(goal)
end

---Step the active travel.
---@param deltaTime number
local function updateTravel(deltaTime)
	if not travel then
		return
	end

	local rootPart = getRootPart()
	if not rootPart then
		travel = nil
		return
	end

	local position = rootPart.Position
	local target = travel.goal.Position
	local delta = target - position
	local distance = delta.Magnitude

	if distance <= ARRIVAL_DISTANCE then
		rootPart.CFrame = travel.goal
		travel = nil

		return
	end

	local step = (Configuration.expectOptionValue("TeleportStudsPerSecond") or 200) * deltaTime

	if distance <= step then
		rootPart.CFrame = travel.goal
		travel = nil

		return
	end

	rootPart.CFrame = CFrame.new(position + delta.Unit * step, target)
	rootPart.AssemblyLinearVelocity = Vector3.zero
end

---Track the current area name.
---@param area any
local function onAreaChanged(area)
	if type(area) == "string" then
		Teleport.currentArea = area
	elseif typeof(area) == "Instance" then
		Teleport.currentArea = area.Name
	end

	if type(Teleport.listener) == "function" then
		Teleport.listener(Teleport.currentArea)
	end
end

---Initialize teleport.
function Teleport.init()
	loadWaypoints()

	local heartbeat = Signal.new(runService.Heartbeat)
	teleportMaid:add(heartbeat:connect("Teleport_Heartbeat", updateTravel))

	local areaSystem = replicatedStorage:FindFirstChild("AreaSystem")
	local areaChanged = areaSystem and areaSystem:FindFirstChild("AreaChanged")

	if areaChanged and areaChanged:IsA("RemoteEvent") then
		local areaSignal = Signal.new(areaChanged.OnClientEvent)
		teleportMaid:add(areaSignal:connect("Teleport_AreaChanged", onAreaChanged))
	end

	Logger.warn("Teleport initialized.")
end

---Detach teleport.
function Teleport.detach()
	teleportMaid:clean()

	travel = nil
	Teleport.listener = nil

	Logger.warn("Teleport detached.")
end

-- Return Teleport module.
return Teleport
end function __DARKLUA_BUNDLE_MODULES.bL():typeof(__modImpl())local v=__DARKLUA_BUNDLE_MODULES.cache.bL if not v then v={c=__modImpl()}__DARKLUA_BUNDLE_MODULES.cache.bL=v end return v.c end end do local function __modImpl()-- Roster module. Who else is in the server.
--
-- Both the spectate picker and the travel-to-player picker need the same list,
-- and both used to carry their own identical copy of it. Neither is a natural
-- owner of the other's list, so it lives here with Hunter's other game-layer
-- helpers instead.

local Roster = {}

-- Services.
local players = game:GetService("Players")

---Every other player's name, sorted.
---@return string[]
function Roster.names()
	local localPlayer = players.LocalPlayer
	local names = {}

	for _, player in next, players:GetPlayers() do
		if player == localPlayer then
			continue
		end

		names[#names + 1] = player.Name
	end

	table.sort(names)

	return names
end

---Every other player that currently has a spawned character.
---@return Player[]
function Roster.loaded()
	local localPlayer = players.LocalPlayer
	local targets = {}

	for _, player in next, players:GetPlayers() do
		if player == localPlayer then
			continue
		end

		local character = player.Character

		if character and character:FindFirstChild("HumanoidRootPart") then
			targets[#targets + 1] = player
		end
	end

	return targets
end

-- Return Roster module.
return Roster
