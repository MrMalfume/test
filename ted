	-- Weight of a new sample in the moving average. Low enough to swallow single
	-- frame spikes, high enough to follow a genuine route change within a second.
	SMOOTHING = 0.08,
}

-- Services.
local statsService = game:GetService("Stats")

---@note Short TTL rather than a Heartbeat frame counter. A counter needs a live
--- connection for a module that is otherwise stateless, and it would keep
--- running after detach; `Data Ping` does not update fast enough for the
--- difference to matter.
local SAMPLE_TTL = 1 / 120

-- Sample cache so hot paths don't walk Stats more than once per frame.
local cachedRtt = 0
local cachedAt = -math.huge

-- Smoothed round-trip time. Seeded on the first real sample.
local smoothedRtt = nil

---@note: This used to rely on GetNetworkPing which we assumed was the sending or
--- at least receiving delay. That is incorrect — it is RakNet ping, i.e. RTT.
---@return number
local readRtt = LPH_NO_VIRTUALIZE(function()
	local network = statsService:FindFirstChild("Network")
	if not network then
		return 0
	end

	local serverStatsItem = network:FindFirstChild("ServerStatsItem")
	if not serverStatsItem then
		return 0
	end

	local dataPingItem = serverStatsItem:FindFirstChild("Data Ping")
	if not dataPingItem then
		return 0
	end

	return dataPingItem:GetValue() / 1000
end)

---Get raw data ping (round-trip time in seconds).
---@note: https://devforum.roblox.com/t/in-depth-information-about-robloxs-remoteevents-instance-replication-and-physics-replication-w-sources/1847340
---@note: The forum post is misleading. This is the RTT and it also folds in
--- frame time, so it is always an over-estimate of pure network latency.
---@return number
