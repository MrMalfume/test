function Library:ClosePopups(Exception)
    for _, Popup in ipairs(Library.Popups) do
        if Popup ~= Exception and Popup.IsOpen then
            Popup:SetOpen(false)
        end
    end
end

Library:Connect(UserInputService.InputBegan, function(Input)
    if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    -- Defer so trigger/option clicks run before we decide to close the popup.
    task.defer(function()
        if Library.PopupSuppressClose then
            return
        end

        for _, Popup in ipairs(Library.Popups) do
            if not Popup.IsOpen then
                continue
            end

            if Library:IsMouseOver(Popup.Frame, 2) then
                continue
            end

            local OverTrigger = false
            for _, TriggerItem in ipairs(Popup.Triggers or { }) do
                if Library:IsMouseOver(TriggerItem, 2) then
                    OverTrigger = true
                    break
                end
            end

            if not OverTrigger then
                Popup:SetOpen(false)
            end
        end
    end)
end)

-- Kiwisense-styled popup container: Background base, border stroke, drop shadow.
local function CreatePopup(Data)
    local Popup = {
        IsOpen = false,
        Triggers = Data.Triggers or { },
        Follow = Data.Follow,
        Offset = Data.Offset or Vector2New(0, 5),
        MatchWidth = Data.MatchWidth,
        Detach = Data.Detach, -- draggable windows detach from their trigger after opening
        OnOpen = Data.OnOpen,
        OnClose = Data.OnClose
    }

    Popup.Frame = New("Frame", {
        Parent = Overlay,
        Name = "Popup",
        BackgroundColor3 = Data.Inline and Theme["Inline"] or Theme["Background"],
        Visible = false,
        AutomaticSize = Data.AutomaticSize or Enum.AutomaticSize.None,
        Size = Data.Size or UDim2New(0, 180, 0, 0),
        BorderSizePixel = 0,
        ZIndex = 101
    })

    Library:ApplyTheme(Popup.Frame, { BackgroundColor3 = Data.Inline and "Inline" or "Background" })

    New("UICorner", {
        Parent = Popup.Frame,
        CornerRadius = UDimNew(0, 5)
    })

    BorderStroke(Popup.Frame)

    if Data.Shadow then
        DropShadow(Popup.Frame)
    end

    if Data.Inline then
        DarkGradient(Popup.Frame)
    end

    local FollowConnection

    function Popup:UpdatePosition()
        if not Popup.Follow then
            return
        end

        local Position = Popup.Follow.AbsolutePosition
        local Size = Popup.Follow.AbsoluteSize

        Popup.Frame.Position = UDim2New(0, Position.X + Popup.Offset.X, 0, Position.Y + Size.Y + Popup.Offset.Y)

        if Popup.MatchWidth then
            Popup.Frame.Size = UDim2New(0, Size.X, Popup.Frame.Size.Y.Scale, Popup.Frame.Size.Y.Offset)
        end
    end

    function Popup:SetOpen(Bool)
        if Popup.IsOpen == Bool then
            return
        end

        Popup.IsOpen = Bool

        if Bool then
            Library:ClosePopups(Popup)
            Popup:UpdatePosition()

            Popup.Frame.Visible = true
            FadeInstance(Popup.Frame, true, 0.16)

            if Popup.Follow and not Popup.Detach then
                FollowConnection = RunService.RenderStepped:Connect(function()
                    Popup:UpdatePosition()
                end)
            end

            if Popup.OnOpen then
                Popup.OnOpen()
            end
        else
            if FollowConnection then
                FollowConnection:Disconnect()
                FollowConnection = nil
            end

            local FadeOut = FadeInstance(Popup.Frame, false, 0.14)
            if FadeOut then
                FadeOut.Completed:Once(function()
                    if not Popup.IsOpen then
                        Popup.Frame.Visible = false
                    end
                end)
            end

            if Popup.OnClose then
                Popup.OnClose()
            end
        end
    end

    Library:RegisterPopup(Popup)
    return Popup
end

-- // Key parsing + display names (accept "RightShift", "K", "MOUSE2", etc.)
local KeyNames = {
    [Enum.UserInputType.MouseButton1] = "MOUSE1",
    [Enum.UserInputType.MouseButton2] = "MOUSE2",
    [Enum.UserInputType.MouseButton3] = "MOUSE3",

    [Enum.KeyCode.LeftShift] = "LeftShift",
    [Enum.KeyCode.RightShift] = "RightShift",
    [Enum.KeyCode.LeftControl] = "LeftControl",
    [Enum.KeyCode.RightControl] = "RightControl",
    [Enum.KeyCode.LeftAlt] = "LeftAlt",
    [Enum.KeyCode.RightAlt] = "RightAlt",
    [Enum.KeyCode.CapsLock] = "Caps",
    [Enum.KeyCode.Backspace] = "Back",
    [Enum.KeyCode.Return] = "Enter",
    [Enum.KeyCode.Escape] = "Escape",
    [Enum.KeyCode.Space] = "Space",
    [Enum.KeyCode.PageUp] = "PageUp",
    [Enum.KeyCode.PageDown] = "PageDown",
    [Enum.KeyCode.Insert] = "Insert",
    [Enum.KeyCode.Delete] = "Delete",
    [Enum.KeyCode.Home] = "Home",
    [Enum.KeyCode.End] = "End"
}

local MouseKeyAliases = {
    ["MOUSE1"] = Enum.UserInputType.MouseButton1,
    ["MOUSE2"] = Enum.UserInputType.MouseButton2,
    ["MOUSE3"] = Enum.UserInputType.MouseButton3,
    ["MB1"] = Enum.UserInputType.MouseButton1,
    ["MB2"] = Enum.UserInputType.MouseButton2,
    ["MB3"] = Enum.UserInputType.MouseButton3,
    ["MouseButton1"] = Enum.UserInputType.MouseButton1,
    ["MouseButton2"] = Enum.UserInputType.MouseButton2,
    ["MouseButton3"] = Enum.UserInputType.MouseButton3
}

local function ParseKey(Key)
    if Key == nil then
        return nil
    end

    if typeof(Key) == "EnumItem" then
        return Key
    end

    if type(Key) ~= "string" then
        return Key
    end

    local Trimmed = string.gsub(Key, "^%s*(.-)%s*$", "%1")
    local Lower = string.lower(Trimmed)

    -- Unbound sentinels used by configs / KeybindPolicy (never treat as a real key).
    if Trimmed == "" or Lower == "none" or Lower == "n/a" or Lower == "na" or Lower == "nil" or Lower == "unbound" then
        return nil
    end

    local Alias = MouseKeyAliases[Trimmed] or MouseKeyAliases[string.upper(Trimmed)]
    if Alias then
        return Alias
    end

    local Ok, KeyCode = pcall(function()
        return Enum.KeyCode[Trimmed]
    end)

    if Ok and typeof(KeyCode) == "EnumItem" then
        return KeyCode
    end

    for _, Item in Enum.KeyCode:GetEnumItems() do
        if string.lower(Item.Name) == Lower then
            return Item
        end
    end

    return nil
end

local function GetKeyName(Key)
    if Key == nil then
        return "N/A"
    end

    Key = ParseKey(Key) or Key

    if Key == nil then
        return "N/A"
    end

    if KeyNames[Key] then
        return KeyNames[Key]
    end

    if typeof(Key) == "EnumItem" then
        return Key.Name
    end

    return tostring(Key)
end

local function GetInputKeyName(Input)
    if Input.KeyCode and Input.KeyCode ~= Enum.KeyCode.Unknown then
        return GetKeyName(Input.KeyCode)
    end

    if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.MouseButton2
        or Input.UserInputType == Enum.UserInputType.MouseButton3 then
        return GetKeyName(Input.UserInputType)
    end

    return nil
end

local function KeybindMatchesInput(ToggleKey, Input)
    local InputKey = GetInputKeyName(Input)
    return InputKey ~= nil and InputKey == GetKeyName(ToggleKey)
end

function Library:ParseKey(Key)
    return ParseKey(Key)
end

function Library:GetKeyName(Key)
    return GetKeyName(Key)
end

