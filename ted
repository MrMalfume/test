		local lowHealth = self.humanoid.Health <= self.humanoid.MaxHealth * 0.35
		setBar(self.healthBar, self.humanoid.Health, self.humanoid.MaxHealth, lowHealth and HEALTH_LOW_COLOR or HEALTH_COLOR)
