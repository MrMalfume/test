local MAX_ELEMENTS = 400

-- Live elements keyed by model.
local elements = {}
local elementCount = 0
local warnedLimit = false

-- Reused settings snapshot so we do not allocate per frame.
local settings = {}

---Resolve the tracer origin in screen space.
---@param camera Camera
---@param mode string
---@return Vector2
local function getTracerOrigin(camera, mode)
	local viewport = camera.ViewportSize

	if mode == "Mouse" then
		local mouse = userInputService:GetMouseLocation()
		local inset = guiService:GetGuiInset()
		return Vector2.new(mouse.X, mouse.Y - inset.Y)
	end

	if mode == "Top" then
		return Vector2.new(viewport.X * 0.5, 0)
	end

	if mode == "Center" then
		return Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
	end

	return Vector2.new(viewport.X * 0.5, viewport.Y)
end

---Snapshot the flag state once per frame.
---@param camera Camera
---@param origin Vector3
local function refreshSettings(camera, origin)
	settings.camera = camera
	settings.origin = origin
	settings.maxDistance = Configuration.expectOptionValue("EspMaxDistance") or 1000
	settings.fontSize = Configuration.expectOptionValue("EspFontSize") or 14

	settings.showName = Configuration.expectToggleValue("EspShowName")
	settings.showDistance = Configuration.expectToggleValue("EspShowDistance")
	settings.showHealth = Configuration.expectToggleValue("EspShowHealth")
	settings.showBars = Configuration.expectToggleValue("EspShowHealthBar")
	settings.showPosture = Configuration.expectToggleValue("EspShowPosture")
	settings.showStamina = Configuration.expectToggleValue("EspShowStamina")
	settings.showLives = Configuration.expectToggleValue("EspShowLives")
	settings.showMeditating = Configuration.expectToggleValue("EspShowMeditating")
	settings.showDead = Configuration.expectToggleValue("EspShowDead")

	settings.box = Configuration.expectToggleValue("EspBox")
	settings.boxThickness = Configuration.expectOptionValue("EspBoxThickness") or 1
	settings.tracer = Configuration.expectToggleValue("EspTracer")
	settings.tracerThickness = Configuration.expectOptionValue("EspTracerThickness") or 1
	settings.tracerOrigin = getTracerOrigin(camera, Configuration.expectOptionValue("EspTracerOrigin") or "Bottom")

	settings.highlight = Configuration.expectToggleValue("EspHighlight")
	settings.highlightFillTransparency = Configuration.expectOptionValue("EspHighlightTransparency") or 0.65

	settings.teamColors = Configuration.expectToggleValue("EspTeamColors")
	settings.friendColors = Configuration.expectToggleValue("EspFriendColors")
	settings.playerColor = Configuration.expectOptionValue("EspPlayerColor") or Color3.fromRGB(120, 190, 255)
	settings.mobColor = Configuration.expectOptionValue("EspMobColor") or Color3.fromRGB(255, 145, 120)
	settings.friendColor = Configuration.expectOptionValue("EspFriendColor") or Color3.fromRGB(140, 255, 160)
end

---Drop an element.
---@param model Model
local function removeElement(model)
	local element = elements[model]
	if not element then
		return
	end

	element:detach()

	elements[model] = nil
	elementCount = elementCount - 1
end

---Drop every element.
local function clearElements()
	for model in next, elements do
		removeElement(model)
	end

	elementCount = 0
	warnedLimit = false
end

---Hide every element without destroying it.
local function hideElements()
	for _, element in next, elements do
		element:visible(false)
	end
end

---Create (or fetch) the element for a model.
---@param model Model
---@return EntityEsp?
local function ensureElement(model)
	local existing = elements[model]
	if existing then
		return existing
	end

	if elementCount >= MAX_ELEMENTS then
		if not warnedLimit then
			warnedLimit = true
			Logger.longNotify("ESP element cap reached (%i). Lower your max distance.", MAX_ELEMENTS)
		end

		return nil
	end

	local player = players:GetPlayerFromCharacter(model)
	local element = EntityEsp.new(model, player and "Player" or "Mob", player)

	elements[model] = element
	elementCount = elementCount + 1

	return element
end

---Whether this model should have an element right now.
---@param model Instance
---@param localCharacter Model?
---@return boolean, Player?
local function shouldTrack(model, localCharacter)
	if not model:IsA("Model") or model == localCharacter then
		return false
	end

	local player = players:GetPlayerFromCharacter(model)

	if player then
		return Configuration.expectToggleValue("EspPlayers") == true, player
	end

	return Configuration.expectToggleValue("EspMobs") == true, nil
end

---Update every element.
local function updateEsp()
	if not Configuration.expectToggleValue("EspEnabled") then
		if elementCount > 0 then
			clearElements()
		end

		return
	end

	local alive = workspace:FindFirstChild(ALIVE_FOLDER)
	if not alive then
		return hideElements()
	end

	local camera = workspace.CurrentCamera
	local localPlayer = players.LocalPlayer
	local localCharacter = localPlayer and localPlayer.Character
	local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")

	if not camera or not localRoot then
		return hideElements()
	end

	refreshSettings(camera, localRoot.Position)

	for _, model in next, alive:GetChildren() do
		local tracked = shouldTrack(model, localCharacter)

		if tracked then
			local element = ensureElement(model)

			if element and not element:update(settings) then
				removeElement(model)
			end
		elseif elements[model] then
			removeElement(model)
		end
	end

	for model in next, elements do
		if not model.Parent or model.Parent ~= alive then
			removeElement(model)
		end
	end
end

---Force every element to rebuild (used when toggling player/mob filters).
function Esp.refresh()
	clearElements()
end

---Initialize ESP.
function Esp.init()
	local preRender = Signal.new(runService.PreRender)
	espMaid:add(preRender:connect("Esp_PreRender", updateEsp))

	local playerRemoving = Signal.new(players.PlayerRemoving)
	espMaid:add(playerRemoving:connect("Esp_PlayerRemoving", function(player)
		for model, element in next, elements do
			if element.player == player then
				removeElement(model)
			end
		end
	end))

	Logger.warn("ESP initialized.")
end

---Detach ESP.
function Esp.detach()
	espMaid:clean()
	clearElements()

	Logger.warn("ESP detached.")
end

-- Return Esp module.
return Esp
