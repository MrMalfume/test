    end
    local clean = txt:gsub("^Defeat%s+", ""):gsub("%(s%)", ""):gsub("%s+$", "")
    if clean ~= "" and (name == clean or string.find(name, clean, 1, true) or string.find(clean, name, 1, true)) then
