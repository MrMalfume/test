			local statNames = {
				"Agility",
				"Strength",
				"Fortitude",
				"Intelligence",
				"Willpower",
				"Charisma",
				"ElementBlood",
				"ElementFire",
				"ElementIce",
				"ElementLightning",
				"ElementWind",
				"ElementShadow",
				"ElementMetal",
				"WeaponHeavy",
				"WeaponMedium",
				"WeaponLight",
