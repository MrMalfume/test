local function logAnim(model, track, animData)
if not logEnabled or observerPaused then return end
if not logSelf and model == lp.Character then return end
local anim = track and track.Animation
local animId = anim and anim.AnimationId
local fid = animId and fullIdOf(animId)
if not fid then return end
if isBlacklisted(fid) then return end  -- never log blacklisted animations
local mr = myRoot()
local root = rootOf(model)
-- when we're dead/respawning we have no root to measure from — don't let that
-- silently drop logs; only apply the range filter when we actually have a root
if mr and root then
	local dist = (mr.Position - root.Position).Magnitude
	if dist > logRange then return end
end
local dist = (mr and root) and (mr.Position - root.Position).Magnitude or 0
local trackKey = tostring(track)
if activePlayIds[trackKey] then return end
activePlayIds[trackKey] = fid
local existing = LoggedAnims[fid]
local isNew = existing == nil
if existing then
	existing.count = (existing.count or 0) + 1
	existing.lastSeen = os.clock()
	existing.srcModel = model
	if root then existing.range = math.round(dist) end
else
	local hb = nil
	if animData and animData.Hitbox then
		hb = normalizeHb(animData.Hitbox)
	else
		hb = pullApHitbox(fid)
	end
	if not hb then
		hb = normalizeHb(nil)
	end
	local resolvedName = getAnimName(track, model, true)  -- sync, exactly like v5's recordAnimation
	LoggedAnims[fid] = {
		animId = fid, Name = resolvedName, modelName = model.Name, srcModel = model,
		waitMs = nil, hb = hb, range = math.round(dist), rollCancel = false, grow = true,
		count = 1, lastSeen = os.clock(),
	}
	logOrder[#logOrder + 1] = fid
end
local stopConn
stopConn = track.Stopped:Connect(function()
	activePlayIds[trackKey] = nil; disc(stopConn)
end)
-- New row: append it at the bottom without disturbing existing rows.
-- Replay of an already-logged animation: just bump its ×count badge in place.
-- Neither path rebuilds the whole list, so logged rows never move.
if isNew then
	task.defer(function()
		if not appendRow(fid) then
			xpcall(rebuildList, function(err) warn("[AnimLogger] rebuildList failed: "..tostring(err)) end)
		end
	end)
else
	task.defer(function()
		if not updateRowCount(fid) then
			xpcall(rebuildList, function(err) warn("[AnimLogger] rebuildList failed: "..tostring(err)) end)
		end
	end)
end
end

hookModelForLog = function(model)
if not model or not model:IsA("Model") then return end
if not logSelf and model == lp.Character then return end
if hookedModels[model] then return end
-- Claim the slot SYNCHRONOUSLY before any WaitForChild yield. Without this,
-- multiple observer paths (rescan, ChildAdded, respawn handler, heartbeat) all
-- spawn hookModelForLog for the same model on a respawn; they each pass the
-- guard above, yield at WaitForChild, then every one creates its own bucket —
-- leaving orphaned AnimationPlayed connections. After a few deaths this piles
-- up and logging gets wedged. A placeholder reserves the model immediately.
hookedModels[model] = true
local humanoid = model:FindFirstChildOfClass("Humanoid") or model:WaitForChild("Humanoid", 5)
if not humanoid then hookedModels[model] = nil return end
if not (model:FindFirstChild("HumanoidRootPart") or model:WaitForChild("HumanoidRootPart", 5)) then
	hookedModels[model] = nil return
end
local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 5)
if not animator or not model:IsDescendantOf(workspace) then hookedModels[model] = nil return end
-- if the model died/left while we were yielding, abandon
if hookedModels[model] ~= true then return end  -- someone else finished first
local bucket = {}
bucket[#bucket + 1] = animator.AnimationPlayed:Connect(function(track) logAnim(model, track) end)
local ok, playing = pcall(function() return animator:GetPlayingAnimationTracks() end)
if ok and playing then for _, track in ipairs(playing) do logAnim(model, track) end end
bucket[#bucket + 1] = model.AncestryChanged:Connect(function(_, parent)
	if not parent or not parent:IsDescendantOf(workspace) then
		hookedModels[model] = nil
		for _, c in ipairs(bucket) do disc(c) end
		table.clear(bucket)
	end
end)
hookedModels[model] = bucket
end

