-- // Helpers
local function New(Class, Properties)
    local Item = Instance.new(Class)

    for Property, Value in pairs(Properties) do
        if Property ~= "Parent" then
            Item[Property] = Value
        end
    end

    Item.Parent = Properties.Parent
    return Item
end

local function Tween(Item, Goal, Time, Style, Direction)
    local NewTween = TweenService:Create(
        Item,
        TweenInfo.new(Time or Library.Tween.Time, Style or Library.Tween.Style, Direction or Library.Tween.Direction),
        Goal
    )

    NewTween:Play()
    return NewTween
end

function Library:Connect(Signal, Callback)
    local Connection = Signal:Connect(Callback)
    table.insert(Library.Connections, Connection)

    return Connection
end

function Library:Thread(Function)
    local Thread = task.spawn(Function)
    table.insert(Library.Threads, Thread)

    return Thread
end

function Library:SafeCall(Function, ...)
    if not Function then
        return
    end

    local Success, Result = pcall(Function, ...)

    if not Success then
        warn("[Reptillion] callback error: " .. tostring(Result))
    end
end

function Library:NextFlag()
    Library.UnnamedFlags += 1
    return "UnnamedFlag_" .. tostring(Library.UnnamedFlags)
end

function Library:Round(Number, Decimals)
    local Scale = 10 ^ (Decimals or 0)
    return math.floor(Number * Scale + 0.5) / Scale
end

function Library:GetLighterColor(Color, Increment)
    Increment = Increment or 1.45
    return FromRGB(
        math.clamp(Color.R * 255 * Increment, 0, 255),
        math.clamp(Color.G * 255 * Increment, 0, 255),
        math.clamp(Color.B * 255 * Increment, 0, 255)
    )
end

-- the signature kiwisense surface gradient (84deg, white -> dark grey)
local function DarkGradient(Parent, Rotation)
    return New("UIGradient", {
        Parent = Parent,
        Rotation = Rotation or 84,
        Color = RGBSequence{
            RGBSequenceKeypoint(0, FromRGB(255, 255, 255)),
            RGBSequenceKeypoint(1, Theme["Dark Gradient"])
        }
    })
end

