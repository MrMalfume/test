local SCAN_INTERVAL = 0.35

-- Discovered prompts and per-prompt cooldowns.
local prompts = {}
local cooldowns = {}

-- Scan accumulator.
local scanAccumulator = 0

-- Whether we are mid-collection.
local collecting = false

---Whether the instance name looks like a chest.
---@param name string
---@return boolean
local function looksLikeChest(name)
	local lowered = string.lower(name)

	for _, pattern in next, CHEST_PATTERNS do
		if string.find(lowered, pattern, 1, true) then
			return true
		end
	end

	return false
end

---Whether a prompt belongs to a chest.
---@param prompt ProximityPrompt
---@return boolean
local function isChestPrompt(prompt)
	if Configuration.expectToggleValue("ChestFarmAnyPrompt") then
		return true
	end

	if looksLikeChest(prompt.Name) or looksLikeChest(prompt.ObjectText or "") then
		return true
	end

	local ancestor = prompt.Parent

	for _ = 1, 3 do
		if not ancestor or ancestor == workspace then
			return false
		end

		if looksLikeChest(ancestor.Name) then
			return true
		end

		ancestor = ancestor.Parent
	end

	return false
end

---Track a prompt if it qualifies.
---@param instance Instance
local function trackPrompt(instance)
	if not instance:IsA("ProximityPrompt") then
		return
	end

	prompts[instance] = true
end

---Position of a prompt's adornee.
---@param prompt ProximityPrompt
---@return Vector3?
local function getPromptPosition(prompt)
	local parent = prompt.Parent
	if not parent then
		return nil
	end

	if parent:IsA("BasePart") then
		return parent.Position
	end

	if parent:IsA("Model") then
		return parent:GetPivot().Position
	end

	if parent:IsA("Attachment") then
		return parent.WorldPosition
	end

	return nil
end

---Whether it is safe to grab loot right now.
---@param position Vector3
---@return boolean
local function isSafe(position)
	if not Configuration.expectToggleValue("ChestFarmSafety") then
		return true
	end

	local localPlayer = players.LocalPlayer
	local character = localPlayer and localPlayer.Character
	local aliveData = character and character:FindFirstChild("AliveData")
	local combat = aliveData and aliveData:FindFirstChild("Combat")
	local combatTag = combat and combat:FindFirstChild("CombatTag")

	if combatTag and combatTag.Value > 0 then
		return false
	end

	local safeRadius = Configuration.expectOptionValue("ChestFarmSafetyRadius") or 60

	for _, player in next, players:GetPlayers() do
		if player == localPlayer then
			continue
		end

		local otherCharacter = player.Character
		local otherRoot = otherCharacter and otherCharacter:FindFirstChild("HumanoidRootPart")

		if otherRoot and (otherRoot.Position - position).Magnitude <= safeRadius then
			return false
		end
	end

	return true
end

---Fire the game's chest remote as a fallback.
---@param prompt ProximityPrompt
local function fireChestRemote(prompt)
	if not Configuration.expectToggleValue("ChestFarmUseRemote") then
		return
	end

	local remote = replicatedStorage:FindFirstChild("LootChestRemote")
	if not remote or not remote:IsA("RemoteEvent") then
		return
	end

	local model = prompt:FindFirstAncestorOfClass("Model") or prompt.Parent

	pcall(function()
		remote:FireServer(model)
	end)
end

---Collect a single chest.
---@param prompt ProximityPrompt
---@param position Vector3
local function collect(prompt, position)
