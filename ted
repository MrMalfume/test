---Build a single L-bracket corner for the bounding box.
---@param parent Frame
---@param corner string
---@param length number
---@param thickness number
---@param color Color3
---@return Frame
EntityESP.corner = LPH_NO_VIRTUALIZE(function(parent, corner, length, thickness, color)
	local holder = Instance.new("Frame")
	holder.Name = "Corner_" .. corner
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.new(0, length, 0, length)
	holder.ZIndex = 5
	holder.Parent = parent

	local function bar(name, size, position, anchor)
		local shadow = Instance.new("Frame")
		shadow.Name = name .. "_Shadow"
		shadow.BorderSizePixel = 0
		shadow.BackgroundColor3 = Color3.new(0, 0, 0)
		shadow.BackgroundTransparency = 0.35
		shadow.Size = size
		shadow.Position = position
		shadow.AnchorPoint = anchor or Vector2.new(0, 0)
		shadow.ZIndex = 5
		shadow.Parent = holder

		local fill = Instance.new("Frame")
		fill.Name = name
		fill.BorderSizePixel = 0
		fill.BackgroundColor3 = color
		fill.Size = UDim2.new(1, -2, 1, -2)
		fill.Position = UDim2.new(0, 1, 0, 1)
		fill.ZIndex = 6
		fill.Parent = shadow

		return fill
	end

	if corner == "tl" then
		holder.AnchorPoint = Vector2.new(0, 0)
		holder.Position = UDim2.new(0, 0, 0, 0)
		bar("H", UDim2.new(1, 0, 0, thickness), UDim2.new(0, 0, 0, 0))
		bar("V", UDim2.new(0, thickness, 1, 0), UDim2.new(0, 0, 0, 0))
	elseif corner == "tr" then
		holder.AnchorPoint = Vector2.new(1, 0)
		holder.Position = UDim2.new(1, 0, 0, 0)
		bar("H", UDim2.new(1, 0, 0, thickness), UDim2.new(1, 0, 0, 0), Vector2.new(1, 0))
		bar("V", UDim2.new(0, thickness, 1, 0), UDim2.new(1, 0, 0, 0), Vector2.new(1, 0))
	elseif corner == "bl" then
		holder.AnchorPoint = Vector2.new(0, 1)
		holder.Position = UDim2.new(0, 0, 1, 0)
		bar("H", UDim2.new(1, 0, 0, thickness), UDim2.new(0, 0, 1, 0), Vector2.new(0, 1))
		bar("V", UDim2.new(0, thickness, 1, 0), UDim2.new(0, 0, 1, 0), Vector2.new(0, 1))
	else
		holder.AnchorPoint = Vector2.new(1, 1)
		holder.Position = UDim2.new(1, 0, 1, 0)
		bar("H", UDim2.new(1, 0, 0, thickness), UDim2.new(1, 0, 1, 0), Vector2.new(1, 1))
		bar("V", UDim2.new(0, thickness, 1, 0), UDim2.new(1, 0, 1, 0), Vector2.new(1, 1))
	end

	return holder
end)

---Tint bounding box pieces to the active ESP color.
---@param self EntityESP
---@param color Color3
EntityESP.tintBox = LPH_NO_VIRTUALIZE(function(self, color)
	if self.boxStroke then
		self.boxStroke.Color = color
	end

	if self.boxFill then
		self.boxFill.BackgroundColor3 = color
	end

	if not self.corners then
		return
	end

	for _, holder in next, self.corners do
		for _, shadow in next, holder:GetChildren() do
			local fill = shadow:FindFirstChild("H") or shadow:FindFirstChild("V")
			if fill and fill:IsA("Frame") then
				fill.BackgroundColor3 = color
			end
		end
	end
