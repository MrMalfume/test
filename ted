	if not opts.enabled or not folder or not opts.origin then
		return 0
	end

	local finished = 0
	local maxRange = opts.maxRange or 80
	local maxRangeSq = maxRange * maxRange

	for _, child in ipairs(folder:GetChildren()) do
		if not (opts.isGone and opts.isGone(child)) then
			local hrp = child:FindFirstChild("HumanoidRootPart")
			if hrp then
				local delta = hrp.Position - opts.origin
