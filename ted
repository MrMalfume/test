---Initialize AutoParry.
function AutoParry.init()
	local respawning = false

	local characterAdded = Signal.new(playersService.LocalPlayer.CharacterAdded)

	apMaid:mark(characterAdded:connect("AutoParry_CharacterAdded", function(character)
		character:WaitForChild("HumanoidRootPart", 10)

		table.clear(trackedModels)
		table.clear(friendCache)

		if not enabled then
			return
		end

		respawning = true

		AutoParry.setEnabled(false)
		task.wait(0.1)
		AutoParry.setEnabled(true)

		respawning = false
	end))

	---@note The toggle callback is the fast path, but a saved config restored at
	--- startup does not always replay callbacks. Converging on the flag itself
	--- means the switch in the menu is the only thing that can be out of date.
	local idle = Signal.new(runService.Heartbeat)

	apMaid:mark(idle:connect("AutoParry_FlagWatch", function()
		if not respawning then
			AutoParry.setEnabled(flag("VvvApEnabled", false))
		end
	end))

	Logger.warn("AutoParry initialized.")
end

