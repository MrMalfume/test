---pick whichever of our clocks produces a plausible elapsed time for the state's
---own duration. Falls back to os.clock() when nothing lines up.
---@param startedAt number
---@param duration number
---@return number elapsed
local elapsedSince = LPH_NO_VIRTUALIZE(function(startedAt, duration)
	local ceiling = math.max(duration, 1) * 4
	local best = nil

	for _, now in next, { os.clock(), tick(), os.time(), workspace.DistributedGameTime } do
		local elapsed = now - startedAt

		if elapsed < 0 or elapsed > ceiling then
			continue
		end

		if best and elapsed >= best then
			continue
		end

		best = elapsed
	end

	return best or 0
end)

