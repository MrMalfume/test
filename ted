		Name = "Filter Label",
		Flag = id(identifier, "FilterLabel"),
		Placeholder = "Partial or exact object label.",
	})

	filterChild:Dropdown({
		Name = "Filter List Type",
		Flag = id(identifier, "FilterLabelListType"),
		Default = "Hide Labels Out Of List",
		Items = { "Hide Labels Out Of List", "Hide Labels In List" },
	})

	filterChild:Button({
		Name = "Add Name To Filter",
		Callback = function()
			local filterLabelValue = filterLabel:Get()

			if #filterLabelValue <= 0 then
				return Logger.notify("Please enter a valid filter name.")
			end

			local values = filterLabelList.Items

			if not table.find(values, filterLabelValue) then
				table.insert(values, filterLabelValue)
			end

			filterLabelList:Refresh(values)
		end,
	})

	filterChild:Button({
		Name = "Remove Selected Names",
		Callback = function()
			local values = filterLabelList.Items
			local selected = filterLabelList:Get()

			for _, name in ipairs(selected) do
				local index = table.find(values, name)
				if not index then
					continue
				end

				table.remove(values, index)
			end

			filterLabelList:Refresh(values)
		end,
	})

	return identifier, group
end

