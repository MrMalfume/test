-- // Theme registration (accent recoloring)
function Library:RegisterThemeRefresh(Callback)
    table.insert(self.ThemeRefresh, Callback)
end

function Library:ApplyTheme(Item, Properties)
    table.insert(Library.ThemeItems, { Item = Item, Properties = Properties })

    for Property, ThemeKey in pairs(Properties) do
        Item[Property] = Theme[ThemeKey]
    end
end

function Library:ChangeTheme(ThemeKey, Color)
    if typeof(Color) ~= "Color3" then
        return
    end

    Theme[ThemeKey] = Color

    for Index = #Library.ThemeItems, 1, -1 do
        local Entry = Library.ThemeItems[Index]

        if not Entry.Item or not Entry.Item.Parent then
            table.remove(Library.ThemeItems, Index)
            continue
        end

        for Property, Key in pairs(Entry.Properties) do
            if Key == ThemeKey then
                Entry.Item[Property] = Color
            end
        end
    end

    Library:RefreshThemeUI()
end

function Library:RefreshThemeUI()
    local Accent = Theme["Accent"]

    if Library.WindowInstance then
        for _, Page in ipairs(Library.WindowInstance.Pages) do
            if Page.Active and Page.TabIcon then
                Page.TabIcon.ImageColor3 = Accent
            end
        end
    end

    for _, Option in pairs(Library.Options) do
        if Option.RefreshTheme then
            pcall(Option.RefreshTheme, Option)
        end
    end

    for _, Callback in ipairs(Library.ThemeRefresh) do
        pcall(Callback)
    end
end

function Library:RefreshAccentUI()
    for _, Option in pairs(Library.Options) do
        if Option.RefreshTheme then
            pcall(Option.RefreshTheme, Option)
        elseif Option.RefreshAccent then
            pcall(Option.RefreshAccent, Option, Theme["Accent"])
        end
    end
end

function Library:RefreshAllVisuals()
    for _, Option in pairs(Library.Options) do
        if Option.RefreshVisual then
            pcall(Option.RefreshVisual, Option)
        elseif Option.Set and Option.Value ~= nil then
            pcall(Option.Set, Option, Option.Value, true)
        end
    end

    Library:RefreshThemeUI()
end

