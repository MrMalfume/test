	for index, entry in ipairs(data.MissingDataEntries) do
		if entry.Label then
			entry.Label.Parent = entry.Type == cycle and Library.InfoLoggerContainer or nil
			entry.Label.LayoutOrder = index
		end
	end

	if Library.InfoLoggerLabel then
		Library.InfoLoggerLabel.Text = string.format("Info Logger (%s)", cycle)
	end

	local height = 0
	local width = 0

	for _, entry in ipairs(data.MissingDataEntries) do
		local label = entry.Label
		if not label or not label.Parent then
			continue
		end

		height += label.TextBounds.Y + 2
		width = math.max(width, label.TextBounds.X)
	end

	width += 20
	height += 22

	if Library.InfoLoggerFrame then
		Library.InfoLoggerFrame.Size = UDim2.fromOffset(
			math.clamp(width, 210, 800),
			math.clamp(height, 24, 180)
		)
	end
end

