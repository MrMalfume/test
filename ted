	if advancing then
		return
	end

	advancing = true

	local deadline = os.clock() + ADVANCE_TIMEOUT
	local interval = Configuration.expectOptionValue("AutoTalkInterval") or 0.25

	repeat
		sendChoice()
		task.wait(interval)
	until os.clock() >= deadline
		or not Configuration.expectToggleValue("AutoTalkEnabled")
		or not isDialogueOpen()

	advancing = false
