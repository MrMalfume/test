local InspectAssets = {}

-- Services.
local players = game:GetService("Players")

---Extract asset ids from a string.
---@param value string
---@return string[]
local function extractAssetIds(value)
	local assetIds = {}

	if not value or type(value) ~= "string" then
		return assetIds
	end

	for assetId in string.gmatch(value, "Asset:(%d+)") do
		table.insert(assetIds, assetId)
	end

	for assetId in string.gmatch(value, "rbxassetid://(%d+)") do
		table.insert(assetIds, assetId)
	end

	return assetIds
end

---Collect asset ids from an instance.
---@param instance Instance
---@param collected table<string, boolean>
local function collectFromInstance(instance, collected)
	local properties = { "MeshId", "TextureID", "Texture", "Image", "Value" }

	for _, property in ipairs(properties) do
		local success, value = pcall(function()
			return instance[property]
		end)

		if success and type(value) == "string" then
			for _, assetId in ipairs(extractAssetIds(value)) do
				collected[assetId] = true
			end
		end
	end

	for _, child in ipairs(instance:GetChildren()) do
		if child.ClassName == "SpecialMesh" or child.ClassName == "Mesh" then
			local success, meshId = pcall(function()
				return child.MeshId
			end)

			if success and type(meshId) == "string" then
				for _, assetId in ipairs(extractAssetIds(meshId)) do
					collected[assetId] = true
				end
			end
		end
	end

	local success, serialized = pcall(function()
		return tostring(instance)
	end)

	if success and type(serialized) == "string" then
		for _, assetId in ipairs(extractAssetIds(serialized)) do
			collected[assetId] = true
		end
	end
end

---Inspect hair-related descendants on a character.
---@param character Model
---@return string[]
local function inspectCharacter(character)
	local collected = {}

	for _, descendant in ipairs(character:GetDescendants()) do
		local name = (descendant.Name and tostring(descendant.Name) or ""):lower()
		local isHair = name:match("hair") or name:match("wig") or name:match("bang")

		if type(descendant.IsA) == "function" then
			local success, isAccessory = pcall(function()
				return descendant:IsA("Accessory")
			end)

			if success and isAccessory then
				isHair = true
			end
		end

		if isHair then
			collectFromInstance(descendant, collected)
		end
	end

	local head = character:FindFirstChild("Head")
	if head then
		for _, child in ipairs(head:GetChildren()) do
			if child.ClassName == "SpecialMesh" or child.ClassName == "Mesh" or (child.Name and child.Name:lower():match("hair")) then
				collectFromInstance(child, collected)
			end
		end
	end

	local assetIds = {}
	for assetId in pairs(collected) do
		table.insert(assetIds, assetId)
	end

	table.sort(assetIds)
	return assetIds
end

---Inspect the local player's hair asset ids.
---@return string[]
function InspectAssets.inspectLocalPlayer()
	local localPlayer = players.LocalPlayer
	if not localPlayer then
		return {}
	end

	local character = localPlayer.Character
	if not character and localPlayer.CharacterAdded then
		character = localPlayer.CharacterAdded:Wait()
	end

	if not character then
		return {}
	end

	return inspectCharacter(character)
end

---Inspect a player's hair asset ids by username.
---@param playerName string
---@return string[]
function InspectAssets.inspectPlayerByName(playerName)
	if not playerName or type(playerName) ~= "string" or playerName == "" then
		return {}
	end

	local targetPlayer = nil
	for _, player in ipairs(players:GetPlayers()) do
		if player.Name:lower() == playerName:lower() then
			targetPlayer = player
			break
		end
	end

	if not targetPlayer then
		warn("Player '" .. playerName .. "' not found")
		return {}
	end

