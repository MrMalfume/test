	local character = getCharacter()
	if not character then
		return
	end

	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end

	if flag("GbNoAnims") or flag("GbAnimSpeedEnabled") then
		updateAnimations(character)
	end

	if flag("GbAutoRespawn") and hum.Health <= 0 then
		tryRespawn()
	end

	if flag("GbAutoRetreat") then
		local threshold = option("GbRetreatHp", 25)
		if hum.Health > 0 and hum.Health <= threshold and savedPosition then
			local root = character:FindFirstChild("HumanoidRootPart")
			if root then
				root.CFrame = savedPosition
			end
		end
	end
end

