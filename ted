	local handler = character:FindFirstChild("CharacterHandler")
	if not handler then
		return nil
	end

	local remotes = handler:FindFirstChild("Remotes")
	if not remotes then
		return nil
	end

	local remote = remotes:FindFirstChild("ControllerRemote")
	if not remote or not remote:IsA("RemoteEvent") then
		return nil
	end

	cachedRemote = remote

	return remote
end)

