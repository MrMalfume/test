        BorderSizePixel = 0,
        ZIndex = 80
    })

    Library:ApplyTheme(Frame, { BackgroundColor3 = "Background" })

    MakeDraggable(Frame)

    New("UICorner", {
        Parent = Frame,
        CornerRadius = UDimNew(0, 5)
    })

    DarkGradient(Frame)

    local LogoImage = New("ImageLabel", {
        Parent = Frame,
        Name = "Logo",
        Image = FormatImage(Logo),
        ImageColor3 = Theme["Accent"],
        ScaleType = Enum.ScaleType.Fit,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2New(0, 0.5),
        Position = UDim2New(0, 7, 0.5, 0),
        Size = UDim2New(0, 22, 0, 22),
        ZIndex = 81
    })

    Library:ApplyTheme(LogoImage, { ImageColor3 = "Accent" })

    local TextLabel = New("TextLabel", {
        Parent = Frame,
        Name = "Text",
        FontFace = LibraryFont,
        Text = Text,
        TextSize = 14,
        TextColor3 = Theme["Text"],
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2New(0, 0.5),
        Position = UDim2New(0, 35, 0.5, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2New(0, 0, 0, 15),
        ZIndex = 81
    })

    New("UIPadding", {
        Parent = Frame,
        PaddingRight = UDimNew(0, 7)
    })

    -- live fps / ping suffix
    local BaseText = Text
    local FrameCount, LastUpdate = 0, os.clock()

    Library:Connect(RunService.Heartbeat, function()
        if not Frame.Visible then
            return
        end

        FrameCount += 1

        local Now = os.clock()
        if Now - LastUpdate < 0.5 then
            return
        end

        local FPS = math.floor(FrameCount / (Now - LastUpdate) + 0.5)

        local Ping = 0
        pcall(function()
            Ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
        end)

        TextLabel.Text = string.format("%s | %d fps | %d ms", BaseText, FPS, Ping)

        FrameCount = 0
        LastUpdate = Now
    end)

    function Watermark:SetVisibility(Bool)
        Frame.Visible = Bool
    end

    function Watermark:SetText(NewText)
        BaseText = NewText
        TextLabel.Text = NewText
    end

    function Watermark:SetLogo(ImageId)
        LogoImage.Image = FormatImage(ImageId)
    end

    return Watermark
end

