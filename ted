---Resolve the color for this entity.
---@param self EntityEsp
---@param settings table
---@return Color3
EntityEsp.color = LPH_NO_VIRTUALIZE(function(self, settings)
	if self.kind ~= "Player" then
		return settings.mobColor
	end

	local player = self.player
	if not player then
		return settings.playerColor
	end

	if settings.friendColors and player:IsFriendsWith(playersService.LocalPlayer.UserId) then
		return settings.friendColor
	end

	if settings.teamColors and player.Team then
		return player.TeamColor.Color
	end

	return settings.playerColor
end)

