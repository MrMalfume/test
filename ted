	local notifyItemsList = section:Dropdown({
		Name = "Item List",
		Flag = "NotifyItemsList",
		Items = {},
		Multi = true,
		Default = {},
	})
	local itemLabel = section:Textbox({
		Name = "Item Name",
		Flag = "NotifyItemsLabel",
		Placeholder = "Partial or exact item name.",
	})
	local addNameButton = section:Button({
		Name = "Add Name To Filter",
		Callback = function()
			local itemLabelValue = itemLabel:Get()

			if #itemLabelValue <= 0 then
				return Logger.notify("Please enter a valid item name.")
			end

			local values = notifyItemsList.Items

			if not table.find(values, itemLabelValue) then
				table.insert(values, itemLabelValue)
			end

			notifyItemsList:Refresh(values)
		end,
	})
	local removeNameButton = section:Button({
		Name = "Remove Selected Names",
		Callback = function()
			local values = notifyItemsList.Items
			local selected = notifyItemsList:Get()

			for _, name in ipairs(selected) do
				local index = table.find(values, name)
				if not index then
					continue
				end

				table.remove(values, index)
			end

			notifyItemsList:Refresh(values)
		end,
	})

	section:Toggle({ Name = "Spectate List", Flag = "PlayerSpectating", Default = true })
	section:Toggle({ Name = "Steal Build", Flag = "BuildStealer", Default = false })
