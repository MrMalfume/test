local function getChi()
    local n
    pcall(function()
        local main = LP.PlayerGui:FindFirstChild("Main")
        local label = main
            and (
                (main:FindFirstChild("ingame") and main.ingame:FindFirstChild("Bar") and main.ingame.Bar:FindFirstChild("cha"))
                or (main:FindFirstChild("ingamearena") and main.ingamearena:FindFirstChild("Bar") and main.ingamearena.Bar:FindFirstChild("cha"))
            )
        if label and label.Text then
            local t = label.Text
            local a, b = t:match("CHI:%s*(%d+)%s*/%s*(%d+)")
            if a and b then
                n = tonumber(a)
            else
                n = tonumber(t:match("CHI:%s*(%d+)")) or tonumber(t:match("(%d+)"))
            end
        end
    end)
    return n or 0
end

