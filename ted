for _, ch in markerHolder:GetChildren() do ch:Destroy() end
local e = selectedFid and LoggedAnims[selectedFid]
if not e or not e.actions then return end
local len = previewTrack and previewTrack.Length or 0
if len <= 0 then return end
for i, a in ipairs(e.actions) do
	local pct = math.clamp((a.when or 0) / 1000 / len, 0, 1)
	new("Frame", {
		BackgroundColor3 = (selActionIdx == i) and T("Accent") or T("Text"),
		BackgroundTransparency = (selActionIdx == i) and 0 or 0.35,
		BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(pct, 0, 0, -3), Size = UDim2.fromOffset(2, 13),
		ZIndex = 305, Parent = markerHolder,
	})
end
end

