--
-- Every entity in workspace.Alive carries an `AliveData` folder:
--
--   <model>.AliveData.TempValue     Folder; each CHILD folder is an ACTIVE state.
--                                   Presence is the signal. Timed states carry
--                                   `StartedAt` and `Duration` attributes.
--   <model>.AliveData.Combat        NumberValues: ComboValue, ComboTimer,
--                                   CombatTag, Stamina, MaxStamina, Posture,
--                                   ParryNumber.
--   <model>.AliveData.Information   LivesLeft (NumberValue), Meditating (BoolValue).
--   <model>.AliveData.Buffs         SpeedBuff, DefenseBuff, TaiBuff, JutsuBuff,
--                                   WeaponBuff, StaminaDrain, PVEbuff.
--
-- Reads only. Nothing here hooks a metamethod — Hunter kicks for that.

local StateCache = {}

---@module Utility.Logger
local Logger = __DARKLUA_BUNDLE_MODULES.g()

-- Known state folder names, kept for menus and validation. Presence in this
-- list is not required to query a state.
StateCache.STATES = {
	"Parry",
	"ParryCooldown",
	"ParryAttackBlocker",
	"ParryLanded",
	"Parried",
	"GotParried",
	"ParryActionLock",
	"Stun",
	"EndLag",
	"Cancel",
	"CanFeint",
	"LA",
	"Dashing",
	"NoRun",
	"JUMPCD",
	"SPRINTCD",
	"HeavyCD",
	"TrueSlow",
	"GS",
	"NenPressure",
	"Meditating",
	"InDialogue",
}

-- Cache the AliveData sub-folders per model so a hot-path `has()` is a single
-- FindFirstChild instead of four.
local folderCache = setmetatable({}, { __mode = "k" })

---Resolve one AliveData sub-folder for a model, caching the result.
---@param model Model?
---@param branch "TempValue"|"Combat"|"Information"|"Buffs"
---@return Instance?
local resolve = LPH_NO_VIRTUALIZE(function(model, branch)
	if not model or typeof(model) ~= "Instance" then
		return nil
	end

	local cached = folderCache[model]
	local hit = cached and cached[branch]

	if hit and hit.Parent then
		return hit
	end

	local aliveData = model:FindFirstChild("AliveData")
	if not aliveData then
		return nil
	end

	local folder = aliveData:FindFirstChild(branch)
	if not folder then
		return nil
	end

	if not cached then
		cached = {}
		folderCache[model] = cached
	end

	cached[branch] = folder

	return folder
end)

