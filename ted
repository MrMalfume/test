local VvvTimingCodec = {}

---@module Game.Timings.AnimationTiming
local AnimationTiming = __DARKLUA_BUNDLE_MODULES.s()

---@module Utility.Scramble
local Scramble = __DARKLUA_BUNDLE_MODULES.a()

local HttpService = game:GetService("HttpService")

local VR_KEY = "Serotonin.VVV.anim.v1"
local VR_B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

VvvTimingCodec.CONFIG_ROOTS = { "Niph", "Suit", "VVV", "Veyra" }
VvvTimingCodec.PRIMARY_ROOT = "Niph"

local function vrB64Encode(data)
	return ((data:gsub(".", function(x)
		local r, b = "", x:byte()
		for i = 8, 1, -1 do
			r = r .. (b % 2 ^ i - b % 2 ^ (i - 1) > 0 and "1" or "0")
		end
		return r
	end) .. "0000"):gsub("%d%d%d?%d?%d?%d?", function(x)
		if #x < 6 then
			return ""
		end
		local c = 0
		for i = 1, 6 do
			c = c + (x:sub(i, i) == "1" and 2 ^ (6 - i) or 0)
		end
		return VR_B64:sub(c + 1, c + 1)
	end) .. ({ "", "==", "=" })[#data % 3 + 1])
end

local function vrB64Decode(data)
	data = data:gsub("[^" .. VR_B64 .. "=]", "")
	return (data:gsub(".", function(x)
		if x == "=" then
			return ""
		end
		local r, f = "", (VR_B64:find(x) - 1)
		for i = 6, 1, -1 do
			r = r .. (f % 2 ^ i - f % 2 ^ (i - 1) > 0 and "1" or "0")
		end
		return r
	end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(x)
		if #x ~= 8 then
			return ""
		end
		local c = 0
		for i = 1, 8 do
			c = c + (x:sub(i, i) == "1" and 2 ^ (8 - i) or 0)
		end
		return string.char(c)
	end))
end

local function vrXor(s)
	local out, klen = {}, #VR_KEY
	for i = 1, #s do
		out[i] = string.char(bit32.bxor(s:byte(i), VR_KEY:byte((i - 1) % klen + 1)))
	end
	return table.concat(out)
end

function VvvTimingCodec.encodeVR(tbl)
	local ok, json = pcall(function()
		return HttpService:JSONEncode(tbl)
	end)
	if not ok or not json then
		return nil
	end
	return "VR1\n" .. vrB64Encode(vrXor(json))
end

function VvvTimingCodec.decodeVR(raw)
	if type(raw) ~= "string" then
		return nil
	end
	local body = raw:match("^VR1\n(.*)$") or raw
	local ok, dec = pcall(function()
		return vrXor(vrB64Decode(body))
	end)
	if not ok or not dec then
		return nil
	end
	local ok2, data = pcall(function()
		return HttpService:JSONDecode(dec)
	end)
	if ok2 and type(data) == "table" then
		return data
	end
	return nil
end

function VvvTimingCodec.readConfig(path)
	if not (isfile and isfile(path) and readfile) then
		return nil
	end
	local ok, content = pcall(readfile, path)
	if not ok or not content then
		return nil
	end
	if path:sub(-3):lower() == ".vr" then
		return VvvTimingCodec.decodeVR(content)
	end
	local ok2, data = pcall(function()
		return HttpService:JSONDecode(content)
	end)
	if ok2 and type(data) == "table" then
		return data
	end
	return nil
end

function VvvTimingCodec.numId(id)
	if not id then
		return nil
	end
	return id:match("rbxassetid://(%d+)") or id:match("^(%d+)$") or id:match("(%d+)")
end

function VvvTimingCodec.fullIdOf(id)
	local n = VvvTimingCodec.numId(id)
	return n and ("rbxassetid://" .. n) or nil
end

function VvvTimingCodec.validId(id)
	return id and (id:match("rbxassetid://") or id:match("%d+")) and id ~= "unknown"
end

---Normalize VVV flat timing tables (same rules as VVV Ap.luau).
---@param d table?
---@return table?
function VvvTimingCodec.fixAnim(d)
	if type(d) ~= "table" then
		return d
	end

	if d.RollCancel == nil then
		d.RollCancel = d.Roll == true or d.Rolling == true
	end

	if d.HitboxWidth or d.HitboxHeight or d.HitboxRange or d.HitboxBehindRange then
		d.Hitbox = {
			X = d.HitboxWidth or 6,
			Y = d.HitboxHeight or 8,
			Z = d.HitboxRange or 8,
			ZSet = d.HitboxBehindRange or 2,
			YSet = d.HitboxYOffset or 0,
		}
		d.HitboxWidth, d.HitboxHeight = nil, nil
		d.HitboxRange, d.HitboxBehindRange, d.HitboxYOffset = nil, nil, nil
	end

	if type(d.Hitbox) == "table" then
		local hb = d.Hitbox
		hb.X = hb.X or 6
		hb.Y = hb.Y or 8
		hb.Z = hb.Z or 8
		hb.ZSet = hb.ZSet or 0
		hb.YSet = hb.YSet or 0
	end

	if type(d.Delay) == "table" and #d.Delay == 2 then
		d.Wait = math.floor((d.Delay[1] + d.Delay[2]) / 2 * 1000)
	end

	if d.Distance and not d.Range then
		d.Range = d.Distance
	end

	if type(d.RepeatParry) == "table" then
		d.RepeatParryAmount = d.RepeatParry.Times or 0
		d.RepeatParryDelay = math.floor((d.RepeatParry.Delay or 0.2) * 1000)
	end

	return d
end

function VvvTimingCodec.mkdirs(root)
	root = root or VvvTimingCodec.PRIMARY_ROOT
	local gameId = tostring(game.GameId)
	for _, folder in ipairs({
		root,
		root .. "/" .. gameId,
		root .. "/" .. gameId .. "/Config",
	}) do
		if not isfolder(folder) then
			makefolder(folder)
		end
	end
end

function VvvTimingCodec.collectPathsForRoot(root)
	local paths = {}
	local gameId = tostring(game.GameId)
	for _, merged in ipairs({
		root .. "/" .. gameId .. "/merged_config.json",
		root .. "/" .. gameId .. "/merged_config.VR",
	}) do
		if isfile and isfile(merged) then
			paths[#paths + 1] = merged
		end
	end
	local dir = root .. "/" .. gameId .. "/Config"
	if isfolder and isfolder(dir) and listfiles then
		local ok, listed = pcall(listfiles, dir)
		if ok and listed then
			for _, path in ipairs(listed) do
				local ext = path:match("%.([%w]+)$")
				ext = ext and ext:lower()
				if ext == "json" or ext == "js" or ext == "vr" then
					paths[#paths + 1] = path
				end
			end
		end
	end
	return paths
end

function VvvTimingCodec.findExistingFileForId(fid)
	for _, root in ipairs(VvvTimingCodec.CONFIG_ROOTS) do
		for _, path in ipairs(VvvTimingCodec.collectPathsForRoot(root)) do
			local data = VvvTimingCodec.readConfig(path)
			if data then
				for storedId in pairs(data) do
					if VvvTimingCodec.fullIdOf(storedId) == fid then
						return path
					end
				end
			end
		end
	end
	return nil
end

local function shallowCopy(tbl)
	local out = {}
	for k, v in pairs(tbl) do
		out[k] = v
	end
	return out
end

function VvvTimingCodec.toAnimationTiming(fid, flat)
	local d = VvvTimingCodec.fixAnim(shallowCopy(flat))
	local hb = d.Hitbox or { X = 8, Y = 8, Z = 8, ZSet = 0, YSet = 0 }
	local actionType = d.RollCancel and "Dodge" or "Parry"
	local whenMs = d.Wait or 0
	local range = d.Range or 50

	return AnimationTiming.new({
		_id = Scramble.str(fid),
		name = d.Name or fid,
		tag = "Undefined",
		imdd = Scramble.reNum(0),
		imxd = Scramble.reNum(range),
		hitbox = {
			X = Scramble.reNum(hb.X),
			Y = Scramble.reNum(hb.Y),
			Z = Scramble.reNum(hb.Z),
		},
		fhb = true,
		hso = Scramble.reNum(hb.YSet or 0),
		duih = false,
		punishable = 0.7,
		after = 0.1,
		actions = {
			{
				_type = Scramble.str(actionType),
				name = actionType,
				when = Scramble.reNum(whenMs),
				hitbox = {
					X = Scramble.reNum(hb.X),
					Y = Scramble.reNum(hb.Y),
					Z = Scramble.reNum(hb.Z),
				},
			},
		},
	})
end

function VvvTimingCodec.fromAnimationTiming(timing)
	local stack = timing.actions:stack()
	local first = stack[1]
	local whenMs = first and Scramble.num(first._when) or 0
	local actionType = first and Scramble.str(first._type) or "Parry"
	local hitbox = timing.hitbox

	return VvvTimingCodec.fixAnim({
		Name = timing.name,
		Wait = whenMs,
		Range = Scramble.num(timing.imxd),
		Roll = actionType == "Dodge",
		Hitbox = {
			X = Scramble.num(hitbox.X),
			Y = Scramble.num(hitbox.Y),
			Z = Scramble.num(hitbox.Z),
			ZSet = 0,
			YSet = Scramble.num(timing.hso or 0),
		},
		Grow = true,
	})
end

function VvvTimingCodec.writeEntry(fid, flat)
	if not (writefile and readfile and isfile) then
		return false
	end

	local proc = VvvTimingCodec.fixAnim(shallowCopy(flat))
	local filePath = VvvTimingCodec.findExistingFileForId(fid)
	if not filePath then
		VvvTimingCodec.mkdirs()
		local name = (proc.Name and proc.Name ~= "") and proc.Name or "logged"
		local sanitized = name:gsub("[^%w%s%-]", ""):gsub("%s+", "_")
		if sanitized == "" then
			sanitized = "logged"
		end
		filePath = VvvTimingCodec.PRIMARY_ROOT
			.. "/"
			.. tostring(game.GameId)
			.. "/Config/"
			.. sanitized
			.. ".VR"
	end

	local existing = VvvTimingCodec.readConfig(filePath) or {}
	existing[fid] = proc

	local out
	if filePath:sub(-3):lower() == ".vr" then
		out = VvvTimingCodec.encodeVR(existing)
	else
		local ok3, json = pcall(function()
			return HttpService:JSONEncode(existing)
		end)
		out = ok3 and json or nil
	end

	if not out then
		return false
	end

	return pcall(writefile, filePath, out) and true or false
