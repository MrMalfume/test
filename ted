                -- "show in keybind list" toggle
                local ListToggle = New("TextButton", {
                    Parent = ModeWindow.Frame,
                    Name = "ListToggle",
                    Text = "",
                    AutoButtonColor = false,
                    BackgroundTransparency = 1,
                    Position = UDim2New(0, 8, 0, 65),
