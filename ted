	local returnPosition = nil
	local localPlayer = players.LocalPlayer
	local character = localPlayer and localPlayer.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")

	if Configuration.expectToggleValue("ChestFarmTravel") and rootPart then
		returnPosition = rootPart.CFrame

		Teleport.to(CFrame.new(position + Vector3.new(0, 4, 0)))

		local deadline = os.clock() + 6.0

		repeat
			task.wait(0.1)
		until os.clock() >= deadline
			or not Configuration.expectToggleValue("ChestFarmEnabled")
			or not prompt.Parent
			or (rootPart.Position - position).Magnitude <= (prompt.MaxActivationDistance or 10)
	end

	if prompt.Parent and typeof(fireproximityprompt) == "function" then
		pcall(fireproximityprompt, prompt)
	end

	fireChestRemote(prompt)

	cooldowns[prompt] = os.clock() + COOLDOWN_SECONDS

	task.wait(Configuration.expectOptionValue("ChestFarmDelay") or 0.4)

	if returnPosition and Configuration.expectToggleValue("ChestFarmReturn") then
		Teleport.to(returnPosition)
	end

	collecting = false
end

---Find the closest eligible chest prompt.
---@param origin Vector3
---@return ProximityPrompt?, Vector3?
local function findClosest(origin)
	local range = Configuration.expectOptionValue("ChestFarmRange") or 120
	local closestPrompt = nil
	local closestPosition = nil
	local closestDistance = range
	local timestamp = os.clock()

	for prompt in next, prompts do
		if not prompt.Parent then
			prompts[prompt] = nil
			cooldowns[prompt] = nil
			continue
		end

		local cooldown = cooldowns[prompt]
		if cooldown and cooldown > timestamp then
			continue
		end

		if not prompt.Enabled or not isChestPrompt(prompt) then
			continue
		end

		local position = getPromptPosition(prompt)
		if not position then
			continue
		end

		local distance = (position - origin).Magnitude
		if distance > closestDistance then
			continue
		end

		closestPrompt = prompt
		closestPosition = position
		closestDistance = distance
	end

	return closestPrompt, closestPosition
end

---Update chest farm.
---@param deltaTime number
local function updateChestFarm(deltaTime)
	if collecting or not Configuration.expectToggleValue("ChestFarmEnabled") then
		return
	end

	scanAccumulator = scanAccumulator + deltaTime
	if scanAccumulator < SCAN_INTERVAL then
		return
	end

	scanAccumulator = 0

	local localPlayer = players.LocalPlayer
	local character = localPlayer and localPlayer.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return
	end

	local prompt, position = findClosest(rootPart.Position)
	if not prompt or not isSafe(position) then
		return
	end

	chestMaid:add(TaskSpawner.spawn("ChestFarm_Collect", collect, prompt, position))
end

---Rebuild the prompt cache from the current workspace contents.
function ChestFarm.rescan()
	table.clear(prompts)
	table.clear(cooldowns)

	for _, descendant in next, workspace:GetDescendants() do
		trackPrompt(descendant)
	end
end

---Initialize chest farm.
function ChestFarm.init()
	ChestFarm.rescan()

	local descendantAdded = Signal.new(workspace.DescendantAdded)
	chestMaid:add(descendantAdded:connect("ChestFarm_DescendantAdded", trackPrompt))

	local heartbeat = Signal.new(runService.Heartbeat)
	chestMaid:add(heartbeat:connect("ChestFarm_Heartbeat", updateChestFarm))

	Logger.warn("ChestFarm initialized.")
end

---Detach chest farm.
function ChestFarm.detach()
	chestMaid:clean()

	table.clear(prompts)
	table.clear(cooldowns)

	collecting = false

	Logger.warn("ChestFarm detached.")
end

