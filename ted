---@note: Hunter kicks on __namecall hooks, so every feature here is plain client API only.

local Movement = {}

---@module Utility.Configuration
local Configuration = __DARKLUA_BUNDLE_MODULES.i()

---@module Utility.OriginalStoreManager
local OriginalStoreManager = __DARKLUA_BUNDLE_MODULES.R()

---@module Utility.OriginalStore
