    state.lightingSnapshot = {
        Brightness = L.Brightness,
        ClockTime = L.ClockTime,
        FogEnd = L.FogEnd,
        FogStart = L.FogStart,
        GlobalShadows = L.GlobalShadows,
        Ambient = L.Ambient,
        OutdoorAmbient = L.OutdoorAmbient,
    }
end

local function restoreLighting()
    local snap = state.lightingSnapshot
    if not snap then
        return
    end
    local L = getService("Lighting")
    pcall(function()
        L.Brightness = snap.Brightness
        L.ClockTime = snap.ClockTime
        L.FogEnd = snap.FogEnd
        L.FogStart = snap.FogStart
        L.GlobalShadows = snap.GlobalShadows
        L.Ambient = snap.Ambient
