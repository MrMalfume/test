	end

	if typeof(getfenv) == "function" then
		pcall(function()
			set(getfenv())
			set(getfenv(0))
			set(getfenv(2))
		end)
	end

	-- Direct globals for this chunk.
	PP_SCRAMBLE_STR = str
	PP_SCRAMBLE_NUM = num
	PP_SCRAMBLE_RE_NUM = reNum
end

return Scramble
