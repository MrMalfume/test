                    Position = UDim2New(0.5, 0, 0.5, 0),
                    Size = UDim2New(1, -2, 1, -2),
                    ZIndex = 102
                })

                local function UpdateListVisual(Bool)
                    if Bool then
                        ListIndicator.BackgroundColor3 = Theme["Accent"]
                        ListInline.BackgroundColor3 = Theme["Accent"]
                        ListCheck.ImageTransparency = 0
                        ListToggleText.TextTransparency = 0
                    else
                        ListIndicator.BackgroundColor3 = Theme["Element"]
                        ListInline.BackgroundColor3 = Theme["Element"]
                        ListCheck.ImageTransparency = 1
                        ListToggleText.TextTransparency = 0.5
                    end
                end

                local function UpdateFlag()
                    Library.Flags[Keybind.Flag] = {
                        Key = Keybind.Key,
                        Mode = Keybind.Mode,
                        Toggled = Keybind.Toggled
                    }
                end

                local function UpdateKeylist()
                    RefreshKeylistPresence()
                end

                local function FireState(Bool)
                    Keybind.Toggled = Bool
                    UpdateFlag()
                    UpdateKeylist()

                    Library:SafeCall(Keybind.Callback, Bool)

                    if Owner and Owner.SetFromKeybind then
                        Owner:SetFromKeybind(Bool)
                    end
                end

                function Keybind:SetKey(Key)
                    if Key == nil then
                        Keybind.Key = nil
                    else
                        Keybind.Key = ParseKey(Key)
                    end

                    if KeyButton then
                        KeyButton.Text = "[" .. GetKeyName(Keybind.Key) .. "]"
                    end
                    UpdateFlag()
                    UpdateKeylist()
                    Library:SafeCall(Keybind.OnChanged, Keybind.Key)
                end

                function Keybind:SetMode(Mode)
                    Keybind.Mode = string.lower(Mode)
                    ModeValue.Text = Keybind.Mode
                    UpdateFlag()

                    if Keybind.Mode == "always" then
                        FireState(true)
                    end
                end

                function Keybind:SyncState(Bool)
                    Keybind.Toggled = Bool
                    UpdateFlag()
                    UpdateKeylist()
                end

                function Keybind:SetShowInList(Bool)
                    Keybind.ShowInList = Bool
                    UpdateListVisual(Bool)
                    RefreshKeylistPresence()
                end

                -- bind on left click (defer so this click is not captured as the bind)
                KeyButton.MouseButton1Click:Connect(function()
                    Keybind.Listening = false
                    KeyButton.Text = "[...]"
                    Tween(KeyButton, { TextTransparency = 0, TextColor3 = Theme["Accent"] }, 0.12)

                    task.defer(function()
                        Keybind.Listening = true
                    end)
                end)

                -- mode window on right click
                KeyButton.MouseButton2Click:Connect(function()
                    if Keybind.Listening then
                        return
                    end

                    ModeWindow:SetOpen(not ModeWindow.IsOpen)
                end)

                local Modes = { "toggle", "hold", "always" }

                ModeButton.MouseButton1Click:Connect(function()
                    local Index = table.find(Modes, Keybind.Mode) or 1
                    Keybind:SetMode(Modes[(Index % #Modes) + 1])
                end)

                ListToggle.MouseButton1Click:Connect(function()
                    Keybind:SetShowInList(not Keybind.ShowInList)
                end)

                Library:Connect(UserInputService.InputBegan, function(Input, GameProcessed)
                    if Keybind.Listening then
                        local Key

                        if Input.UserInputType == Enum.UserInputType.Keyboard then
                            Key = Input.KeyCode
                        elseif Input.UserInputType == Enum.UserInputType.MouseButton1
                            or Input.UserInputType == Enum.UserInputType.MouseButton3 then
                            -- MouseButton2 is reserved for the mode menu; do not bind it.
                            Key = Input.UserInputType
                        end

                        if Key then
                            Keybind.Listening = false

                            if Key == Enum.KeyCode.Escape then
                                Keybind:SetKey(nil)
                            else
                                Keybind:SetKey(Key)
                            end

                            Tween(KeyButton, { TextTransparency = 0.5, TextColor3 = Theme["Text"] }, 0.12)
                        end

                        return
                    end

                    if GameProcessed or not Keybind.Key or Keybind.Passive then
                        return
                    end

                    local Matched = (Input.KeyCode == Keybind.Key) or (Input.UserInputType == Keybind.Key)
                    if not Matched then
                        return
                    end

                    if Keybind.Mode == "toggle" then
                        FireState(not Keybind.Toggled)
                    elseif Keybind.Mode == "hold" then
                        FireState(true)
                    end
                end)

                Library:Connect(UserInputService.InputEnded, function(Input)
                    if Keybind.Mode ~= "hold" or not Keybind.Key then
                        return
                    end

                    local Matched = (Input.KeyCode == Keybind.Key) or (Input.UserInputType == Keybind.Key)
                    if Matched then
                        FireState(false)
                    end
                end)

                if Keybind.Mode == "always" then
                    task.defer(FireState, true)
                end

                UpdateFlag()
                UpdateKeylist()
                UpdateListVisual(Keybind.ShowInList)

                function Keybind:RefreshTheme()
                    UpdateListVisual(Keybind.ShowInList)
                end

                if Owner and Owner.Value ~= nil then
                    Keybind:SyncState(Owner.Value)
                end

                Library.SetFlags[Keybind.Flag] = function(Value)
                    if typeof(Value) == "table" then
                        if Value.Key ~= nil then Keybind:SetKey(Value.Key) end
                        if Value.Mode then Keybind:SetMode(Value.Mode) end
                    else
                        Keybind:SetKey(Value)
                    end
                end

                Library.Options[Keybind.Flag] = Keybind
                return Keybind
            end

