local function modelFromTalk(remote)
	local model = remote.Parent
	while model and not model:IsA("Model") do
		model = model.Parent
	end
	return model
end

local function nearestTalkModels(origin, range)
	if not origin then
		return {}
	end
	local rangeSq = range * range
	local found = {}
	local seen = {}

	for i = 1, #SCAN_FOLDERS do
		local folder = workspace:FindFirstChild(SCAN_FOLDERS[i])
		if folder then
			for _, desc in ipairs(folder:GetDescendants()) do
				if desc:IsA("RemoteEvent") and desc.Name == "CLIENTTALK" and not seen[desc] then
					seen[desc] = true
					local model = modelFromTalk(desc)
					local hrp = model and model:FindFirstChild("HumanoidRootPart")
					if hrp then
						local delta = hrp.Position - origin
						if delta:Dot(delta) <= rangeSq then
							found[#found + 1] = model
						end
					end
				end
			end
		end
	end

	table.sort(found, function(a, b)
		local ap = a.HumanoidRootPart.Position
		local bp = b.HumanoidRootPart.Position
		return (ap - origin):Dot(ap - origin) < (bp - origin):Dot(bp - origin)
	end)

	return found
end

