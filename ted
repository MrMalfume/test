---@param rootPart BasePart
---@param humanoid Humanoid
local function restoreFly(rootPart, humanoid)
	local hasMover = movementMaid["flyVelocity"] ~= nil or rootPart:FindFirstChild(FLY_VELOCITY_NAME) ~= nil

	if not hasMover and not humanoid.PlatformStand then
		return
	end

	clearFlyMovers(rootPart)

	humanoid.PlatformStand = false
	humanoid.AutoRotate = true

	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero
end

