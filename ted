local Scramble = {}

function Scramble.str(value)
	if type(value) ~= "string" then
		return value
	end

	local chars = table.create(#value)
	for index = 1, #value do
		chars[index] = string.char(bit32.bxor(string.byte(value, index), 42))
	end

	return table.concat(chars)
end

function Scramble.num(value)
	if type(value) ~= "number" then
		return value
	end

	return ((value + 69) * 12) - 5
end

function Scramble.reNum(value)
	if type(value) ~= "number" then
		return value
	end

	return ((value + 5) / 12) - 69
end

