local function upsertNiphTiming(fid, flat)
	local timing = VvvTimingCodec.toAnimationTiming(fid, flat)
	local container = SaveManager.userContainer("animation")
	local scrambledId = Scramble.str(fid)

	for id, existingTiming in pairs(container.timings) do
		local existingId = existingTiming:id()
		if id == fid or id == scrambledId or existingId == fid or existingId == scrambledId then
			container:remove(existingTiming)
		end
	end

