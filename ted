            local function AttachKeybind(ParentItem, KeybindData, Owner)
                KeybindData = KeybindData or { }

                local NoUI = KeybindData.NoUI or KeybindData.noui or false
                local Passive = KeybindData.Passive or KeybindData.passive or false

                local ShowInList = false
                if KeybindData.ShowInList ~= nil then
                    ShowInList = KeybindData.ShowInList
