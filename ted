local function FormatImage(Id)
    if not Id then
        return ""
    end

    Id = tostring(Id)

    if string.find(Id, "rbxassetid://", 1, true) or string.find(Id, "http", 1, true) then
        return Id
    end

    return "rbxassetid://" .. Id
end

-- // Font (kiwisense uses Inter; downloaded when file functions exist, Gotham fallback)
local LibraryFont do
    local Loaded = pcall(function()
        assert(type(writefile) == "function" and type(isfile) == "function" and type(getcustomasset) == "function")

        local FolderName = "reptillion"
        if type(isfolder) == "function" and not isfolder(FolderName) then
            makefolder(FolderName)
        end

        local TtfPath = FolderName .. "/Inter.ttf"
        local JsonPath = FolderName .. "/Inter.json"

        if not isfile(TtfPath) then
            writefile(TtfPath, game:HttpGet("https://github.com/sametexe001/luas/raw/refs/heads/main/fonts/InterSemibold.ttf"))
        end

        if not isfile(JsonPath) then
            writefile(JsonPath, HttpService:JSONEncode({
                name = "Inter",
                faces = { {
                    name = "Regular",
                    weight = 200,
                    style = "Regular",
                    assetId = getcustomasset(TtfPath)
                } }
            }))
        end

        LibraryFont = Font.new(getcustomasset(JsonPath))
    end)

    if not Loaded then
        LibraryFont = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal)
    end
end

