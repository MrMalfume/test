                Library:RegisterThemeRefresh(function()
                    if Library:IsMouseOver(ButtonItem) then
                        ButtonItem.BackgroundColor3 = Library:GetLighterColor(Theme["Element"], 1.45)
                    else
                        ButtonItem.BackgroundColor3 = Theme["Element"]
                    end
                end)

                New("TextLabel", {
                    Parent = ButtonItem,
                    Name = "Text",
                    FontFace = LibraryFont,
                    Text = Button.Name,
