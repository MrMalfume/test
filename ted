local function clearPreviewRig()
if previewTrack then pcall(function() previewTrack:Stop() end); previewTrack = nil end
if previewRig then pcall(function() previewRig:Destroy() end); previewRig = nil end
previewAnimator = nil
end
local function frameCamera(rig)
local root = rootOf(rig)
if not root then return end
local _, bbs = rig:GetBoundingBox()
zoomDist = math.max(bbs.Magnitude, 4)
previewCam.CFrame = CFrame.lookAt(root.Position - Vector3.new(0, 0, zoomDist), root.Position)
end
local function applyZoom()
if not previewRig or not previewCam then return end
local root = rootOf(previewRig)
if not root then return end
previewCam.CFrame = CFrame.lookAt(root.Position - Vector3.new(0, 0, zoomDist), root.Position)
end

loadPreviewAnim = function(fid)
clearPreviewRig()
if not fid then
	if viewport then viewport.Visible = false end
	if noPreviewFrame then noPreviewFrame.Visible = true end
	if noPreviewLbl then noPreviewLbl.Text = "Select an animation" end
	return
end
local entry = LoggedAnims[fid]
if not entry then return end
local source = entry.srcModel
if not (source and source.Parent and source:FindFirstChildOfClass("Humanoid")) then
	source = nil
	eachLivingModel(function(m)
		if not source and m.Name == entry.modelName and m:FindFirstChildOfClass("Humanoid") then source = m end
	end)
end
source = source or lp.Character
if not source then
	if noPreviewFrame then noPreviewFrame.Visible = true end
	if noPreviewLbl then noPreviewLbl.Text = "No model to preview" end
	return
end
local cloneOk = pcall(function()
	local prev = source.Archivable
	source.Archivable = true
	previewRig = source:Clone()
	source.Archivable = prev
end)
if not cloneOk or not previewRig then
	if noPreviewFrame then noPreviewFrame.Visible = true end
	if noPreviewLbl then noPreviewLbl.Text = "Could not clone model" end
	return
end
local root = rootOf(previewRig)
for _, d in previewRig:GetDescendants() do
	if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
		d:Destroy()
	elseif d:IsA("BasePart") then
		d.Anchored = (d == root); d.CanCollide = false; d.Massless = true; d.LocalTransparencyModifier = 0
	end
end
previewRig.Parent = worldModel
previewRig:PivotTo(CFrame.new(0, 0, 0))
frameCamera(previewRig)
local hum = previewRig:FindFirstChildOfClass("Humanoid")
if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None; hum.BreakJointsOnDeath = false end
local animator = hum and hum:FindFirstChildOfClass("Animator")
if not animator then
	if noPreviewFrame then noPreviewFrame.Visible = true end
	if noPreviewLbl then noPreviewLbl.Text = "No animator on rig" end
	return
end
previewAnimator = animator
local anim = Instance.new("Animation")
anim.AnimationId = fid
previewTrack = animator:LoadAnimation(anim)
previewTrack.Priority = Enum.AnimationPriority.Action
previewTrack.Looped = true
previewTrack:Play(0, 1, previewPaused and 0 or 1)
if viewport then viewport.Visible = true end
if noPreviewFrame then noPreviewFrame.Visible = false end
end

refreshPreview = function()
if not previewTrack then return end
local len = previewTrack.Length
local pos = previewTrack.TimePosition
if timelineLbl then
	timelineLbl.Text = string.format("%dms / %dms", math.round(pos * 1000), math.round((len > 0 and len or 0) * 1000))
end
if timelineFill and timelineBar then
	local pct = (len > 0) and math.clamp(pos / len, 0, 1) or 0
	timelineFill.Size = UDim2.new(pct, 0, 1, 0)
end
if playBtn then playBtn.Text = previewPaused and "Play" or "Pause" end
end

local function startPreviewLoop()
if previewConn then return end
previewConn = Run.PreRender:Connect(function(dt)
	if previewAnimator and not previewPaused then
		pcall(function() previewAnimator:StepAnimations(dt) end)
	end
	if panelVisible then refreshPreview() end
end)
end
local function stopPreviewLoop() disc(previewConn); previewConn = nil end

local function currentWaitMs()
