		return
	end

	if not Configuration.expectToggleValue("AutoTalkClickThrough") then
		return
	end

	local timestamp = os.clock()
	if timestamp - lastClick < (Configuration.expectOptionValue("AutoTalkInterval") or 0.25) then
		return
	end

	if not isDialogueOpen() then
		return
	end

	lastClick = timestamp

	local success, virtualInput = pcall(game.GetService, game, "VirtualInputManager")
	if not success or not virtualInput then
		return
	end

	local mouse = players.LocalPlayer:GetMouse()

	pcall(function()
		virtualInput:SendMouseButtonEvent(mouse.X, mouse.Y, 0, true, game, 0)
		virtualInput:SendMouseButtonEvent(mouse.X, mouse.Y, 0, false, game, 0)
	end)
end

