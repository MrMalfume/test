local players = game:GetService("Players")

-- Maids.
local streamMaid = Maid.new()

-- Original stores.
local textMap = OriginalStoreManager.new()

-- Constants.
local SCAN_INTERVAL = 0.5
local DEFAULT_MASK = "Niph"
local MASKED_CORE_GUI = {
	Enum.CoreGuiType.PlayerList,
	Enum.CoreGuiType.Chat,
}

-- Accumulator.
local scanAccumulator = 0

-- Whether core GUI is currently masked by us.
local coreGuiMasked = false

---The text we replace identities with.
---@return string
local function getMask()
	local mask = Configuration.expectOptionValue("StreamableName")

	if type(mask) ~= "string" or not string.match(mask, "%S") then
		return DEFAULT_MASK
	end

	return mask
end

---Build the set of strings that identify somebody.
---@return table<string, boolean>
local function getIdentities()
	local localPlayer = players.LocalPlayer
	local identities = {}

	if localPlayer then
		identities[localPlayer.Name] = true
		identities[localPlayer.DisplayName] = true
	end

	if not Configuration.expectToggleValue("StreamableMaskOthers") then
		return identities
	end

	for _, player in next, players:GetPlayers() do
		identities[player.Name] = true
		identities[player.DisplayName] = true
	end

	return identities
end

---Mask every identifying label under a root.
---@param root Instance
---@param identities table<string, boolean>
---@param mask string
local function maskLabels(root, identities, mask)
	for _, descendant in next, root:GetDescendants() do
		if not descendant:IsA("TextLabel") and not descendant:IsA("TextButton") then
			continue
		end

		local text = descendant.Text

		if text == mask then
			continue
		end

		if not identities[text] then
			continue
		end

		textMap:add(descendant, "Text", mask)
	end
end

---Toggle the Roblox core GUI elements that leak the account name.
---@param masked boolean
local function setCoreGuiMasked(masked)
	if coreGuiMasked == masked then
		return
	end

	coreGuiMasked = masked

	for _, coreGuiType in next, MASKED_CORE_GUI do
		pcall(starterGui.SetCoreGuiEnabled, starterGui, coreGuiType, not masked)
	end
end

---Update stream safe mode.
---@param deltaTime number
local function updateStreamable(deltaTime)
	if not Configuration.expectToggleValue("StreamableEnabled") then
		textMap:restore()
		setCoreGuiMasked(false)

		return
	end

	setCoreGuiMasked(Configuration.expectToggleValue("StreamableHideCoreGui") == true)

	scanAccumulator = scanAccumulator + deltaTime
	if scanAccumulator < SCAN_INTERVAL then
		return
	end

	scanAccumulator = 0

	local localPlayer = players.LocalPlayer
	local playerGui = localPlayer and localPlayer:FindFirstChild("PlayerGui")
	if not playerGui then
		return
	end

	local identities = getIdentities()
	local mask = getMask()

	maskLabels(playerGui, identities, mask)

	if Configuration.expectToggleValue("StreamableMaskOthers") then
		local alive = workspace:FindFirstChild("Alive")

		if alive then
			maskLabels(alive, identities, mask)
		end
	end
