local Retry = {}

function Retry.new()
	return {
		failures = {},
		cooldowns = {},
	}
end

function Retry.cooling(store, key)
	local untilAt = store.cooldowns[key]
	return untilAt ~= nil and tick() < untilAt
end

function Retry.coolFor(store, key, seconds)
	store.cooldowns[key] = tick() + seconds
end

function Retry.ok(store, key)
	store.failures[key] = 0
	store.cooldowns[key] = nil
end

function Retry.fail(store, key, limit, cooldownSeconds, onNotify, message)
	local count = (store.failures[key] or 0) + 1
	store.failures[key] = count
	if count >= limit then
		store.failures[key] = 0
		Retry.coolFor(store, key, cooldownSeconds)
		if type(onNotify) == "function" and message then
			onNotify(message)
		end
		return true
	end
	return false
end

return Retry
