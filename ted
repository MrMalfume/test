	local root = rootOf(info.Model)
	if not root then
		return
	end

	local hitbox = scaledHitbox(info.Model, TimingCodec.fullHitbox(info.AnimData.Hitbox), info.AnimData)
	local offset = CFrame.new(0, hitbox.YSet, -(hitbox.Z - hitbox.ZSet) / 2)

	local part = Instance.new("Part")
	part.Name = "HB_" .. info.TrackId
	part.Anchored = true
	part.Massless = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Material = Enum.Material.ForceField
	part.Color = Color3.fromRGB(85, 255, 127)
	part.Transparency = 0.4
	part.Size = Vector3.new(hitbox.X, hitbox.Y, hitbox.Z + hitbox.ZSet)
	part.CFrame = root.CFrame * offset
