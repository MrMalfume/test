            local SectionFrame = New("Frame", {
                Parent = Page.ColumnsData[math.clamp(Section.Side, 1, Page.Columns)],
                Name = "Section",
                BackgroundColor3 = Theme["Inline"],
                Size = UDim2New(1, 0, 0, 55),
                AutomaticSize = Enum.AutomaticSize.Y,
                BorderSizePixel = 0,
                ZIndex = 2
            })

            Library:ApplyTheme(SectionFrame, { BackgroundColor3 = "Inline" })

            New("UICorner", {
                Parent = SectionFrame,
                CornerRadius = UDimNew(0, 5)
            })

            New("UIPadding", {
                Parent = SectionFrame,
                PaddingBottom = UDimNew(0, 8)
            })

            -- section header (Reptillion: icon before title)
            local SectionTopbar = New("Frame", {
                Parent = SectionFrame,
                Name = "Topbar",
                BackgroundColor3 = Theme["Group Header"],
                Size = UDim2New(1, 0, 0, 37),
                BorderSizePixel = 0,
                ZIndex = 2
            })

            Library:ApplyTheme(SectionTopbar, { BackgroundColor3 = "Group Header" })

            New("UICorner", {
                Parent = SectionTopbar,
                CornerRadius = UDimNew(0, 5)
            })

            New("Frame", {
                Parent = SectionTopbar,
                Name = "CornerFix",
                BackgroundColor3 = Theme["Group Header"],
                AnchorPoint = Vector2New(0, 1),
                Position = UDim2New(0, 0, 1, 0),
                Size = UDim2New(1, 0, 0, 5),
                BorderSizePixel = 0,
                ZIndex = 2
            })

            local HeaderRow = New("Frame", {
                Parent = SectionTopbar,
                Name = "HeaderRow",
                BackgroundTransparency = 1,
                AnchorPoint = Vector2New(0, 0.5),
                Position = UDim2New(0, 14, 0.5, 0),
                AutomaticSize = Enum.AutomaticSize.XY,
                Size = UDim2New(0, 0, 0, 0),
                ZIndex = 2
            })

            New("UIListLayout", {
                Parent = HeaderRow,
                FillDirection = Enum.FillDirection.Horizontal,
                VerticalAlignment = Enum.VerticalAlignment.Center,
