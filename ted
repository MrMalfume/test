end)

---Combat numbers (Posture, Stamina, ComboValue, ParryNumber, ...).
---@param model Model?
---@return table<string, number>
StateCache.combat = LPH_NO_VIRTUALIZE(function(model)
	return readValues(model, "Combat")
end)

---Information values (LivesLeft, Meditating).
---@param model Model?
---@return table<string, any>
StateCache.information = LPH_NO_VIRTUALIZE(function(model)
	return readValues(model, "Information")
end)

---Active buff values (SpeedBuff, DefenseBuff, ...).
---@param model Model?
---@return table<string, any>
StateCache.buffs = LPH_NO_VIRTUALIZE(function(model)
	return readValues(model, "Buffs")
end)

---Read a single combat number without allocating the whole table.
---@param model Model?
---@param name string
---@return number?
StateCache.combatValue = LPH_NO_VIRTUALIZE(function(model, name)
	local folder = resolve(model, "Combat")
	if not folder then
		return nil
	end

	local value = folder:FindFirstChild(name)
	if not value or not value:IsA("ValueBase") then
		return nil
	end

	return value.Value
end)

