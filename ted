function Library:IsMouseOver(Item, Padding)
    Padding = Padding or 0

    local Location = UserInputService:GetMouseLocation()
    local Position = Item.AbsolutePosition
    local Size = Item.AbsoluteSize

    local inRect = Location.X >= Position.X - Padding
        and Location.X <= Position.X + Size.X + Padding
        and Location.Y >= Position.Y - Padding
        and Location.Y <= Position.Y + Size.Y + Padding

    if inRect then
        return true
    end

    -- Scrolling dropdown lists: options can sit outside the parent frame rect.
    local playerGui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui and typeof(playerGui.GetGuiObjectsAtPosition) == "function" then
        local at = playerGui:GetGuiObjectsAtPosition(Location.X, Location.Y)
        for _, obj in ipairs(at) do
            if obj == Item or obj:IsDescendantOf(Item) then
                return true
            end
        end
    end

    return false
end

-- // Fade system (snapshot current transparency each fade, restore after hide)
local function GetTransparencyProperties(Item)
    if Item:IsA("Frame") or Item:IsA("CanvasGroup") then
        return { "BackgroundTransparency" }
    elseif Item:IsA("TextLabel") or Item:IsA("TextButton") or Item:IsA("TextBox") then
        return { "TextTransparency", "BackgroundTransparency" }
    elseif Item:IsA("ImageLabel") or Item:IsA("ImageButton") then
        return { "BackgroundTransparency", "ImageTransparency" }
    elseif Item:IsA("ScrollingFrame") then
        return { "BackgroundTransparency", "ScrollBarImageTransparency" }
    elseif Item:IsA("UIStroke") then
        return { "Transparency" }
    end
end

local function FadeInstance(Root, Visible, Speed)
    Speed = Speed or 0.2

    -- Instant path: never walk descendants / spawn tweens (Niph menu uses FadeSpeed 0).
    -- Tweening every TextLabel/UIStroke in a large menu freezes the client on open.
    if Speed <= 0 or not Root then
        return nil
    end

    -- Prefer a single GroupTransparency tween when possible.
    if Root:IsA("CanvasGroup") then
        if Visible then
            Root.GroupTransparency = 1
            return Tween(Root, { GroupTransparency = 0 }, Speed)
        end

        return Tween(Root, { GroupTransparency = 1 }, Speed)
    end

    -- Fallback: fade the root only (not hundreds of descendants).
    local Properties = GetTransparencyProperties(Root)
    if not Properties then
        return nil
    end

    local LastTween

    for _, Property in ipairs(Properties) do
        local OldTransparency = Root:GetAttribute("_Fade_" .. Property)
        if OldTransparency == nil then
            OldTransparency = Root[Property]
            Root:SetAttribute("_Fade_" .. Property, OldTransparency)
        end

        if Visible then
            Root[Property] = 1
            LastTween = Tween(Root, { [Property] = OldTransparency }, Speed)
        else
            LastTween = Tween(Root, { [Property] = 1 }, Speed)

            if LastTween then
                LastTween.Completed:Once(function()
                    Root[Property] = OldTransparency
                end)
            else
                Root[Property] = OldTransparency
            end
        end
    end

    return LastTween
end

-- // Dragging (smooth tween-follow, same feel as kiwisense)
local function MakeDraggable(Item, DragItem)
    DragItem = DragItem or Item

    local Dragging = false
    local DragStart, StartPosition

    DragItem.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            DragStart = Input.Position
            StartPosition = Item.Position

            local Changed
            Changed = Input.Changed:Connect(function()
                if Input.UserInputState == Enum.UserInputState.End then
                    Dragging = false
                    Changed:Disconnect()
                end
            end)
        end
    end)

    Library:Connect(UserInputService.InputChanged, function(Input)
        if not Dragging then
            return
        end

        if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
            local Delta = Input.Position - DragStart

            Tween(Item, {
                Position = UDim2New(
                    StartPosition.X.Scale, StartPosition.X.Offset + Delta.X,
                    StartPosition.Y.Scale, StartPosition.Y.Offset + Delta.Y
                )
            }, 0.16, Enum.EasingStyle.Quart)
        end
    end)
end

-- // Resizing (accent grip in the bottom-right corner, hidden until hover)
local function MakeResizeable(Item, Minimum)
    local Resizing = false
    local Start

    local HoverZone = New("Frame", {
        Parent = Item,
        Name = "ResizeHover",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2New(1, 1),
        Position = UDim2New(1, 0, 1, 0),
        Size = UDim2New(0, 16, 0, 16),
        ZIndex = 10,
        Active = true
    })

    local ResizeButton = New("ImageButton", {
        Parent = HoverZone,
        Name = "Resize",
        Image = Icons.Resize,
        ImageTransparency = 1,
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2New(1, 1),
        Position = UDim2New(1, -4, 1, -4),
        Size = UDim2New(0, 9, 0, 9),
        ZIndex = 11
    })

    Library:ApplyTheme(ResizeButton, { ImageColor3 = "Accent" })

    local function SetResizeVisible(Visible)
        Tween(ResizeButton, { ImageTransparency = Visible and 0 or 1 }, 0.12)
    end

    HoverZone.MouseEnter:Connect(function()
        SetResizeVisible(true)
    end)

    HoverZone.MouseLeave:Connect(function()
        if not Resizing then
            SetResizeVisible(false)
        end
    end)

    ResizeButton.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Resizing = true
            SetResizeVisible(true)
            Start = Item.Size - UDim2New(0, Input.Position.X, 0, Input.Position.Y)

            local Changed
            Changed = Input.Changed:Connect(function()
                if Input.UserInputState == Enum.UserInputState.End then
                    Resizing = false
                    Changed:Disconnect()

                    if not Library:IsMouseOver(HoverZone) then
                        SetResizeVisible(false)
                    end
                end
            end)
        end
    end)

    Library:Connect(UserInputService.InputChanged, function(Input)
        if not Resizing then
            return
        end

        if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
            local Delta = Start + UDim2New(0, Input.Position.X, 0, Input.Position.Y)
            Delta = UDim2New(0, math.max(Delta.X.Offset, Minimum.X), 0, math.max(Delta.Y.Offset, Minimum.Y))

            Tween(Item, { Size = Delta }, 0.17, Enum.EasingStyle.Quart)
        end
    end)
end

