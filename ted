    end)
    state.lightingSnapshot = nil
end

local function applyVisuals()
    local f = state.flags
    local L = getService("Lighting")
    if f.fullbright or f.noFog then
        ensureLightSnapshot()
    end
    if f.fullbright then
        pcall(function()
            L.Brightness = 2
            L.ClockTime = 14
            L.GlobalShadows = false
            L.Ambient = Color3.fromRGB(178, 178, 178)
            L.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
        end)
    end
    if f.noFog then
        pcall(function()
            L.FogEnd = 1e9
            L.FogStart = 1e9
        end)
    end
    if not f.fullbright and not f.noFog and state.lightingSnapshot then
        restoreLighting()
    end
end

