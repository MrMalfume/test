---Refresh cached block keycodes.
local function refreshBlockKeyCodes()
	local now = os.clock()
	if cachedBlockKeyCodes and (now - cachedBlockKeyCodesAt) < BLOCK_KEY_CACHE_TTL then
		return cachedBlockKeyCodes
	end

	local keybinds = replicatedStorage:FindFirstChild("KeyBinds")
	if not keybinds then
		cachedBlockKeyCodes = {}
		cachedBlockKeyCodesAt = now
		return cachedBlockKeyCodes
	end

	local success, keybindsModule = pcall(require, keybinds)
	if not success or not keybindsModule or not keybindsModule.Current then
		cachedBlockKeyCodes = {}
		cachedBlockKeyCodesAt = now
		return cachedBlockKeyCodes
	end

	local bindings = keybindsModule:GetBindings() or {}
	local codes = {}

	for _, keybind in next, bindings["Block"] or {} do
		local ok, keyCode = pcall(function()
			return Enum.KeyCode[tostring(keybind)]
		end)

		if ok and keyCode then
			codes[#codes + 1] = keyCode
		end
	end

	cachedBlockKeyCodes = codes
	cachedBlockKeyCodesAt = now

	return codes
end

