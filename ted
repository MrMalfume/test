	if not fid or type(animData) ~= "table" then
		return false
	end

	local flat = shallowCopy(animData)
	libraryFromTiming(fid, flat)
	local diskOk = VvvTimingCodec.writeEntry(fid, flat)
	local niphOk = upsertNiphTiming(fid, flat)
	return diskOk or niphOk
