---@param model Model
---@param kind string "Player" or "Mob"
---@param player Player?
---@return EntityEsp
function EntityEsp.new(model, kind, player)
	local self = setmetatable({}, EntityEsp)

	self.model = model
	self.kind = kind
	self.player = player
	self.label = player and player.Name or EntityEsp.clean(model.Name)
	self.maid = Maid.new()
