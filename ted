function VvvTimingBridge.LoadConfigs()
	if not (isfolder and makefolder and readfile and listfiles) then
		return 0
	end

	local total = 0
	for _, root in ipairs(VvvTimingCodec.CONFIG_ROOTS) do
		for _, path in ipairs(VvvTimingCodec.collectPathsForRoot(root)) do
			local data = VvvTimingCodec.readConfig(path)
			if data then
				for animId, entry in pairs(data) do
					if VvvTimingCodec.validId(animId) and type(entry) == "table" and entry.Name then
						local fid = VvvTimingCodec.fullIdOf(animId)
						if fid and not VvvTimingBridge.ParryLibrary[fid] then
							libraryFromTiming(fid, entry)
							upsertNiphTiming(fid, entry)
							total += 1
						end
					end
				end
			end
		end
	end

	if total > 0 then
		Logger.notify("Loaded %i animation timing(s) from .VR config.", total)
	end

	return total
end

function VvvTimingBridge.syncActiveAnimations()
	table.clear(VvvTimingBridge.ActiveAnimations)

	local track = StateListener.activeDefenseTrack
	local entity = StateListener.activeDefenseMob
	if not track or not entity or not track.IsPlaying then
		return
	end

	local anim = track.Animation
	local fid = anim and VvvTimingCodec.fullIdOf(anim.AnimationId)
	if not fid then
		return
	end

	local animData = VvvTimingBridge.ParryLibrary[fid]
		or (SaveManager.as:index(fid) and VvvTimingCodec.fromAnimationTiming(SaveManager.as:index(fid)))

	local trackId = tostring(track)
	VvvTimingBridge.ActiveAnimations[trackId] = {
		TrackId = trackId,
		Model = entity,
		Track = track,
		AnimData = animData,
		IsActive = true,
	}
end

function VvvTimingBridge.openEntry(animId)
	local fid = VvvTimingCodec.fullIdOf(animId) or animId
	if animLogger and animLogger.OpenEntry then
		animLogger.OpenEntry(fid)
	elseif animLogger and animLogger.Show then
		animLogger.Show()
	end
end

function VvvTimingBridge.init(animLoggerModule)
	animLogger = animLoggerModule
	VvvTimingBridge.LoadConfigs()

	maid:mark(runService.Heartbeat:Connect(function()
		VvvTimingBridge.syncActiveAnimations()
	end))
end

function VvvTimingBridge.detach()
	maid:clean()
	table.clear(VvvTimingBridge.ParryLibrary)
	table.clear(VvvTimingBridge.ActiveAnimations)
	animLogger = nil
end

return VvvTimingBridge
