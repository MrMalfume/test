	Spectate.subject = nil

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	local localPlayer = players.LocalPlayer
	local character = localPlayer and localPlayer.Character

	camera.CameraType = Enum.CameraType.Custom
	camera.CameraSubject = character and character:FindFirstChildOfClass("Humanoid")
end

---Point the camera at a player.
---@param player Player
---@return boolean
function Spectate.start(player)
	if type(player) == "string" then
		player = players:FindFirstChild(player)
	end

	local character = player and player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local camera = workspace.CurrentCamera

	if not camera or not character or not humanoid then
		return false
	end

	Spectate.active = true
	Spectate.subject = player

	camera.CameraType = Enum.CameraType.Custom
	camera.CameraSubject = humanoid

	return true
end

---Cycle to the next available player.
---@return Player?
function Spectate.next()
	local targets = getTargets()
	if #targets == 0 then
		Spectate.stop()
		return nil
	end

	local index = table.find(targets, Spectate.subject) or 0
	index = index + 1

	if index > #targets then
		index = 1
	end

	local target = targets[index]

	Spectate.start(target)

	return target
end

---Toggle spectating on the current (or first available) subject.
---@return boolean
function Spectate.toggle()
	if Spectate.active then
		Spectate.stop()
		return false
	end

	if Spectate.subject and Spectate.start(Spectate.subject) then
		return true
	end

	return Spectate.next() ~= nil
end

