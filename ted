	autoFavourApplied = false
	autoFavourBdata = nil
	lastFavouredNames = {}
	dismissRoll2()
	roll2Notified = false
	cachedRoll2Selection = nil

	visualsMaid:clean()
	builderAssistanceMaid:clean()

	Logger.warn("Visuals detached.")
end

-- Return Visuals module.
return Visuals
