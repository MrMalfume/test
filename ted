	local startDialogue = dialogueSystem and dialogueSystem:FindFirstChild("StartDialogue")

	if startDialogue and startDialogue:IsA("RemoteEvent") then
		local startSignal = Signal.new(startDialogue.OnClientEvent)
		talkMaid:add(startSignal:connect("AutoTalk_StartDialogue", onStartDialogue))
	else
		Logger.warn("AutoTalk could not find DialogueSystem.StartDialogue.")
	end

	local heartbeat = Signal.new(runService.Heartbeat)
	talkMaid:add(heartbeat:connect("AutoTalk_Heartbeat", updateClickThrough))

	Logger.warn("AutoTalk initialized.")
end

---Detach auto talk.
function AutoTalk.detach()
	talkMaid:clean()

	cachedFrame = nil
	advancing = false

	Logger.warn("AutoTalk detached.")
end

-- Return AutoTalk module.
return AutoTalk
