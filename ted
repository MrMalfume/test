	if not logSelf and model == lp.Character then return end
	local root = rootOf(model)
	if not root then return end
	local d = (mr.Position - root.Position).Magnitude
	if d > logRange or d >= bestDist then return end
	bestDist = d
	best = { Model = model, Track = track, AnimData = animData }
end
local active = VVV and VVV.ActiveAnimations
if active then
	for _, info in pairs(active) do
		if info.IsActive and info.Track and info.Track.IsPlaying and info.Model and info.Model.Parent then
			consider(info.Model, info.Track, info.AnimData)
		end
	end
end
if best then return best, bestDist end
for model in pairs(hookedModels) do
	if model and model.Parent then
		local hum = model:FindFirstChildOfClass("Humanoid")
		local animator = hum and hum:FindFirstChildOfClass("Animator")
		if animator then
			local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
			if ok and tracks then
				for _, track in ipairs(tracks) do consider(model, track, nil) end
			end
		end
	end
end
return best, bestDist
end

