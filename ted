---from the web API and handed to TeleportService directly.

local ServerHop = {}

---@module Utility.Configuration
local Configuration = __DARKLUA_BUNDLE_MODULES.i()

---@module Utility.PersistentData
local PersistentData = __DARKLUA_BUNDLE_MODULES.as()

---@module Utility.TaskSpawner
local TaskSpawner = __DARKLUA_BUNDLE_MODULES.j()

---@module Utility.Logger
local Logger = __DARKLUA_BUNDLE_MODULES.g()

---@module Utility.JSON
local JSON = __DARKLUA_BUNDLE_MODULES.ax()

-- Services.
local teleportService = game:GetService("TeleportService")
local players = game:GetService("Players")

-- Constants.
local SERVERS_ENDPOINT = "https://games.roblox.com/v1/games/%i/servers/Public?sortOrder=Asc&limit=100"
local BLACKLIST_LIFETIME = 300
local PAGE_LIMIT = 4

---Fetch a URL with whatever HTTP primitive the executor exposes.
---@param url string
---@return string?
local function httpGet(url)
	local requestFunction = (syn and syn.request) or (http and http.request) or http_request or request

	if type(requestFunction) == "function" then
		local success, response = pcall(requestFunction, { Url = url, Method = "GET" })

		if success and type(response) == "table" and response.Body then
			return response.Body
		end
	end

	local success, body = pcall(function()
		return game:HttpGet(url)
	end)

	if success and type(body) == "string" then
		return body
	end

	return nil
end

---Read (and prune) the blacklist of servers we already tried.
---@return table<string, number>
local function getBlacklist()
	local blacklist = PersistentData.get("sblacklist") or {}
	local timestamp = tick()

	for id, stamp in next, blacklist do
		if timestamp - stamp >= BLACKLIST_LIFETIME then
			blacklist[id] = nil
		end
	end

	return blacklist
end

---Remember a server we do not want to land in again.
---@param id string
local function addBlacklist(id)
	local blacklist = getBlacklist()

	blacklist[id] = tick()

	PersistentData.set("sblacklist", blacklist)
end

---Collect candidate servers across a few pages.
---@return table[]
local function collectServers()
	local blacklist = getBlacklist()
	local candidates = {}
	local cursor = nil

	for _ = 1, PAGE_LIMIT do
		local url = SERVERS_ENDPOINT:format(game.PlaceId)

		if cursor then
			url = url .. "&cursor=" .. cursor
		end

		local body = httpGet(url)
		if not body then
			break
		end

		local success, payload = pcall(JSON.decode, body)
		if not success or type(payload) ~= "table" or type(payload.data) ~= "table" then
			break
		end

		for _, server in next, payload.data do
			if server.id == game.JobId then
				continue
			end

			if blacklist[server.id] then
				continue
			end

			if server.playing and server.maxPlayers and server.playing >= server.maxPlayers then
				continue
			end

			candidates[#candidates + 1] = server
		end

		cursor = payload.nextPageCursor

		if not cursor then
			break
		end
	end

	return candidates
end

---Sort candidates by the configured preference.
---@param candidates table[]
local function sortServers(candidates)
	local preference = Configuration.expectOptionValue("ServerHopPreference") or "Least Players"

	if preference == "Most Players" then
		table.sort(candidates, function(first, second)
			return (first.playing or 0) > (second.playing or 0)
		end)

		return
	end

	if preference == "Random" then
		for index = #candidates, 2, -1 do
			local swap = math.random(index)
			candidates[index], candidates[swap] = candidates[swap], candidates[index]
		end

		return
	end

	table.sort(candidates, function(first, second)
		return (first.playing or 0) < (second.playing or 0)
	end)
end

---Hop to another public server.
---@return boolean
function ServerHop.hop()
	local candidates = collectServers()
	if #candidates == 0 then
		Logger.longNotify("No available servers to hop to.")
		return false
	end

	sortServers(candidates)

	local target = candidates[1]

	addBlacklist(game.JobId)
	addBlacklist(target.id)

	Logger.notify("Hopping to a server with %i player(s).", target.playing or 0)

	local success, result = pcall(function()
		teleportService:TeleportToPlaceInstance(game.PlaceId, target.id, players.LocalPlayer)
	end)

	if not success then
		Logger.longNotify("(%s) Server hop failed.", tostring(result))
	end

	return success
end

---Rejoin the current server.
---@return boolean
function ServerHop.rejoin()
	local success, result = pcall(function()
		teleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, players.LocalPlayer)
	end)

	if success then
		return true
	end

	Logger.longNotify("(%s) Rejoin failed, falling back to a fresh server.", tostring(result))

	return pcall(function()
		teleportService:Teleport(game.PlaceId, players.LocalPlayer)
	end)
end

---Hop in the background so the caller (a UI button) is never blocked.
function ServerHop.hopAsync()
	TaskSpawner.spawn("ServerHop_Hop", ServerHop.hop)
end

---Rejoin in the background.
function ServerHop.rejoinAsync()
	TaskSpawner.spawn("ServerHop_Rejoin", ServerHop.rejoin)
end

-- Return ServerHop module.
return ServerHop
