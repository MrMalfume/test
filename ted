	local now = os.clock()
	if now - cachedAt < SAMPLE_TTL then
		return cachedRtt
	end

	local sample = readRtt() or 0

	cachedRtt = sample
	cachedAt = now

	if sample > 0 then
		smoothedRtt = smoothedRtt and (smoothedRtt + (sample - smoothedRtt) * Latency.SMOOTHING) or sample
	end

	return cachedRtt
end)

---Get the smoothed round-trip time. This is what timing math should use.
---@return number
