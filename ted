                elseif not NoUI then
                    ShowInList = not Passive
                end

                local Keybind = {
                    Name = KeybindData.Name or KeybindData.name or KeybindData.Text or KeybindData.text or (Owner and Owner.Name) or "keybind",
                    Flag = KeybindData.Flag or KeybindData.flag or Library:NextFlag(),
                    Mode = string.lower(KeybindData.Mode or KeybindData.mode or "toggle"),
                    Key = ParseKey(KeybindData.Default or KeybindData.default),
                    Callback = KeybindData.Callback or KeybindData.callback,
                    OnChanged = KeybindData.OnChanged or KeybindData.onchanged,
                    Passive = Passive,

                    Toggled = false,
                    Listening = false,
                    ShowInList = ShowInList
                }

                local KeyButtonParent = NoUI and ScreenGui or ParentItem

                local KeyButton = New("TextButton", {
                    Parent = KeyButtonParent,
                    Name = "Keybind",
                    FontFace = LibraryFont,
                    Text = "[" .. GetKeyName(Keybind.Key) .. "]",
                    TextSize = 14,
                    TextColor3 = Theme["Text"],
                    TextTransparency = 0.5,
                    AutoButtonColor = false,
                    BackgroundTransparency = 1,
                    AutomaticSize = NoUI and Enum.AutomaticSize.None or Enum.AutomaticSize.X,
                    Size = NoUI and UDim2New(0, 0, 0, 0) or UDim2New(0, 0, 1, 0),
                    Visible = not NoUI,
                    ZIndex = 2,
                    LayoutOrder = 6
                })

                New("UIPadding", {
                    Parent = KeyButton,
                    PaddingLeft = UDimNew(0, 2),
                    PaddingRight = UDimNew(0, 2)
                })

                Library:EnsureInterface()

                local function KeylistKeyLabel()
                    if Keybind.Key then
                        return GetKeyName(Keybind.Key)
                    end

                    return "manual"
                end

                local KeylistItem
                local function EnsureKeylistItem()
                    if KeylistItem or not Keybind.ShowInList or not Library.KeyList then
                        return
                    end

                    -- Show bound keys, or unbound toggles that are currently on.
                    if not Keybind.Key and not Keybind.Toggled then
                        return
                    end

                    KeylistItem = Library.KeyList:Add(KeylistKeyLabel(), Keybind.Name)
                end

                local function RefreshKeylistPresence()
                    local show = Keybind.ShowInList and (Keybind.Key ~= nil or Keybind.Toggled)

                    if show then
                        EnsureKeylistItem()
                        if KeylistItem then
                            KeylistItem:SetVisibility(true)
                            KeylistItem:SetText(KeylistKeyLabel(), Keybind.Name)

                            if Keybind.Mode == "hold" then
                                KeylistItem:SetStatus(Keybind.Toggled and "holding" or "off")
                            else
                                KeylistItem:SetStatus(Keybind.Toggled and "on" or "off")
                            end

                            KeylistItem:Set(Keybind.Toggled)
                        end
                    elseif KeylistItem then
                        KeylistItem:SetVisibility(false)
                    end
                end

                EnsureKeylistItem()

                -- mode window (draggable popup, kiwisense-style)
                local ModeWindow = CreatePopup({
                    Triggers = { KeyButton },
                    Follow = KeyButton,
                    Detach = true,
                    Offset = Vector2New(-160, 5),
                    Size = UDim2New(0, 195, 0, 93),
                    Shadow = true
                })

