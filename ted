	if not model or not model.Parent then
		return false
	end

	self:bind()

	local anchor = self:anchor()
	if not anchor then
		self:visible(false)
		return true
	end

	if self.humanoid and self.humanoid.Health <= 0 and not settings.showDead then
		self:visible(false)
		return true
	end

	local position = anchor.Position
	local distance = (settings.origin - position).Magnitude

	if distance > settings.maxDistance then
		self:visible(false)
		return true
	end

	local screenPosition, onScreen = settings.camera:WorldToViewportPoint(position)
	if not onScreen or screenPosition.Z <= 0 then
		self:visible(false)
		return true
	end

	local color = self:color(settings)

	if self.billboard.Adornee ~= anchor then
		self.billboard.Adornee = anchor
	end

	self.nameLabel.Visible = settings.showName
	self.nameLabel.Text = self.label
	self.nameLabel.TextColor3 = color
	self.nameLabel.TextSize = settings.fontSize

	local tagText = self:tags(distance, settings)
	self.tagLabel.Visible = #tagText > 0
	self.tagLabel.Text = tagText
	self.tagLabel.TextColor3 = color
	self.tagLabel.TextSize = math.max(10, settings.fontSize - 2)

