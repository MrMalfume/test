end

local function updateAnimations(character)
	local speed = option("GbAnimSpeed", 1)
	for _, track in character:FindFirstChildOfClass("Humanoid"):GetPlayingAnimationTracks() do
		if flag("GbNoAnims") then
			track:Stop(0)
		elseif flag("GbAnimSpeedEnabled") then
			track:AdjustSpeed(speed)
		end
	end
end

local function tryRespawn()
	if os.clock() - lastRespawn < 2 then
		return
	end

	local events = replicatedStorage:FindFirstChild("Events")
	local bleed = events and events:FindFirstChild("BleedOut")
	if bleed and bleed:IsA("RemoteEvent") then
		pcall(function()
			bleed:FireServer()
		end)
	end

	local hum = getCharacter() and getCharacter():FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then
		pcall(function()
			players.LocalPlayer:LoadCharacter()
		end)
	end

	lastRespawn = os.clock()
end

