                    Name = "Hex",
                    LayoutOrder = 5,
                    FontFace = LibraryFont,
                    Text = "#" .. Colorpicker.Color:ToHex(),
                    PlaceholderText = "#hex",
                    TextSize = 14,
                    TextColor3 = Theme["Text"],
                    PlaceholderColor3 = Theme["Inactive Text"],
                    ClearTextOnFocus = false,
                    BackgroundColor3 = Theme["Element"],
                    Size = UDim2New(1, 0, 0, 22),
                    BorderSizePixel = 0,
                    ZIndex = 102
                })

                Library:ApplyTheme(HexBox, { BackgroundColor3 = "Element" })

                New("UICorner", {
                    Parent = HexBox,
                    CornerRadius = UDimNew(0, 4)
                })

                DarkGradient(HexBox)

                Colorpicker.Rainbow = false
                local RainbowConnection

                local function Refresh(SkipCallback)
                    Colorpicker.Color = FromHSV(Colorpicker.Hue, Colorpicker.Saturation, Colorpicker.Value)

                    Swatch.BackgroundColor3 = Theme["Element"]
                    SwatchInline.BackgroundColor3 = Colorpicker.Color
                    Palette.BackgroundColor3 = FromHSV(Colorpicker.Hue, 1, 1)
                    AlphaColor.BackgroundColor3 = Colorpicker.Color

                    PaletteDragger.Position = UDim2New(Colorpicker.Saturation, 0, 1 - Colorpicker.Value, 0)
                    HueDragger.Position = UDim2New(math.clamp(Colorpicker.Hue, 0, 0.98), 0, 0.5, 0)
                    AlphaDragger.Position = UDim2New(math.clamp(Colorpicker.Alpha, 0, 0.98), 0, 0.5, 0)

                    HexBox.Text = "#" .. Colorpicker.Color:ToHex()

                    Library.Flags[Colorpicker.Flag] = {
                        Color = Colorpicker.Color,
                        Alpha = Colorpicker.Alpha,
                        Transparency = Colorpicker.Alpha,
                        Rainbow = Colorpicker.Rainbow
                    }

                    if not SkipCallback then
                        Library:SafeCall(Colorpicker.Callback, Colorpicker.Color, Colorpicker.Alpha)
                    end
                end

                local function SetRainbowVisual(Bool)
                    RainbowLabel.TextTransparency = 0

                    if Bool then
                        Tween(RainbowLabel, { TextColor3 = Theme["Text"] })
                        Tween(RainbowIndicator, { BackgroundColor3 = Theme["Accent"] })
                        Tween(RainbowInline, { BackgroundColor3 = Theme["Accent"] })
                        Tween(RainbowCheck, { ImageTransparency = 0 })
                    else
                        Tween(RainbowLabel, { TextColor3 = Theme["Dim"] })
                        Tween(RainbowIndicator, { BackgroundColor3 = Theme["Element"] })
                        Tween(RainbowInline, { BackgroundColor3 = Theme["Element"] })
                        Tween(RainbowCheck, { ImageTransparency = 1 })
                    end
                end

                local function SetRainbow(Bool)
                    Colorpicker.Rainbow = Bool
                    SetRainbowVisual(Bool)

                    if RainbowConnection then
                        RainbowConnection:Disconnect()
                        RainbowConnection = nil
                    end

                    if Bool then
                        Colorpicker.Saturation = 1
                        Colorpicker.Value = 1
                        RainbowConnection = Library:Connect(RunService.Heartbeat, function(Delta)
                            if not Colorpicker.Rainbow then
                                return
                            end

                            Colorpicker.Hue = (Colorpicker.Hue + Delta * 0.2) % 1
                            Refresh(true)
                            Library:SafeCall(Colorpicker.Callback, Colorpicker.Color, Colorpicker.Alpha)
                        end)
                    end
                end

                Colorpicker.SetRainbow = SetRainbow

                RainbowRow.InputBegan:Connect(function(Input)
                    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                        SetRainbow(not Colorpicker.Rainbow)
                    end
                end)

                function Colorpicker:Set(Color, Alpha)
                    if typeof(Color) == "table" and Color.Color then
                        if Color.Rainbow ~= nil then
                            SetRainbow(Color.Rainbow)
                        end
                        Alpha = Color.Alpha or Color.Transparency
                        Color = Color.Color
                    end

                    Colorpicker.Hue, Colorpicker.Saturation, Colorpicker.Value = Color:ToHSV()
                    if Alpha ~= nil then
                        Colorpicker.Alpha = Alpha
                    end

                    Refresh()
                end

                function Colorpicker:Get()
                    return Colorpicker.Color, Colorpicker.Alpha
                end

                local function BindDrag(Bar, Update)
                    local Dragging = false

                    Bar.InputBegan:Connect(function(Input)
                        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                            Dragging = true
                            Update(Input.Position)

                            local Changed
                            Changed = Input.Changed:Connect(function()
                                if Input.UserInputState == Enum.UserInputState.End then
                                    Dragging = false
                                    Changed:Disconnect()
                                end
                            end)
                        end
                    end)

                    Library:Connect(UserInputService.InputChanged, function(Input)
                        if Dragging and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
                            Update(Input.Position)
                        end
                    end)
                end

                BindDrag(Palette, function(Position)
                    if Colorpicker.Rainbow then
                        SetRainbow(false)
                    end

                    Colorpicker.Saturation = math.clamp((Position.X - Palette.AbsolutePosition.X) / Palette.AbsoluteSize.X, 0, 1)
                    Colorpicker.Value = 1 - math.clamp((Position.Y - Palette.AbsolutePosition.Y) / Palette.AbsoluteSize.Y, 0, 1)
                    Refresh()
                end)

                BindDrag(HueBar, function(Position)
                    if Colorpicker.Rainbow then
                        SetRainbow(false)
                    end

                    Colorpicker.Hue = math.clamp((Position.X - HueBar.AbsolutePosition.X) / HueBar.AbsoluteSize.X, 0, 0.999)
                    Refresh()
                end)

                BindDrag(AlphaBar, function(Position)
                    if Colorpicker.Rainbow then
                        SetRainbow(false)
                    end

                    Colorpicker.Alpha = math.clamp((Position.X - AlphaBar.AbsolutePosition.X) / AlphaBar.AbsoluteSize.X, 0, 1)
                    Refresh()
                end)

                HexBox.FocusLost:Connect(function()
                    if Colorpicker.Rainbow then
                        SetRainbow(false)
                    end

                    local Hex = HexBox.Text:gsub("#", "")
                    local Success, Color = pcall(Color3.fromHex, Hex)

                    if Success then
                        Colorpicker:Set(Color)
                    else
                        HexBox.Text = "#" .. Colorpicker.Color:ToHex()
                    end
                end)

                Swatch.MouseButton1Click:Connect(function()
                    Popup:SetOpen(not Popup.IsOpen)
                end)

                Refresh(true)

                Library.SetFlags[Colorpicker.Flag] = function(Value)
                    Colorpicker:Set(Value)
                end

                Library.Options[Colorpicker.Flag] = Colorpicker
                return Colorpicker
            end

